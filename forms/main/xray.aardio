import thread.works;
//import web.rest.client;  // 提前加载，子线程直接使用







// === 搜索线程池：按需动态创建 / 销毁 ===
// thread.works 的线程数在创建时固定，但可随时销毁后重建（无需重启软件或内核）。
// 勾选"开启后台搜索"时按内核实际搜索器槽位数创建，取消勾选时销毁以释放线程与内存。
frmXray.searcherPool = null;
frmXray.searcherPoolSize = 0;

// 线程池并发数上限：唯一来源是 xray.core.searcherSlotMax（内核按该值预建全部搜索器槽位）
var SEARCHER_POOL_MAX = tonumber(xray.core.searcherSlotMax) : 50;

// 搜索任务工作函数（定义一次，供线程池复用）
frmXray.searcherWorker = function(taskData) {
	import web.rest.client;
	import debug.log;

	var frmXray               = taskData.frmXray;
	var outbound              = taskData.outbound;
	var outboundIndex         = taskData.outboundIndex;
	var slot                  = taskData.slot;
	var roundId               = taskData.roundId;         // 发起该任务时的轮次编号
	var searcherHttpProxyPort = taskData.searcherHttpProxyPort;

	// 通过本机搜索器 HTTP 入站端口，经该槽位出站访问测试地址。
	// 用 call 包裹以确保「无论测试过程是否异常，都必定回调一次」——
	// 否则该槽位永不归还，滚桶式调度会卡死。
	var callOk,testOk = call(
		function(){
			var restClient = web.rest.client(, "127.0.0.1:" + searcherHttpProxyPort);
			restClient._http.setTimeouts(4000, 5000, 5000);
			var ret = restClient.get("https://www.google.com/generate_204");
			var lastStatusCode = restClient.lastStatusCode;
			restClient.close();
			return lastStatusCode == 204;
		}
	);
	if(!callOk){
		debug.log.print("后台搜索: 测试过程异常", outboundIndex, tostring(testOk));
		testOk = false;
	}

	// 将结果回调到主线程处理（slot 用于归还槽位并立即补位，roundId 用于丢弃过期回调）
	frmXray.onSearcherSucces(outboundIndex, outbound, testOk ? true : false, slot, roundId);
};

// 计算当前应有的并发数（= 搜索线程池尺寸）
// 【重要】必须以内核「实际生成的搜索器槽位端口数」为硬上限：
//   dispatchSearchTask 要求 xray.core.searcherHttpProxyPorts[slot] 存在。
//   内核按 xray.core.searcherSlotMax 预建了全部槽位，所以正常情况下这个上限不会卡住并发数。
// 优先读实时配置 config.proxy.searchBatchSize：内核配置里的槽位数已与当前并发数解耦，
// 因此在「高级配置」里调整并发数后无需重启内核即可立即生效。
var getSearcherPoolSize = function(){
	var n = tonumber(config.proxy.searchBatchSize);
	if(!n || n < 1) n = tonumber(xray.core.searchBatchSize);
	if(!n || n < 1) n = 10;
	if(n > SEARCHER_POOL_MAX) n = SEARCHER_POOL_MAX;
	n = math.floor(n);

	var portN = #xray.core.searcherHttpProxyPorts;
	if(portN > 0 && n > portN) n = portN;   // 受实际入站端口数限制

	return n;
};

// 线程池重建中标志：防止 quit() 泵消息期间的重入回调重复重建
// （重复重建会让内层新建的池被外层的赋值覆盖成 null，池被孤立、任务丢失）
frmXray.searcherPoolSyncing = false;

// 取当前线程池（只取用，不创建、不销毁）。返回 null 表示当前没有可用线程池。
frmXray.getSearcherPool = function(){
	return frmXray.searcherPool;
};

// 销毁线程池，释放线程与内存（取消勾选后台搜索、内核重启时调用）
frmXray.destroySearcherPool = function(){
	var oldPool = frmXray.searcherPool;
	if(!oldPool) return;

	// 【铁律】必须先断开引用，再调用 quit()：
	//   quit() 内部用 thread.delay 等待线程退出，在界面线程会泵消息，
	//   期间在途任务的回调会重入 dispatchSearchTask / onSearcherSlotFree。
	//   若此时 searcherPool 仍指向「正在销毁的池」，重入会把它再销毁一次，
	//   并在外层返回后把内层刚创建的新池引用覆盖成 null —— 池被孤立、任务丢失、后台搜索停摆。
	frmXray.searcherPool = null;
	frmXray.searcherPoolSize = 0;

	// 不要调用 clear()：其内部 while(_thrdWorking>0) 是无限等待，
	// 一旦有 worker 卡住会导致销毁线程池时界面永久卡死。
	// quit(timeout) 自带超时、会自动清空任务队列与返回值，并用 terminate 兜底。
	oldPool.quit(3000);  // 通知所有线程退出并等待关闭（超时兜底）
	debug.log.print("searcherPool 已销毁");
};

// 在「安全点」确保线程池存在且尺寸与当前并发数一致。
// 【铁律】有在测任务时（busyCount>0）绝不销毁重建：
//   quit() 会终止正在测试的 worker，且其内部 thread.delay 会在界面线程泵消息，
//   导致在途回调与新池的槽位簿记互相污染 ——
//   表现为「改完并发数后后台搜索不工作，必须重新勾选才恢复」。
//   此时一律沿用旧池，等本轮跑完（busyCount 归零）后的下一次调用再重建。
frmXray.ensureSearcherPool = function(){
	var wantSize = getSearcherPoolSize();
	if(frmXray.searcherPool && frmXray.searcherPoolSize == wantSize){
		return frmXray.searcherPool;  // 尺寸匹配，直接复用
	}

	// 正在重建（quit 泵消息期间的重入）：直接返回，避免重复创建/孤立线程池
	if(frmXray.searcherPoolSyncing){
		return frmXray.searcherPool;
	}

	// 有在测任务：暂不重建，沿用旧池（下一个安全点会自动按新并发数重建）
	if(frmXray.searcherPool && frmXray.searcherBusyCount > 0){
		return frmXray.searcherPool;
	}

	frmXray.searcherPoolSyncing = true;
	frmXray.destroySearcherPool();    // 尺寸不符，先销毁旧池（已断开引用，重入安全）

	// 创建线程池会同步创建 wantSize 个线程（约 40ms/个），并发数较大时此处会短暂耗时
	frmXray.edit.print("正在创建搜索线程池( 并发 " + wantSize + " ) ...");

	// 用 call 包裹：即便创建失败（例如线程数过大导致资源不足），
	// 也必须复位 searcherPoolSyncing —— 否则该标志永久为 true，线程池再也无法重建。
// 【坑】call(fn,owner,...) 第 2 个参数是 owner！给普通函数传参必须写 call(fn,null,args...)，
	// 否则第 1 个实参会被 owner 吃掉，thread.works 的 limit 就收到一个函数
	// → thread.semaphore 报 CreateSemaphore @2 Expected:number Got:function。
	var callOk,newPool = call(thread.works, null, wantSize, frmXray.searcherWorker);
	frmXray.searcherPoolSyncing = false;
	if(!callOk || !newPool){
		debug.log.print("searcherPool 创建失败:", tostring(newPool));
		return null;
	}

	frmXray.searcherPool = newPool;
	frmXray.searcherPoolSize = wantSize;
	debug.log.print("searcherPool 已创建, 并发数 = " + wantSize);
	debug.log.print("[SD] POOL-CREATE size=",wantSize);  // >>>>> SD
	return frmXray.searcherPool;
};

// === 本轮编号（round generation）===
// 新一轮开始 / 内核重启时递增；每个任务携带发起时的编号回传，编号不一致的回调一律丢弃。
// 【为什么必须这样做】上一轮（或内核重启前）的遗留回调若照常执行，会改写新一轮的
// searcherSlots / searcherBusyCount，并可能在仍有任务在途时提前解锁 searchingBackground，
// 导致定时器开出重复轮次、槽位簿记彻底错乱 —— 这就是「后台搜索突然不工作」的根因之一。
frmXray.searcherRoundId = 0;

// 结束当前搜索轮次并释放线程池：下一次定时器 tick（≤1 秒）会按新的并发数重新开始。
// 【调用时机】内核重启、以及在「高级配置」里调整后台搜索并发数。
// 【顺序很重要】必须先释放线程池、最后才解锁 searchingBackground：
//   destroySearcherPool() 内部的 quit() 会在一旁泵消息，若此时已解锁，
//   定时器会立刻开出新轮次，与销毁过程互相踩踏。
frmXray.resetSearcherRound = function(reason){
	var rid = frmXray.searcherRoundId;
	if(!rid) rid = 0;

	frmXray.searcherWatchdogTick = time.tick();    // 先刷新看门狗时间戳，避免 quit() 期间被误触发
	frmXray.destroySearcherPool();                 // 释放旧池（此时 searchingBackground 仍为 true）
	frmXray.searcherRoundId = rid + 1;             // 旧一轮的在途回调全部作废
	frmXray.searcherBusyCount = 0;
	frmXray.searcherSlots = {};
	frmXray.searcherPoolSize = 0;                  // 强制下一轮按新并发数重建
	thread.set("searchingBackground",false);       // 最后解锁：下一次定时器 tick 开始新轮次
	debug.log.print(tostring(reason),"：已释放搜索线程池，下一轮将按新的并发数重建");
};

// 内核重启后，搜索器入站端口全部变化，旧一轮的在途任务全部作废。
subscribe("xrayCore.restarted", function(socksProxyPort,httpProxyPort){
	frmXray.resetSearcherRound("内核已重启");
});

// 「高级配置」调整后台搜索并发数。
// 内核已按 xray.core.searcherSlotMax 预建全部搜索器槽位，因此这里无需重启内核
// （不会中断当前代理连接），只要重建线程池即可立即生效。
subscribe("config.searchBatchSize.changed", function(newBatchSize){
	var n = tonumber(newBatchSize);
	if(n && n >= 1){
		xray.core.searchBatchSize = n;
	}
	frmXray.resetSearcherRound("后台搜索并发数已调整");
});

// === 滚桶式调度（barrel / rolling scheduling）===
// 旧实现是「整批等待」：一次派发 N 个节点，等这一批全部测完才派发下一批。
// 于是整批耗时取决于最慢的那个节点（例如 9 个 2 秒完成，1 个 30 秒超时 → 整批 30 秒），
// 且已空闲的槽位被迫空等，浪费并发度。
//
// 新实现改为「槽位一空立即补下一个」：只有当本轮所有节点测完且所有槽位都空闲时才收尾。
// 用一个 busyCount 计数器表示在测槽位数，归零即代表本轮结束。
frmXray.searcherSlots = {};      // 槽位号 -> 当前在测节点索引（null 表示空闲）
frmXray.searcherBusyCount = 0;   // 当前在测的槽位数
frmXray.searcherWatchdogTick = 0;// 最近一次调度进展时间（看门狗用）
frmXray.searcherDoneCount = 0;   // 已完成的搜索任务数（用于周期性进度日志）

// 后台搜索时让列表视图「跟随显示」哪个槽位当前正在测试的节点行（便于人工观察）。
// 【开关】是否跟随由界面上的「跟踪搜索进度」复选框（chkFollowSearch）控制，
//        勾选 = 跟随，取消勾选 = 不自动滚动（此时只在本轮开始时定位到起始行）。
// 【本值】指定跟随「哪个槽位」的行：1 表示跟随槽位 1，其他正整数则跟随对应槽位。
frmXray.searcherFollowSlot = 1;

// 取下一个可测节点的索引并推进游标；返回 null 表示本轮已扫完
frmXray.nextSearchableIndex = function(){
	var outbounds = config.proxy.outbounds;
	var total = #outbounds;
	while(frmXray.searcherIndex <= total){
		var idx = frmXray.searcherIndex;
		frmXray.searcherIndex = idx + 1;
		var node = outbounds[idx];
		// 跳过需要独立内核的协议（无法参与 Xray 多出口并发搜索）
		if(node && !xray.protocols.isStandalone(node.protocol)){
			return idx;
		}
	}
	return null;
};

// 向指定槽位派发一个搜索任务；返回 true 表示已成功派发
frmXray.dispatchSearchTask = function(slot){
	if(!xray.core.prcsxray){ 
		debug.log.print("[SD] D-SLOT slot=",slot,"FAIL 内核进程为空");  // >>>>> SD
		return false; 
	}

	// 槽位必须有对应的入站端口，否则不能派发（且不推进节点游标，避免漏测）
	var proxyPort = xray.core.searcherHttpProxyPorts[slot];
	if(!proxyPort){ 
		debug.log.print("[SD] D-SLOT slot=",slot,"FAIL 无入站端口 httpPorts=",#xray.core.searcherHttpProxyPorts);  // >>>>> SD
		return false; 
	}

	// 【重要】此处只「取用」线程池，绝不创建 / 销毁：
	// 线程池的重建只在轮次开始的安全点进行（chkSearchMode.oncommand → ensureSearcherPool）。
	// 若在本函数（可能运行于 worker 回调中）里销毁重建线程池，会与在途任务互相踩踏。
	// 线程池尚未就绪时直接返回：既不推进节点游标，也不把好节点误计为失败。
	var pool = frmXray.getSearcherPool();
	if(!pool){
		debug.log.print("[SD] D-SLOT slot=",slot,"FAIL 线程池未就绪");  // >>>>> SD
		return false;
	}

	var slotTag = "proxySearcher_" + slot;
	var slotConfig = "searcherConfig_" + slot + ".json";

	// 用循环（而非递归）逐个取节点，坏节点直接跳过，直到成功派发或本轮扫完。
	while(true){
		// 取节点：若本轮已扫完则无可派发
		var nodeIndex = frmXray.nextSearchableIndex();
		if(!nodeIndex){ 
			debug.log.print("[SD] D-SLOT slot=",slot,"FAIL 节点已扫完 idx=",frmXray.searcherIndex);  // >>>>> SD
			return false; 
		}

		var node = config.proxy.outbounds[nodeIndex];

		// 【重要】节点数据可能很脏（字段类型不符、协议配置非法等）。
		// 必须把异常关在这一个节点内部：一旦异常逃逸到消息循环，
		// 本轮 dispatch 会被中途打断，而 thread.set("searchingBackground",true) 已经设置，
		// 后果是弹出 RAW CALLBACK ERROR + 后台搜索停滞到 120 秒看门狗才恢复。
		// 另注意顺序：先提交任务、最后才占领槽位并计数，
		// 确保 busyCount 与「已提交到线程池的任务数」严格一致，避免槽位永久泄漏。
		var callOk,dispatched,err = call(
			function(nodeIndex,node,slotTag,slotConfig,proxyPort,slot){
				// 清除该槽位旧出站（tag 不存在时返回 null，属正常）
				xray.core.deleteOutbound(frmXray.edit, node, slotTag, slotConfig);

				// 添加该槽位新出站
				var adder = xray.core.addOutbound(frmXray, frmXray.edit, node, slotTag, slotConfig);
				if(!adder){ return null,"添加槽位出站失败"; }

				frmXray.listview.setItemText("后台测试中", nodeIndex, 8);

				// 跟随显示：让列表视图滚动到该槽位当前正在测试的节点行（便于人工观察）
				if(frmXray.chkFollowSearch.checked && slot == frmXray.searcherFollowSlot){
					frmXray.listview.ensureVisible(nodeIndex);
				}

				// 输出到界面输出窗口，便于直观看到当前在测哪个节点（沿用旧版串行搜索的输出风格）
				frmXray.edit.print("后台搜索序号: " + nodeIndex + " ,地址为：" + tostring(node.address) + " ,协议：" + tostring(node.protocol) + " ,槽位：" + slot);

				// 提交任务（线程池异步并发执行）
				// 【关键·死锁根因】必须用 pushAsync，绝不能用 push ：
				//   thread.works.push 内部执行 this._semaphore.waitOne()，会阻塞等待「空闲 worker」
				//   （实测：3 个 worker 全忙时 push 阻塞 3000ms，直到有 worker 空出来才返回）。
				//   而本函数是在 worker 线程「同步封送」过来的回调里执行的 —— 该 worker 此刻正阻塞等待
				//   本次调用返回，它的 semaphore.release()（在任务函数返回后才执行）永远不会发生。
				//   于是 push 永远等不到空闲 worker；waitOne 在 UI 线程还会继续泵消息，把其它 worker
				//   的回调再泵进来递归 push → UI 线程与全部 worker 互锁死，后台搜索彻底停摆。
				//   pushAsync 不等待空闲线程、直接入队返回，从根上消除死锁；且滚桶式调度只在
				//   「有任务完成」时才补位，在途任务数天然不会超过 worker 数，无需 push 的背压。
				var sdPushOk = pool.pushAsync({  // >>>>> SD
					frmXray = frmXray;
					outbound = node;
					outboundIndex = nodeIndex;
					slot = slot;
					roundId = frmXray.searcherRoundId;   // 携带本轮编号：过期回调会被 onSearcherSucces 丢弃
					searcherHttpProxyPort = proxyPort;
				});
				if(!sdPushOk){  // >>>>> SD
					return null,"任务入池失败(push 返回空)";  // >>>>> SD
				}  // >>>>> SD

				// 任务确实已进入线程池，此时才占领槽位并计数
				frmXray.searcherSlots[slot] = nodeIndex;
				frmXray.searcherBusyCount = (frmXray.searcherBusyCount ? frmXray.searcherBusyCount : 0) + 1;
				frmXray.searcherWatchdogTick = time.tick();
				return true;
			}
			,null,nodeIndex,node,slotTag,slotConfig,proxyPort,slot
		);

		if(callOk && dispatched){ return true; }

		// 该节点不可用：记录原因、标记失败，然后换下一个节点
		// （callOk 为 false 时，dispatched 位置上拿到的是 call 返回的错误信息）
		var reason = callOk ? tostring(err) : tostring(dispatched);
		debug.log.print("[SD] D-SLOT slot=",slot,"idx=",nodeIndex,"FAIL ",reason);  // >>>>> SD
		debug.log.print("后台搜索: 槽位出站准备失败，跳过节点", slotTag, nodeIndex, node ? node.address : "?", node ? node.protocol : "?", reason);

		if(node){
			node.failedCount = (node.failedCount ? node.failedCount : 0) + 1;
			frmXray.listview.setItemText("失败次数：" + node.failedCount, nodeIndex, 8);
		}
	}
};

// 槽位空闲回调：立即补位（滚桶）；本轮扫完且所有槽位空闲则收尾解锁
frmXray.onSearcherSlotFree = function(slot){
	frmXray.searcherWatchdogTick = time.tick();

	if(slot){ frmXray.searcherSlots[slot] = null; }

	frmXray.searcherBusyCount = (frmXray.searcherBusyCount ? frmXray.searcherBusyCount : 0) - 1;
	if(frmXray.searcherBusyCount < 0) frmXray.searcherBusyCount = 0;

	// 1) 本轮还有待测节点 → 立刻用这个刚空出来的槽位补上
	// 【重要】必须用 call 包裹：dispatchSearchTask 内部若抛出未捕获异常，
	// 异常会中断本函数（FREE 日志与收尾逻辑都不执行）→ 槽位计数器错乱 + 搜索永久停滞。
	var sdRefill = false;
	if(slot){
		var okRefill,refillRet = call(frmXray.dispatchSearchTask,frmXray,slot);
		if(okRefill){
			sdRefill = refillRet ? true : false;
		}
		else{
			debug.log.print("[SD] REFILL-ERR slot=",slot,"err=",tostring(refillRet));  // >>>>> SD
		}
	}
	if(sdRefill){ return; }

	// 2) 没有可派发的任务：最后一个槽位完成即收尾，允许定时器进入下一轮
	if(frmXray.searcherBusyCount <= 0){
		frmXray.searcherBusyCount = 0;
		thread.set("searchingBackground",false);
		debug.log.print("[SD] ROUND-END 解锁 bg=false");  // >>>>> SD
	}
};

//后台搜索模式开启复选框
frmXray.chkSearchMode.oncommand = function(id,event){
    config.proxy.searchMode = frmXray.chkSearchMode.checked;
    config.proxy.searcherIndex = frmXray.searcherIndex;

	

    if(frmXray.chkSearchMode.checked) {
        if(thread.get("searchingBackground")) {
       //     debug.log.print("chkSearchMode is running.");
            // 看门狗：滚桶式调度依赖每个 worker 归还槽位。若某个 worker 异常卡死导致
            // busyCount 永不归零，这里在长时间（120 秒）无任何进展时强制重置调度状态，
            // 避免后台搜索永久卡死（单次测试最长约 20 秒，120 秒不会误触发）。
            var watchdogTick = frmXray.searcherWatchdogTick;
            if(watchdogTick && (time.tick() - watchdogTick) > 120000){
                debug.log.print("后台搜索看门狗: 长时间无进展，强制重置调度状态");
                // >>>>> SD-BEGIN
                debug.log.print("[SD] WATCHDOG 重置前 busy=",frmXray.searcherBusyCount,"slots=",table.tostring(frmXray.searcherSlots),"idx=",frmXray.searcherIndex);
                // <<<<< SD-END
                frmXray.searcherBusyCount = 0;
                frmXray.searcherSlots = {};
                thread.set("searchingBackground",false);
            }
            return;
        }
        if(!xray.core.prcsxray) {
            // >>>>> SD-BEGIN
            debug.log.print("[SD] NO-PRCS 内核进程为空，无法派发");
            // <<<<< SD-END
       //     debug.log.print("xray.core.prcsxray is null, setSearcherTimer.");
            //setSearcherTimer();
            return;
        }
        
     //   debug.log.print("searcherTimerID is ",..searcherTimerID);
        
        if(!..searcherTimerID){
			setSearcherTimer();
		}
        var outbounds = config.proxy.outbounds;

        if(frmXray.searcherIndex > #outbounds) {
            // >>>>> SD-BEGIN
            debug.log.print("[SD] WRAP 游标到头 idx=",frmXray.searcherIndex,"total=",#outbounds);
            // <<<<< SD-END
            frmXray.searcherIndex = 1;
            thread.set("searchingBackground",false);
            if(#outbounds > 200) publish("uiCommand.restartxrayCore");
            return;
        }

// === 滚桶式并发搜索：一次性填满 N 个槽位，之后每完成一个立即补下一个 ===
        // 不再等待整批完成，避免"最慢节点决定整批耗时"以及空闲槽位被浪费。
        var poolSize = getSearcherPoolSize();
        var startIndex = frmXray.searcherIndex;
        // >>>>> SD-BEGIN
        debug.log.print("[SD] ENV poolSize=",poolSize,"startIndex=",startIndex,"outbounds=",#outbounds,
            "httpPorts=",#xray.core.searcherHttpProxyPorts,"ports=",table.tostring(xray.core.searcherHttpProxyPorts),
            "coreBatch=",xray.core.searchBatchSize,"cfgBatch=",config.proxy.searchBatchSize,
            "prcs=",tostring(xray.core.prcsxray));
        // <<<<< SD-END

        frmXray.searcherSlots = {};
        frmXray.searcherBusyCount = 0;
        frmXray.searcherWatchdogTick = time.tick();
        thread.set("searchingBackground",true);

        // 【安全点】递增本轮编号：上一轮（或内核重启前）遗留的回调会被 onSearcherSucces 丢弃，
        // 不会改写本轮的 searcherSlots / searcherBusyCount（这是后台搜索突然停摆的根因之一）。
        frmXray.searcherRoundId = (frmXray.searcherRoundId ? frmXray.searcherRoundId : 0) + 1;

        // 【安全点】此处本轮 busyCount 刚归零、且尚无任务在途，
        // 是唯一可以安全创建/重建线程池的时机 ——「高级配置」改动并发数后即在此生效。
        if(!frmXray.ensureSearcherPool()){
            frmXray.searcherBusyCount = 0;
            thread.set("searchingBackground",false);
            frmXray.edit.print("搜索线程池未就绪，本周期跳过");
            return;
        }

        var dispatched = 0;
        // >>>>> SD-BEGIN
        var sdDetail = {};
        // <<<<< SD-END
        for(slot=1;poolSize;1){
            // dispatchSearchTask 内部已隔离单个节点的异常；这里再兜一层，
            // 确保任何意外异常都不会打断本轮派发（否则 searchingBackground 会一直为 true）
            var callOk,ok = call(frmXray.dispatchSearchTask,frmXray,slot);
            // >>>>> SD-BEGIN
            table.push(sdDetail,"s" + slot + "=" + tostring(callOk) + "|" + tostring(ok));
            // <<<<< SD-END
            if(callOk && ok){ dispatched++; }
        }
        // >>>>> SD-BEGIN
        debug.log.print("[SD] DISPATCHED total=",dispatched,"detail=",string.join(sdDetail,","));
        // <<<<< SD-END

        if(dispatched == 0){
            // 本轮已无可测节点（游标已扫完），或内核/端口尚未就绪：解锁，交还定时器等下个周期
            frmXray.searcherBusyCount = 0;
            thread.set("searchingBackground",false);
            return;
        }

        frmXray.edit.print("后台搜索: 并发 " + dispatched + " 个槽位, 起始序号：" + startIndex + ", 总数为：" + #outbounds);

        // 未启用「跟随槽位」时，才在本轮开始时把列表视图定位到本轮第一个服务器所在行；
        // 启用跟随时由 dispatchSearchTask 持续跟随，避免两者互相拉扯。
        if(!frmXray.chkFollowSearch.checked && frmXray.listview && startIndex){
            frmXray.listview.selIndex = startIndex;
            frmXray.listview.ensureVisible(startIndex);
        }
    } 
    else {
        if(..searcherTimerID) frmXray.clearInterval(..searcherTimerID);
        ..searcherTimerID = null;
        frmXray.searchingBackground = false;

        // 【重要】必须同时重置线程共享标志与滚桶调度计数：
        // oncommand 在创建定时器之前就会检查 thread.get("searchingBackground")，
        // 若这里只改窗体属性而不改线程共享标志，取消勾选后再重新勾选时，
        // 首次 oncommand 会被直接挡回（且在 setSearcherTimer 之前 return），
        // 结果就是「后台搜索再也无法启动」。
        thread.set("searchingBackground",false);
        frmXray.searcherBusyCount = 0;
        frmXray.searcherSlots = {};

        frmXray.edit.print("退出搜索模式");
        // 取消勾选后台搜索：销毁线程池，释放线程与内存
        frmXray.destroySearcherPool();
    }
}
