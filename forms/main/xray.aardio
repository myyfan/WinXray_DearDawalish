/*
虚表（vlistview）兼容层

虚表只渲染可见行，通过 onGetDispItem 回调按需取数据，
不再为每一行每一列发送跨进程窗口消息：
10000+ 行填充从「数十秒」降到「不足 1 秒」。

为了让工程内既有的 setItemText / setTable 调用点（约 80 处）无需改动，
这里采用「视图缓存 + 实例方法覆盖」提供兼容。
（aardio 允许实例成员遮蔽类方法）

  setTable     : 按 fields 生成视图缓存，并设置虚表行数 count
  setItemText  : 写入视图缓存
  delItem      : 删除缓存行并同步行数
  clear        : 清空缓存与行数
  onGetDispItem: 虚表回调，从视图缓存取单元格文本

注意：刻意不用 owner.redraw()（每次约 27ms），
     改用 InvalidateRect（消息泵自动合并重绘，开销接近 0）。
*/
frmXray.listview.viewCache = {};    // 视图缓存：viewCache[行][列]
frmXray.listview.viewSilent = null; // 为 true 时写入不触发重绘（批量填充用）

frmXray.listview.onGetDispItem = function(item,row,col){
	var r = owner.viewCache[row];
	if(r) return {text = r[col]};
};

frmXray.listview.setItemText = function(text,row,col){
	if(col===null || col===0) col = 1;
	if(!row) return false;
	var r = owner.viewCache[row];
	if(!r){ r = {}; owner.viewCache[row] = r; }
	r[col] = text;
	if(!owner.viewSilent) ::User32.InvalidateRect(owner.hwnd,null,false);
	return true;
};

frmXray.listview.setTable = function(dataTable){
	if(!dataTable) return owner.clear();

	var fields = dataTable.fields;
	if(!fields){
		if(#dataTable && !..table.isArrayLike(dataTable[1])){
			fields = ..table.keys(dataTable[1]);
		}
		else {
			fields = {};
			for(i=1;#dataTable[1];1) ..table.push(fields,i);
		}
	}

	var cache = {};
	for(i=1;#dataTable;1){
		var ob = dataTable[i];
		var r = {};
		for(j=1;#fields;1) r[j] = ob[fields[j]] ?: "";
		cache[i] = r;
	}

	owner.viewCache = cache;
	owner.count = #dataTable;
	if(!owner.viewSilent) ::User32.InvalidateRect(owner.hwnd,null,false);
	return true;
};

frmXray.listview.delItem = function(row){
	row := owner.count;
	if(row<1 || row>#owner.viewCache) return false;
	..table.remove(owner.viewCache,row);
	owner.count = #owner.viewCache;
	if(!owner.viewSilent) ::User32.InvalidateRect(owner.hwnd,null,false);
	return true;
};

frmXray.listview.clear = function(){
	owner.viewCache = {};
	owner.count = 0;
	if(!owner.viewSilent) ::User32.InvalidateRect(owner.hwnd,null,false);
	return true;
};

frmXray.show();//显示窗口

