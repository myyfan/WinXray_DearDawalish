	);	
}


// ===== 后台批量获取服务器证书指纹 =====
// Xray 26.x 已移除 allowInsecure（2026-06-01 起为硬错误），
// 原「跳过证书校验」的节点必须改用 pinnedPeerCertSha256 才能连接。
// 在后台线程分片抓取（不阻塞界面），抓到后写回配置并保存。
frmXray.startCertPinFetch = function(){
	if(frmXray.certPinRunning) return;

	// 筛选本次要抓的节点：所有「需要指纹但还没有指纹」的
	// （抓成功的节点下次不会再进来，所以不会重抓）
	var jobs = ..table.array();
	for(k,v in ..config.proxy.outbounds){
		if( v.allowInsecure && !v.pinnedPeerCertSha256 && v.address ){
			..table.push(jobs,{index=k;address=v.address;port=v.port : 443;sni=v.sni});
		}
	}
	if(!#jobs) return;

	// ★ 进度点：本次「待抓列表」中的位置号（不是 outbounds 下标），
	// 与 searcherIndex 一样存在 config.proxy 里、按顺序推进，靠 5 分钟定时器落盘（丢失就丢失）。
	// 每轮都处理全部待抓节点（环形），只是起点从上次进度号开始 ——
	// 避免每次都从列表第一个开始（能长期留在列表前面的，基本都是反复失败的节点）。
	var totalJobs = #jobs;
	var startPos = (tonumber(..config.proxy.certPinProgress) : 0) + 1;
	if(startPos > totalJobs) startPos = 1;//绕回：新一轮从头开始

	frmXray.certPinRunning = true;
	frmXray.certPinTotal = totalJobs;
	frmXray.certPinDoneCount = 0;
	frmXray.edit.print("开始后台获取服务器证书指纹，共 " + totalJobs + " 个节点（本次从列表第 " + startPos + " 个开始）...");

	// ★ 分批抓取：每批 BATCH 个节点并行处理，每批完成即推进进度点。
	// （不能只在启动时写一次进度点：一批要跑几分钟，中途关闭会导致整批重复抓）
	var BATCH = 12;
	var batchPos = 1;                    // 本次处理序号（1-based）
	var successCount = 0;                // 本次累计成功数
	var successBase = 0;                 // 绕回时的成功数基数（避免「位置 − 成功数」为负）
	var lastPos = startPos;

	// 环形取节点：本次第 k 个节点 = jobs[startPos + k - 1]（越过末尾则绕回开头）
	frmXray.certPinNodeAt = function(k){
		var p = startPos + k - 1;
		if(p > totalJobs) p -= totalJobs;
		return p;
	};

	frmXray.runCertPinBatch = function(){
		var stopPos = ..math.min(batchPos + BATCH - 1,totalJobs);
		var batch = ..table.array();
		for(k=batchPos,stopPos,1){
			..table.push(batch,jobs[frmXray.certPinNodeAt(k)]);
		}
		frmXray.certPinBatchEnd = stopPos;
		var n = #batch;
		for(t=1,n,1){
			..thread.set("certPinDone_" + t,false);
			..thread.invoke(
				function(j,tid){
					import xray.certPin;
					var sha = xray.certPin.getSha256(j.address,j.port,j.sni,4000);
					thread.set("certPinResult_" + tid,{index=j.index;sha=sha});
					thread.set("certPinDone_" + tid,true);
				},batch[t],t
			);
		}
		frmXray.certPinTaskCount = n;
		frmXray.setTimeout(frmXray.pollCertPin,200);
	};

	frmXray.pollCertPin = function(){
		var allDone = true;
		for(t=1,frmXray.certPinTaskCount,1){
			var st = ..thread.get("certPinDone_" + t);
			if(st === "processed") continue;
			if(st === true){
				var r = ..thread.get("certPinResult_" + t);
				if(r){
					var ob = ..config.proxy.outbounds[r.index];
					if(ob && r.sha){
						ob.pinnedPeerCertSha256 = r.sha;
						successCount++;
					}
					frmXray.certPinDoneCount++;
				}
				..thread.set("certPinResult_" + t,null);
				..thread.set("certPinDone_" + t,"processed");
			}
			else {
				allDone = false;
			}
		}

		if(allDone){
			// ★ 进度号 = 本批最后处理的「列表位置」− (本次成功数 − 绕回基数)，下限 0
			var pos = frmXray.certPinNodeAt(frmXray.certPinBatchEnd);
			if(pos < lastPos) successBase = successCount;//检测到绕回 → 更新基数
			lastPos = pos;
			var next = pos - (successCount - successBase);
			if(next < 0) next = 0;
			..config.proxy.certPinProgress = next;//只写 config，不 save（丢失就丢失）

			frmXray.edit.print("证书指纹进度: " + frmXray.certPinDoneCount + "/" + frmXray.certPinTotal);

			batchPos = frmXray.certPinBatchEnd + 1;
			if(batchPos > totalJobs){
				frmXray.certPinRunning = false;
				frmXray.edit.print("后台证书指纹获取完成。");
			}
			else {
				frmXray.runCertPinBatch();
			}
		}
		else {
			frmXray.setTimeout(frmXray.pollCertPin,200);
		}
	};

	frmXray.runCertPinBatch();
};

// 启动后延迟 6 秒开始（避开内核启动），完全在后台执行不阻塞界面
frmXray.setTimeout(
	function(){
		frmXray.startCertPinFetch();
	},6000
);

// 订阅代理切换消息，设置3个单选控件
subscribe("sysProxy.modeChanged",function(mode){
	frmXray.radioProxyPac.checked = false;
	frmXray.radioProxy.checked = false;
	frmXray.radioProxyDirect.checked = false;
	
	if(mode = "pac"){
		frmXray.radioProxyPac.checked = true;
		if(_WIN10_LATER) frmXray.btnEditPacOrUwp.text = "编辑 PAC";
	}
	elseif(mode = "proxy"){
		frmXray.radioProxy.checked = true;
		if(_WIN10_LATER) frmXray.btnEditPacOrUwp.text = "配置 UWP";
	}
	else{
		frmXray.radioProxyDirect.checked = true;
	}
} )

//发布代理模式切换消息
