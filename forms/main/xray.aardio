//定时检测标志,否则说明是新服务器,要重启内核
switchOutbound = function(outboundIndex,outboundAddress,timerTesting){
	
	if(!outboundIndex || !outboundAddress) {//如果服务器为空,则返回
		return;
	}	
	
	import debug
	//debug.debug();	
	
	// 如果配置文件中没有对应序号服务器，那么就返回
	var outbound = config.proxy.outbounds[outboundIndex];
	if(!outbound || outbound.address != outboundAddress){
		publish("uiCommand.print","switchOutbound:节点变化，重启内核");
		publish("uiCommand.restartxrayCore");
		return ; 
	} 
	
	//如果是“异常自动重联”模式，就清楚定时器，手动则不用
/*
	if(frmXray.chkAutoTest.checked){
		  //先销毁可能存在的旧定时器
   		if(testTimerId){
        	frmXray.clearInterval(testTimerId);
        	testTimerId = null;
    	}
    }
*/
	
	//销毁流量统计定时器
	if(trafficTimerId){ frmXray.clearInterval(trafficTimerId); }
	
	..publish("activeOutbound",false); //发布活动地址失效
		//console.dump(xray.core.prcsxray);
		//debug.log.print(xray.core.prcsxray);
		//var started
		//console.dump(outbound);
	currentOutboundIndex,currentOutboundAddress = outboundIndex,outboundAddress;
	
	if(thread.get("isOnTesting")) return ; 
	
	var started;
	//内核运行不正常则重启内核
	if(!xray.core.prcsxray || xray.protocols.isStandalone(outbound.protocol)  ){
		started = xray.core.restart(frmXray.edit,outbound);
		//debug.log.print("内核重启")
		
	/*
		console.dump(xray.core.prcsxray);
		debug.log.print(xray.core.prcsxray);
			debug.log.print(started);
*/
	}
	else {
			started = xray.core.prcsxray ? true : false;
			import sysProxy;
			// reset，不使用代理
			//..sysProxy.reset(false);
			var cleaner;
			var i=1;			
			while(!cleaner && i<4){
				i++;
				//console.print("删除配置回复null")	
				//cleaner = xray.core.stopSearcher(frmXray.edit,outbound);
				cleaner = xray.core.deleteOutbound(frmXray.edit,outbound,"proxy","proxyConfig.json");
				//debug.debug();				
				
			}
			//debug.log.print("cleaner:"+cleaner)	
			
			var adder//xray添加搜索配置		
			while(!adder && i>1){
				//console.print("添加配置回复null")
				//adder = xray.core.startSearcher(frmXray.edit,next);
				i--;
				adder = xray.core.addOutbound(frmXray,frmXray.edit,outbound,"proxy","proxyConfig.json");				
				//debug.log.print(adder);
			}
			 if(!cleaner || !adder ) {
			 	started = xray.core.restart(frmXray.edit,outbound);//重启内核
			 }
			 else {
			 	..publish("xrayCore.restarted",socksProxyPort,httpProxPort); 
			 }
			 
			//debug.log.print("adder:"+adder)	;
			//debug.debug();
		}
		
		//debug.log.print(started);
		//debug.debug();
		
		//var started,err = xray.core.restart(frmXray.edit,outbound);//重启内核
		//startTesting = started;
		
		if(!started){//如果失败就返回，成功就继续往后运行
			frmXray.edit.print("启动 Xray 错误",err:""); 
			frmXray.btnTcping.disabledText = null;
			return false;
		}

	testOutbound(outboundIndex,outboundAddress,timerTesting);
	//debug.log.print("frmXray.isOnTesting = 0")
	//frmXray.isOnTesting = 0;
}
//测试服务器是否可用

import thread.works;
import debug.log;

// 1. 在主线程定义更新数据的方法（供工作线程安全回调）
frmXray.updateOutboundDelay = function(index, delay){
    if(config.proxy.outbounds[index]){
        config.proxy.outbounds[index].replyDelay = delay;
    }
}
// 重试队列（最大并发1，保证单例）
frmXray.retryQueueA = thread.works(5, function(taskData){
        import debug.log;
        import console;
    // 从 table 中解包参数
    var frmXray = taskData.frmXray;
    var outboundIndex   = taskData.outboundIndex;
    var outboundAddress = taskData.outboundAddress;
    var timerTesting    = taskData.timerTesting;

/*

            // 🚨 打印每个参数的类型和值，用于调试
        debug.log.print("------ retryQueue收到任务参数 ------");
        debug.log.print("frmXray 类型:", type(frmXray), " 值:", frmXray);
        debug.log.print("outboundIndex 类型:", type(outboundIndex), " 值:", outboundIndex);
        debug.log.print("outboundAddress 类型:", type(outboundAddress), " 值:", outboundAddress);
        debug.log.print("timerTesting 类型:", type(timerTesting), " 值:", timerTesting);
        debug.log.print("------------------------");
*/

    // 直接调用 testOutbound，因为 testOutbound 内部会再次 push 到 taskQueueA
    frmXray.onStartXrayFailed(outboundIndex, outboundAddress, timerTesting);
});
// 2. 初始化线程池（全局只执行一次，不要放在 testOutbound 函数内部）
frmXray.callRetryQueueA = function(outboundIndex,outboundAddress,timerTesting){
//	debug.log.print("yes");
	frmXray.retryQueueA.push({
    	    frmXray = frmXray;
   			outboundIndex   = outboundIndex;
    		outboundAddress = outboundAddress;
    		timerTesting    = timerTesting;
		});
}


var taskQueueA = thread.works(5,
    function(taskData){
        import debug.log;
        import web.rest.client;

        // 从 taskData 中解包参数
        var frmXray = taskData.frmXray;
        var outboundIndex = taskData.outboundIndex;
        var outboundAddress = taskData.outboundAddress;
        var httpProxyAddress = taskData.httpProxyAddress;
        var timerTesting = taskData.timerTesting;
        var currentDelay = taskData.currentDelay;

        // 🚨 打印每个参数的类型和值，用于调试
/*
        debug.log.print("------ taskQueueA收到任务参数 ------");
        debug.log.print("frmXray 类型:", type(frmXray), " 值:", frmXray);
        debug.log.print("outboundIndex 类型:", type(outboundIndex), " 值:", outboundIndex);
        debug.log.print("outboundAddress 类型:", type(outboundAddress), " 值:", outboundAddress);
        debug.log.print("httpProxyAddress 类型:", type(httpProxyAddress), " 值:", httpProxyAddress);
        debug.log.print("timerTesting 类型:", type(timerTesting), " 值:", timerTesting);
        debug.log.print("currentDelay 类型:", type(currentDelay), " 值:", currentDelay);
        debug.log.print("------------------------");
*/


        var lastStatusCode;
        for(i=1;5;1){
            var restClient = web.rest.client(, httpProxyAddress);
            restClient._http.setTimeouts(2000,2000,2000); //连接超时, 请求超时, 接收超时

            var timeTick = time.tick();
            var ret = restClient.get("https://www.google.com/generate_204");
            timeTick = time.tick() - timeTick;

            // 计算新的平均延迟
            var newDelay = (currentDelay * 99 + timeTick) / 100;

            // 通过 frmXray 将新延迟安全地传回主线程修改
            frmXray.updateOutboundDelay(outboundIndex, newDelay);

            lastStatusCode = restClient.lastStatusCode;
            restClient.close();

         //   debug.log.print("test response is: ", lastStatusCode);

            // 如果状态码为 204 或 200（或者其他成功的状态码）
            if(lastStatusCode == 204 || lastStatusCode == 200) {
                thread.set("isOnTesting", false);
                frmXray.onStartXrayComplete(outboundIndex, outboundAddress, timerTesting);
                return;
            }
        }
		//	debug.debug();
    //    debug.log.print("测试不通1");
        thread.set("isOnTesting", false);
     //   debug.log.print("outboundIndex", outboundIndex, "outboundAddress", outboundAddress);
        // 新方式：push 一个 table
     //   frmXray.callRetryQueueA(outboundIndex,outboundAddress,timerTesting);
     frmXray.onStartXrayFailed(outboundIndex, outboundAddress, timerTesting);

    }
);


// 3. 你的调用函数
testOutbound = function(outboundIndex, outboundAddress, timerTesting){
    if(!outboundIndex || !outboundAddress) return;

//	debug.log.print("testOutbound开始");
//	console.dump(thread.get("isOnTesting"));
	if(thread.get("isOnTesting")) {
	//	debug.log.print("isOnTesting，返回");
		return; // 已有测试进行中
	}
	thread.set("isOnTesting",true);
//	console.dump(thread.get("isOnTesting"));

    if(outboundAddress == frmXray.listview.getItemText(outboundIndex, 2)) {
        frmXray.listview.setItemText("测试中...", outboundIndex, 8);
    }
    frmXray.listview.ensureVisible(outboundIndex);

  //  debug.log.print("outboundIndex", outboundIndex, "outboundAddress", outboundAddress);

    // 提前在主线程获取纯数据，避免传递复杂对象导致序列化失败
    var sysProxyConfig = xray.core.getSystemProxyConfig();
    var httpProxyAddress = "";

    // 假设 getSystemProxyConfig 返回的是字符串或包含 host/port 的简单表
    if(type(sysProxyConfig) == "string"){
        httpProxyAddress = sysProxyConfig;
    }
    elseif(type(sysProxyConfig) == "table" && sysProxyConfig.host){
        httpProxyAddress = sysProxyConfig.host ++ ":" ++ tostring(sysProxyConfig.port);
    }

    // 获取当前的延迟值（纯数值）
    var currentDelay = 1000; // 默认值
    if(config.proxy.outbounds[outboundIndex] && config.proxy.outbounds[outboundIndex].replyDelay){
        currentDelay = config.proxy.outbounds[outboundIndex].replyDelay;
    }

    // 将所有参数打包成纯数据表（包含 frmXray 窗口对象）
    var taskData = {
        frmXray = frmXray;
        outboundIndex = outboundIndex;
        outboundAddress = outboundAddress;
        httpProxyAddress = httpProxyAddress; // 现在是纯字符串了
        timerTesting = timerTesting;
        currentDelay = currentDelay; // 现在是纯数值了
    };

    // 只推送一个 table 参数，彻底避免多参数传递时的序列化问题
    taskQueueA.push(taskData);

    return true;
}



