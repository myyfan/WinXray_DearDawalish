							frmXray.listview.setItemText("",b,8);
						}
*/
						//activeOutbound(currentIdx,frmXray.listview.getItemText(currentIdx,2),false)
						isManualSwitch = true;
						switchOutbound(currentIdx,frmXray.listview.getItemText(currentIdx,2),true)//不为true会导致节点失败后自动切换一个节点
					}
