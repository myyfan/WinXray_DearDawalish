//流量统计
/*
【UI 线程禁网改造 · 常驻采样线程】

原实现：frmXray.trafficStats 的 2 秒定时器在【UI 线程】里直接调 TrafficStats.start() 去读 gRPC 统计，
        每次都要「新建 socket → connect → h2 握手 → 2 次 RPC」；
        而 wsock.tcp.client.connect 没有超时、readEx 有 3 秒接收超时 ——
        一旦内核未就绪 / API 端口未监听 / 统计服务无响应，UI 线程就会被阻塞数秒；
        此时 Windows 只派发 sent 消息、不派发 posted 消息
        → 点击、重绘、定时器全部停摆（CPU 却是 0%，任务管理器也不显示“未响应”，极难排查）。

现实现：采样搬到【常驻后台线程】，UI 定时器只读「已发布的结果」算增量，全程零 socket 调用。
        · 常驻线程用「代际号 gen」优雅退出：需要换端口时 gen+1，旧线程下一轮自行 return；
          绝不 terminate —— 实测被强杀的线程所持内存 100% 不归还。
        · 采样线程每轮都发布心跳，UI 侧据此自愈（线程没了就重启）。
        · 常驻线程实测内存零增长；反复「建池 + 销毁」才会持续泄漏。
*/
import xray.core;
import config;
import debug;
import debug.log;
import uiNet;

namespace TrafficStats;
coreType = "xray";
corePath = ..io.fullpath("/core/xray/xray.exe");


var inbounds = ..config.core.default[["inbounds"]];
var apiPort = inbounds[3].port;
//apiPort = 1083;   //（旧默认值 10084 已统一为 1083）

reset = function(){
	import debug
	import debug.log
	if( prcsCmd ){ prcsCmd.terminate();prcsCmd = null; }
	import xray.core;

	port = '--server=127.0.0.1:'+apiPort;

	getPath = function(){
		import debug
		import debug.log
		var path = ..io.fullpath("/core/xray/xray.exe");
		if(..io.exist(path)){
			return path;
		}
		coreType = "xray";
		corePath = getPath();
		corePath = ..io.fullpath("/core/xray/xray.exe");
	}
}
reset();

//==================== 采样线程 ↔ UI 线程的共享键 ====================
var SAMPLE_KEY = "TrafficStats.sample";   //采样线程发布：{seq,down,up,tick}
var GEN_KEY = "TrafficStats.gen";         //代际号：+1 即让旧采样线程优雅退出
var PORT_KEY = "TrafficStats.port";       //采样线程当前使用的 API 端口

var samplerGen = 0;

//UI 侧已消费游标（只存两个数值，不存节点数据）
var lastSeq,lastDown,lastUp,lastTick = 0,0,0,0;
var samplerIntervalMs = 2000;   //采样线程的采样周期（takeSample 的兜底值）

//==================== 常驻采样线程（纯函数）====================
/*
【为什么必须是纯函数】它会被序列化到新线程执行：
· 不能引用外部 upvalue（模块级 var / 局部变量 / 闭包）；
· 端口、间隔、键名全部通过参数传入；
· 线程内引用库用 .. 前缀（已实测 ..xray.grpc 在新线程内解析正常）。
*/
var samplerWorker = function(port, intervalMs, gen, sampleKey, genKey){

	import xray.grpc;

	var totalDown,totalUp = 0,0;
	var seq = 0;

	/*
	常驻客户端（连接复用）：内部持有一条常驻连接，下面每轮的调用都复用它，
	不再「每轮新建连接」。本线程自己 create、自己用（socket 对象不可跨线程共享）。
	*/
	var client = ..xray.grpc.create("127.0.0.1", port, 3000);

	/*
	【★ 启动时必须先「丢弃」一次统计 —— 清空内核计数器】

	Xray 的统计计数器从内核启动起就一直在累加；reset 只是「读后清零」。
	所以「第一次」queryStats(reset=true) 返回的其实是
	【内核启动（或上次 reset）以来的全部累计流量】，而不是本周期增量。

	如果不先丢弃：切换服务器 / 内核重启后流量定时器会重启，
	采样线程第一次读到的就是这一大坨历史累计 ——
	UI 侧把它当成「2 秒内的增量」→ 速度算出天文数字；
	而速度又是「只记最大值」，于是这个假值会被永久写进配置
	（config.proxy.outbounds[].downSpeed），从此该节点一直显示这个假速度。

	这里先做一次「只读不用」的丢弃，让后续采样从干净状态开始。
	*/
	..xray.grpc.queryStats(client, "outbound>>>proxy>>>traffic>>>", true);

	while( true ){

		//代际号变了 → 优雅退出（自然 return，线程自行结束；绝不 terminate）
		if( ..thread.get(genKey) !== gen ){ break; }

		var down,up = 0,0;

		/*
		【一次查询同时拿回上行 + 下行】
		原来用 GetStats（单计数器接口）读两次 —— 两条连接、两次 RPC。
		改用 QueryStats（支持前缀匹配）一次即可返回该前缀下的所有计数器：
			{ {name="outbound>>>proxy>>>traffic>>>downlink"; value=...},
			  {name="outbound>>>proxy>>>traffic>>>uplink";  value=...} }
		reset=true 的语义与 GetStats 的 reset 相同（读取后清零，返回本周期增量）。
		*/
		var arr = ..xray.grpc.queryStats(client, "outbound>>>proxy>>>traffic>>>", true);

		if( arr ){
			for(i=1;#arr;1){
				var st = arr[i];
				if( st.name == "outbound>>>proxy>>>traffic>>>downlink" ){ down = st.value; }
				elseif( st.name == "outbound>>>proxy>>>traffic>>>uplink" ){ up = st.value; }
			}
		}

		totalDown += down;
		totalUp += up;
		seq++;

		//每轮都发布（UI 侧同时用 tick 判断采样线程是否还活着）
		..thread.set(sampleKey, {
			seq = seq;
			down = down;
			up = up;
			tick = ..time.tick();
		});

		sleep(intervalMs);
	}

	client.close();   //线程退出时关闭常驻连接
	return true;
};

//==================== UI 侧接口（全部零网络调用）====================

//当前 API 端口：每次现读（端口会漂移，绝不能用模块加载时缓存的旧值）
//【修正】优先取 ..xray.core.apiPort（运行时的权威值）：
//   「兜底保险」下临时分配的端口不会写回配置，只存在于该变量里；
//   若只读配置会拿到「避让结果」，与内核实际监听的端口不一致。
var currentApiPort = function(){
	var p = ..xray.core[["apiPort"]];
	if(p){ return p; }
	p = ..config.core.default[["inbounds"]][3][["port"]];
	if(p){ return p; }
	return apiPort;
};

//采样线程是否活着：看它发布的心跳新鲜度
samplerAlive = function(){
	var s = ..thread.get(SAMPLE_KEY);
	if(!s){ return false; }
	return (..time.tick() - s.tick) < 8000;
};

/*
启动 / 复用常驻采样线程（幂等）。
· 同一端口且心跳新鲜 → 直接复用现有线程；
· 否则代际号 +1，让旧线程下一轮自行退出（优雅退出，绝不 terminate）。
*/
startSampler = function(intervalMs){
	var port = currentApiPort();
	if(!port){ return false; }

	if( samplerAlive() && (..thread.get(PORT_KEY) === port) ){
		return true;
	}

	if(!intervalMs){ intervalMs = 2000; }
	samplerIntervalMs = intervalMs;

	samplerGen++;
	..thread.set(GEN_KEY, samplerGen);
	..thread.set(PORT_KEY, port);
	..thread.set(SAMPLE_KEY, null);

	lastSeq,lastDown,lastUp,lastTick = 0,0,0,0;   //新线程的累计量从 0 开始 → 重置游标

	//常驻线程：跑循环自行退出（实测常驻线程内存零增长；反复建销线程池才会泄漏）
	..thread.invoke(samplerWorker, port, intervalMs, samplerGen, SAMPLE_KEY, GEN_KEY);

	..debug.log.print("[TrafficStats] 常驻采样线程已启动（API 端口 " ++ port ++ "，间隔 " ++ intervalMs ++ "ms）");
	return true;
};

/*
取「本次增量」：读后台线程发布的累计量，减去上次已消费的量。
没有新样本返回 null（调用方用 if(downValue) 判断即可，与旧行为一致）。
*/
takeSample = function(){
	var s = ..thread.get(SAMPLE_KEY);
	if(!s){ return null; }
	if(s.seq === lastSeq){ return null; }

//	var dDown = s.down - lastDown;
//	var dUp = s.up - lastUp;

	/*
	【时间跨度 elapsedMs 必须取「样本发布时的时间戳」，不能用 UI 定时器的名义间隔】
	增量与时间跨度必须来自同一段真实时间，速度才算得对。
	UI 定时器会因界面繁忙、saveAsync 有意丢弃 WM_TIMER 等原因延迟数秒 ——
	那时增量其实覆盖了更长的时间；若仍按固定的 2 秒去换算，速度就会虚高数倍
	（例：延迟 7 秒才取样 → 增量是 7 秒的量，按 2 秒算 ⇒ 速度虚高 3.5 倍）。
	*/
	var elapsedMs = lastTick ? (s.tick - lastTick) : samplerIntervalMs;

	lastSeq = s.seq;
//	lastDown = s.down;
//	lastUp = s.up;
	lastTick = s.tick;

	//采样线程换代后累计量归零 → 增量可能为负，夹紧为 0
//	if(dDown < 0){ dDown = 0; }
//	if(dUp < 0){ dUp = 0; }
	if(!elapsedMs || elapsedMs <= 0){ elapsedMs = samplerIntervalMs; }

	//返回：下行增量、上行增量、【本次样本实际覆盖的毫秒数】
	return s.down,s.up,elapsedMs;
};

/*
兼容旧调用名 start()：旧代码用它「重置流量统计」（忽略返回值）。
现在语义 = 重置游标 + 确保采样线程在跑，【不做任何网络调用】。
*/
start = function(intervalMs){
	lastSeq,lastDown,lastUp,lastTick = 0,0,0,0;
	startSampler(intervalMs);
	return true;
};

//==================== 同步读取（仅限后台线程；UI 线程调用会被拒绝）====================
readOnce = function(){
	if( ..uiNet.isUIThread() ){
		..debug.log.print("[TrafficStats] 拒绝在 UI 线程执行同步网络读取（请改用 startSampler / takeSample）");
		return 0,0;
	}

	if(!corePath || !coreType){ return }

	if(coreType=="xray"){
		//【性能】改为纯 gRPC 直连读取统计（xray.app.stats.command.StatsService/GetStats）。
		//
		//原来这里是 process.popen(corePath,"api","statsquery",...)：
		//每次都要「启动一个新的 xray.exe 进程 → 连 API → 读输出 → 退出」，
		//实测单次 500~610 毫秒。
		//
		//gRPC 直连（lib/xray/grpc.aardio，纯 aardio 实现 h2c + gRPC + protobuf）：
		//实测「建连 + 读下行 + 读上行」共约 12 毫秒，比进程方案快约 50 倍。
		//
		//reset 参数与原来的 "-reset" 等价：读取后清零，返回的是「本周期增量」。
		import xray.grpc;

		var client = ..xray.grpc.create("127.0.0.1",currentApiPort(),3000);

		//一次查询同时拿回上行 + 下行（QueryStats 前缀匹配 + reset）
		var down,up = 0,0;
		var arr = ..xray.grpc.queryStats(client,"outbound>>>proxy>>>traffic>>>",true);
		if(arr){
			for(i=1;#arr;1){
				var st = arr[i];
				if(st.name == "outbound>>>proxy>>>traffic>>>downlink"){ down = st.value; }
				elseif(st.name == "outbound>>>proxy>>>traffic>>>uplink"){ up = st.value; }
			}
		}
		client.close();

		return down,up;
	}
	elseif(coreType=="v2ray"){
		corePath = ..io.joinpath(..io.splitpath(corePath).dir,"v2ctl.exe");
		var downTraffic = ..win.invoke(
			function(corePath,apiPort){
				import process.popen;
				import web.json;
				var cmdText = '\"outbound>>>proxy-out>>>traffic>>>downlink\"';

				var json ;
				var i = 3 ;
				do {
					prcsCmd = ..process.popen(corePath,corePath,"api",apiPort,"StatsService.GetStats",'\"name:'+cmdText+'reset:true\"');
					var json = string.replace(string.replace(prcsCmd.read(-1),"\\<\\",'\\{'),"\\>\\s*$",'\\}');
					i--;
				}while( !json && i > 0)
				var table = ..web.json.tryParse(json);
				var value = (json && json.stat.value) ? json.stat.value : false;
				return value;
			}
		)
		var upTraffic = ..win.invoke(
			function(corePath,apiPort){
				import process.popen;
				import web.json;
				var cmdText = '\"outbound>>>proxy-out>>>traffic>>>uplink\"';
				prcsCmd = ..process.popen(corePath,corePath,"api",apiPort,"StatsService.GetStats",'\"name:'+cmdText+'reset:true\"');
				var json = string.replace(string.replace(prcsCmd.read(-1),"\\<\\",'\\{'),"\\>$",'\\}');
				var table = ..web.json.tryParse(json);
				var value = (json && json.stat) ? json.stat.value : false;
				return value;
			}
		)
		return downTraffic,upTraffic;
	}
};

/**intellisense(TrafficStats)
reset = 重置
start = 兼容旧接口：重置流量统计并确保采样线程在跑（不做网络调用）
startSampler = 启动/复用常驻采样线程（UI 线程调用，零网络调用）
takeSample = 取本次流量增量（UI 线程调用，零网络调用），无新样本返回 null
samplerAlive = 常驻采样线程是否存活（心跳新鲜度）
readOnce = 同步读取流量（仅限后台线程；UI 线程调用会被拒绝）
end intellisense**/
