
//config 配置文件 
import fsys.config;
import debug
import debug.log

//debug.log.print("config 启动")
//debug.debug();

config  = fsys.config("/config/"); 


if(!config.proxy.mode) config.proxy.mode = "pac";
if(!config.proxy.pacPort) config.proxy.pacPort = 0;
//debug.log.print("debug.log.print")
if(config.proxy.useHttpGlobal === null){
	config.proxy.useHttpGlobal = true;
	
	//debug.log.print("config.proxy.useHttpGlobal === null")
	//debug.debug()
}
if(config.proxy.useSocksPac === null){
	config.proxy.useSocksPac = _WIN10_LATER;
}

if(config.proxy.enableGitConfigGithub === null){
	config.proxy.enableGitConfigGithub = true;
}

if(config.proxy.test === null){
	config.proxy.test = true;
}

if(config.settings.autoStartTest === null){
	config.settings.autoStartTest = true;
}


if(!config.proxy.testInterval){
	config.proxy.testInterval = 15;
}

if(!config.proxy.maxTestServers){
	config.proxy.maxTestServers = 100;
}

// 后台搜索模式并发测试的服务器数量（同时给 Xray 配置多个出口 + 多个搜索入站端口）
if(!config.proxy.searchBatchSize){
	config.proxy.searchBatchSize = 10;
}

if(config.subscribe.autoRefreshSubscription === null){
	config.subscribe.autoRefreshSubscription = false;
}

if(!config.subscribe.subscribeUrls){
	config.subscribe.subscribeUrls = {
		fields =  {"";"checked";"ps";"url";}
	}
}

// 订阅地址「后缀白名单」：链接末尾命中这些后缀（忽略大小写）就会被当作订阅地址提取出来。
// 配置里没有（或为空）时用下面的默认值自动填入，之后可以直接改 config/subscribe.table，
// 也可以在软件的「订阅配置」页面点「链接提取规则」按钮编辑。
if(!config.subscribe.linkAllowedExts || !#config.subscribe.linkAllowedExts){
	config.subscribe.linkAllowedExts = {
		"v2ray";"clash";"singbox";".txt";".html";".net";".json";".yml";".yaml"
	}
}

// 「需要二次访问的域名名单」：从网页里提取到的链接，只有域名命中这个名单时才会被再访问一次，
// 用于从该网页里进一步提取上面的订阅地址。
// 可以写 github.com，也可以写 *.github.io 这类通配写法；子域名自动算命中。
// 配置里没有（或为空）时用下面的默认值自动填入。
if(!config.subscribe.linkVisitDomains || !#config.subscribe.linkVisitDomains){
	config.subscribe.linkVisitDomains = {
	//	"github.com";"github.io";"netlify.app";"wenpblog.com"
	}
}

if(!config.proxy.hotkey){
	config.proxy.hotkey = {1/*_MOD_ALT*/|2/*_MOD_CONTROL*/|4/*_MOD_SHIFT*/;'P'#}
}

if(config.proxy.outbounds === null){
	config.proxy.outbounds = ..table.array();
}

config.__resetDefaultCore = function(){
	config.core.default =  {
    "inbounds":{
        {
            "listen":"0.0.0.0",
            "port":10081,
            "protocol":"socks",
            "tag":"proxy",
            "settings":{
                "auth":"noauth",
                "udp":true
            },
            "sniffing":{
                "destOverride":{
                    "http",
                    "tls"
                },
                "enabled":true
            }
        },
        {
            "listen":"0.0.0.0",
            "port":10082,
            "protocol":"http",
            "tag":"http_proxy",
            "settings":{

            },
            "sniffing":{
                "destOverride":{
                    "http",
                    "tls"
                },
                "enabled":true
            }
        },
        {
            "listen":"127.0.0.1",
            "port":10084,
            "protocol":"dokodemo-door",
            "tag":"api",
            "settings":{
                "address":"127.0.0.1",
                "allowTransparent":false,
                "udp":false
            }
        },
        {
            "listen":"0.0.0.0",
            "port":10091,
            "protocol":"socks",
            "tag":"proxySearcher",
            "settings":{
                "auth":"noauth",
                "udp":true
            },
            "sniffing":{
                "destOverride":{
                    "http",
                    "tls"
                },
                "enabled":true
            }
        },
        {
            "listen":"0.0.0.0",
            "port":10092,
            "protocol":"http",
            "tag":"http_proxySearcher",
            "settings":{

            },
            "sniffing":{
                "destOverride":{
                    "http",
                    "tls"
                },
                "enabled":true
            }
        }
    },
    "outbounds":{
        {
            "tag":"proxy"
        },
        {
            "protocol":"freedom",
            "tag":"direct",
            "settings":{

            }
        },
        {
            "protocol":"blackhole",
            "tag":"block",
            "settings":{
                "response":{
                    "type":"http"
                }
            }
        }
    },
    "api":{
        "services":{
            "HandlerService",
            "LoggerService",
            "StatsService"
        },
        "tag":"api"
    },
    "dns":{
        "servers":{
            "114.114.114.114",
            {
                "address":"1.1.1.1",
                "domains":{
                    "geosite:geolocation-!cn"
                },
                "port":53
            }
        }
    },
    "log":{
        "access":"",
        "error":"",
        "loglevel":"warning"
    },
    "policy":{
        "levels":{
            "0":{
                "statsUserDownlink":false,
                "statsUserUplink":false
            }
        },
        "system":{
            "statsInboundDownlink":false,
            "statsInboundUplink":false,
            "statsOutboundDownlink":true,
            "statsOutboundUplink":true
        }
    },
    "routing":{
        "domainStrategy":"IPOnDemand",
        "rules":{
            {
                "inboundTag":{
                    "api"
                },
                "outboundTag":"api",
                "type":"field"
            }, 
                {
                "inboundTag":{
                    "proxySearcher",
                    "http_proxySearcher"
                },
                "outboundTag":"proxySearcher",
                "type":"field"
            },
            {
                "domain":{
                    "geosite:category-ads-all"
                },
                "outboundTag":"block",
                "port":"",
                "type":"field"
            },
            {
                "domain":{
                    "geosite:gfw"
                },
                "outboundTag":"proxy",
                "type":"field"
            },
            {
                "ip":{
                    "geoip:cn",
                    "geoip:private"
                },
                "outboundTag":"direct",
                "type":"field"
            }
        }
    },
    "stats":{

    }
}
}

if(!config.core.default){
	config.__resetDefaultCore();
}

//config.__resetDefaultCoreOutbounds = function(){
	config.core.outBoundDefault =  {
    
    	"outbounds":{
        	{
            	"tag":"proxy"
        	}
    	}
	
	}
//}


/*
if(!config.core.outBoundDefault){
	config.__resetDefaultCoreOutbounds();
}
*/

// 将core配置的json页面隐藏掉，就不可能会有删除第二个入站的可能了，那么这里就可以注释掉了
if(!config.core.default.inbounds[2]){
	config.core.default.inbounds[2]	= {
		listen="127.0.0.1";
		port=0;
		protocol="http";
		settings={};
		sniffing={
			destOverride={
				"http";
				"tls"
			};
			enabled=true
		};
		tag="http_proxy"
	}
}
