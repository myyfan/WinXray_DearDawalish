//内核进程
import xray.core.ssr;
import xray.core.naive;
import wsock.tcp.server;
import process.popen;
//import config;

	
namespace xray.core;

socksProxyPort = null;
httpProxPort = null;
apiPort = null;
searcherSocksProxyPort = null;
searcherHttpProxyPort = null;
// 多出口并行搜索：N 个搜索器入站端口数组 + 并发数
searcherSocksProxyPorts = null;
searcherHttpProxyPorts = null;
searchBatchSize = null;
// 搜索器槽位数上限：内核按该值一次性预建全部槽位（入站 + 路由规则），
// 因此「高级配置」调整并发数时无需重启内核（不会中断当前代理连接）。
// 并发数的有效范围是 1 ~ searcherSlotMax。
searcherSlotMax = 50;
// 获取系统代理配置
getSystemProxyConfig = function(){
    if(!(socksProxyPort&&httpProxPort)){ return null; }//有设置代理就什么也不做，没有就返回null
	return ..config.proxy.useHttpGlobal ? ("127.0.0.1:" + httpProxPort ): ("SOCKS=127.0.0.1:"+socksProxyPort)  //返回代理配置信息
} 

// 判断入站端口是否被修改
isInboundPortChanged = function(){
	var inbounds = ..config.core.default.inbounds;
	// 如果inbounds不是数组或者数组长度小于2，则返回true，表示端口有变化
	// 屏蔽掉json界面后，这里应该也可以注释掉
	if(! (..table.isArrayLike(inbounds) && inbounds[1] && inbounds[2]) ){
		return true;
	}	
	
	// 判断socksProxyPort和httpProxPort与配置文件中的端口是否相等
	// 只要有一个不一样，返回的就是false
	return (inbounds[1].port!=socksProxyPort) || (inbounds[2].port!=httpProxPort)
}

// xray进程
 prcsxray =null ;

	import debug
	import debug.log
	import console
//console.dump(prcsxray)
//prcsxray = null;
// xray启动中，注意最后需要置为false表示启动结束，否则再次选择节点时会失败
var xrayStarting;
import process.job.limitKill;
// 重启xray
restart = function(editor,outbound){
	import debug
	import debug.log
	import console
	//console.dump(prcsxray)
	
    if(!outbound){ return null,"错误的出站代理服务器配置"  }
    if(_WINXP){
    	return null,"抱歉！Xray Core 不支持 Windows XP, 仅支持 Windows 7, Windows 10 以及更新操作系统。";  
    }

	var inbounds = ..config.core.default[["inbounds"]];
	if(! (..table.isArrayLike(inbounds) && inbounds[1] ) ){
		return null,"错误的入站SOCKS代理服务器配置" 
	}
	if(! ( inbounds[2] ) ){
		return null,"错误的入站HTTP代理服务器配置" 
	}

	if(xrayStarting){ return null,"不能重复启动 Xray Core"  } 
	xrayStarting = true;
	
	
	var corePath = getPath(editor.hwnd);
	if(!corePath){ 
		xrayStarting = false;
		return false,"启动失败,未找到 xray.exe"; 
	}  

	if( outbound.protocol == "ssr" ){ 
		if(!..xray.core.ssr.getPath(editor.hwnd)){
			xrayStarting = false;
			return false,"启动失败,未找到 SSR Core";
		}
	}
	if( outbound.protocol == "naive" ){ 
		if(!..xray.core.naive.getPath(editor.hwnd)){
			xrayStarting = false;
			return false,"启动失败,未找到 NaïveProxy Core";
		}
	}
	
	..publish("activeOutbound",false);
	
	import sysProxy;
	// reset，不使用代理
	..sysProxy.reset(false);

	socksProxyPort = inbounds[1].port;  
	httpProxPort = inbounds[2].port;
	apiPort = inbounds[3].port;
	searcherSocksProxyPort = inbounds[4].port;
	searcherHttpProxyPort = inbounds[5].port;
	
	// === 多出口并行搜索：生成 N 个搜索器入站端口 ===
	// 槽位数上限：内核按该值一次性预建全部搜索器槽位（入站 + 路由规则）。
	// 这样「高级配置」里调整并发数就无需重启内核 —— 内核配置的槽位数与当前并发数解耦。
	// 注意：aardio 中 null 参与 > 比较或 math.floor 都会报错，必须先判空归一化
	var slotMax = tonumber(self.searcherSlotMax);
	if(!slotMax || slotMax < 1) slotMax = 50;
	slotMax = ..math.floor(slotMax);

	// 并发数来自配置项 config.proxy.searchBatchSize（可在「高级配置」界面用滑尺调整）
	var batchSize = tonumber(..config.proxy.searchBatchSize);
	if(!batchSize || batchSize < 1) batchSize = 10;
	if(batchSize > slotMax) batchSize = slotMax;
	batchSize = ..math.floor(batchSize);
	self.searchBatchSize = batchSize;   // 期望并发数（决定线程池尺寸，可随时调整）
	
	searcherSocksProxyPort = tonumber(searcherSocksProxyPort) : 10091;
	searcherHttpProxyPort = tonumber(searcherHttpProxyPort) : 10092;
	
	searcherSocksProxyPorts = ..table.array();
	searcherHttpProxyPorts = ..table.array();
	// >>>>> SD-BEGIN
	debug.log.print("[SD] PORT-BEGIN batchSize=",batchSize,"slotMax=",slotMax,"baseSocks=",searcherSocksProxyPort,"baseHttp=",searcherHttpProxyPort,"prcsxray=",tostring(prcsxray));
	// <<<<< SD-END
	// 【预分配】槽位按上限 slotMax 一次性建好：内核配置里的槽位数与「当前并发数」解耦，
	// 于是在「高级配置」里调整并发数只需重建线程池，无需重启内核（不会中断当前代理连接）。
	for(i=1;slotMax;1){
		// >>>>> SD-BEGIN
		var sdWantSocks = searcherSocksProxyPort + (i-1)*2;
		var sdWantHttp  = searcherHttpProxyPort + (i-1)*2;
		// <<<<< SD-END
		searcherSocksProxyPorts[i] = ..wsock.tcp.server.getFreePort("127.0.0.1", sdWantSocks);  // >>>>> SD
		searcherHttpProxyPorts[i] = ..wsock.tcp.server.getFreePort("127.0.0.1", sdWantHttp);  // >>>>> SD
		// >>>>> SD-BEGIN
		debug.log.print("[SD] PORT i=",i,"wantSocks=",sdWantSocks,"gotSocks=",tostring(searcherSocksProxyPorts[i]),"wantHttp=",sdWantHttp,"gotHttp=",tostring(searcherHttpProxyPorts[i]));
		// <<<<< SD-END
	}
	// >>>>> SD-BEGIN
	debug.log.print("[SD] PORT-END socksN=",#searcherSocksProxyPorts,"httpN=",#searcherHttpProxyPorts,"batchSize=",batchSize);
	// <<<<< SD-END
	searcherSocksProxyPort = searcherSocksProxyPorts[1];
	searcherHttpProxyPort = searcherHttpProxyPorts[1];
/*
	console.dump(socksProxyPort)
	console.dump(httpProxPort)
	console.dump(apiPort)
	console.dump(searcherSocksProxyPort)
	console.dump(searcherHttpProxyPort)
*/
	//debug.log.print(inbounds[4].port)
	//debug.log.print(inbounds[5].port)
	// 49152是默认动态端口范围的开始端口，49152-65535
	// 如果没有设置端口，或者设置端口的是动态端口，那么就使用默认提供的端口（下面多个端口表示依次优先获取）
	if( (! socksProxyPort) || socksProxyPort >=  49152 ){ socksProxyPort = ..wsock.tcp.server.getFreePort("127.0.0.1",10081,10801,10811,44821)  }
	if( (! httpProxPort) || httpProxPort >=  49152 ){ httpProxPort = ..wsock.tcp.server.getFreePort("127.0.0.1",10082,10802,10812,44822) }
	
	// 停止各种core
	if(prcsxray){
		prcsxray.terminate();
		prcsxray = null;
	}
	
	..xray.core.ssr.stop();
	..xray.core.naive.stop();
	
	var nexCore;
	if( outbound.protocol == "ssr" ){  
		var nextProxyPort = ..wsock.getFreePort();
		if(!..xray.core.ssr.restart(editor,outbound,nextProxyPort)){
			xrayStarting = false;
			return false,"SSR Core 启动失败";
		}

		// 修改outbound变量，让xray的config.json中，outbound配置指向自己
		outbound = {
			protocol = "socks";
			address = "127.0.0.1";
			port = nextProxyPort;
		} 
		
		nexCore = ..xray.core.ssr;
	}
	elseif( outbound.protocol == "naive" ){  
		var nextProxyPort = ..wsock.getFreePort();
		if(!..xray.core.naive.restart(editor,outbound,nextProxyPort)){
			xrayStarting = false;
			return false,"Naive Core 启动失败";
		}

		// 修改outbound变量，让xray的config.json中，outbound配置指向自己
		outbound = {
			protocol = "socks";
			address = "127.0.0.1";
			port = nextProxyPort;
		} 
		
		nexCore = ..xray.core.naive;
	}

	// 启动程序时点击按钮，prcsxray为空，进入分支
	//console.dump(prcsxray);
	if( ! prcsxray ){ 
		import xray.core.configJson;
		// 生成xray的config.json文件
		// Xray 26.x 已移除 allowInsecure（成为硬错误），自签证书节点需改用 pinnedPeerCertSha256。
		// 证书指纹统一由后台任务抓取（frmXray.startCertPinFetch），此处不做同步网络等待，
		// 以免启动或切换内核时阻塞界面。
		
		var jsonPath,err = ..xray.core.configJson.write(
			..io.joinpath(..io.splitpath(corePath).dir,"config.json")
			,outbound,socksProxyPort,httpProxPort,searcherSocksProxyPorts,searcherHttpProxyPorts);
	
		if(!jsonPath){
			if( nexCore ){ nexCore.stop(); } 
			
			xrayStarting = false;
			return false,err:"启动失败,写入配置文件遇到错误！"; 
		}
		
		var err;
		prcsxray,err = ..process.popen(corePath,"-c=config.json" );
		if(!prcsxray){
			if( nexCore ){ nexCore.stop(); }
	
			..publish("uiCommand.print",err:"启动 Xray Core 时遇到未知错误!");
			
			if(!..process().isWow64()){
				if(..process.isExe(corePath)!="PE32"){
					..io.remove(corePath);
					if(!..io.exist(corePath)){
						..publish("uiCommand.print","当前操作系统是32位，已删除无效的64位 Xray Core，正在下载32位 Xray Core");
						xrayStarting = false;
						return restart(editor,outbound)	
					}
					else {
						..publish("uiCommand.print","当前操作系统是32位，但是找到的 Xray Core 是64位，请重新下载32位 Xray Core");
					} 
				} 	
			}
			
			xrayStarting = false;
			return;
		}
		prcsxray.assignToJobObject(process.job.limitKill);
		prcsxray.codepage = 65001;	
		prcsxray.logResponse(editor);  
		
		inbounds[1].port = socksProxyPort;
		inbounds[2].port = httpProxPort;
		apiPort = inbounds[3].port;
		..config.core.save();
	}
	
	..publish("uiCommand.print","已启动代理服务器，SOCKS端口:" + socksProxyPort + " HTTP端口:" + httpProxPort) 
	..publish("xrayCore.restarted",socksProxyPort,httpProxPort); 
	
	xrayStarting = false;
	//console.dump(prcsxray);
	return true;
}
//==================== Xray API（gRPC 直连，替代 ado/rmo 进程调用）====================
//纯 aardio 实现 h2c + gRPC + protobuf：不写磁盘配置文件、不启动额外 xray.exe 进程。
//实测单次调用约 4~5ms（本机回环），远快于启动进程（约 400ms）。
var grpcAddOutbound = function(proxyTag,outbound){
	import xray.core.configJson;
	import xray.grpc;
	//仅构建出站对象（jsonPath 传 null 表示不写磁盘文件）
	var ob,err = ..xray.core.configJson.writeSearcherOutboundConfig(null,outbound,proxyTag);
	if(!ob){
		return null,err:"生成出站配置失败";
	}
	var client = ..xray.grpc.create("127.0.0.1",apiPort,3000);
	return ..xray.grpc.addOutbound(client,proxyTag,ob);
};

var grpcRemoveOutbound = function(proxyTag){
	import xray.grpc;
	var client = ..xray.grpc.create("127.0.0.1",apiPort,3000);
	return ..xray.grpc.removeOutbound(client,proxyTag);
};

//新的添加出口服务器函数，修改自startSearcher函数
addOutbound = function(frmXray,editor,outbound,proxyTag,outConfigJsonName){
	import debug
	import debug.log

	//启动程序时点击按钮，prcsxray为空，进入分支
	if(!prcsxray){
		frmXray.setSearcherTimer();
		return true;
	}

	var corePath = getPath(editor.hwnd);
	if(!corePath){
		xrayStarting = false;
		return false,"启动失败,未找到 xray.exe";
	}

	var ok,err = grpcAddOutbound(proxyTag,outbound);
	if(!ok){
		debug.log.print("gRPC 添加出站失败",proxyTag,tostring(err));
		return null,tostring(err);
	}
	return proxyTag;
}

//新的删除出口服务器函数，修改自stopSearcher函数
deleteOutbound = function(editor,outbound,proxyTag,outConfigJsonName){
	import debug
	import debug.log
	var ok,err = grpcRemoveOutbound(proxyTag);
	if(!ok){
		debug.log.print("gRPC 删除出站失败",proxyTag,tostring(err));
		return null;
	}
	return proxyTag;
}
//开始搜索
startSearcher = function(editor,outbound){
	import debug
	import debug.log
	import console
	//debug.debug();
	//console.dump(prcsxray);
	
	var corePath = getPath(editor.hwnd);
	if(!corePath){ 
		xrayStarting = false;
		return false,"启动失败,未找到 xray.exe"; 
	}  

	// 启动程序时点击按钮，prcsxray为空，进入分支
	//console.dump(prcsxray);
	
	if(prcsxray){ 
		
		import xray.core.configJson;
		// 生成xray的config.json文件
		var configPath = ..io.joinpath(..io.splitpath(corePath).dir,"searcherConfig.json");
		//debug.log.print(configPath);
		var jsonPath,err = ..xray.core.configJson.writeSearcherOutboundConfig(
			..io.joinpath(..io.splitpath(corePath).dir,"searcherConfig.json")
			,outbound,1091,1092);
	
		if(!jsonPath){
						
			return false,err:"启动失败,写入配置文件遇到错误！"; 
		}
	
	//	prcsCmd,err = ..process.popen(corePath,' api',' ado','--server=127.0.0.1:10084',..io.joinpath(..io.splitpath(corePath).dir,"searcherConfig.json"));
		prcsCmd,err = ..process.popen(corePath,' api',' ado','--server=127.0.0.1:'+apiPort,..io.joinpath(..io.splitpath(corePath).dir,"searcherConfig.json"));
		return   ..string.match(prcsCmd.read(-1),"proxySearcher");
		//debug.log.print("添加配置：")
		//console.dump(json);
		//console.dump(prcsCmd);
		//var err;
		//prcsxray,err = ..process.popen(corePath,"-c=config.json" );

	

	}
	else {
		//sleep(1000);
		frmXray.setSearcherTimer();
	}
	
	
	//..publish("uiCommand.print","已启动代理服务器，SOCKS端口:" + socksProxyPort + " HTTP端口:" + httpProxPort) 
	return true;
}
