//configJson 内核配置
import config;
import web.json;
import inet.url;
import crypt;
import xray.protocols;

namespace xray.core.configJson;
	
/* ============================================================
   Xray 26.x 传输/安全增强
   - REALITY 客户端配置生成
   - XHTTP 生成，并迁移 Xray 26 已移除的 http/h2 传输
   - uTLS 指纹（client-fingerprint）
   说明：Xray 会静默忽略不认识的字段，按协议规范全量输出是安全的。
   ============================================================ */

// Xray 26.x 出站协议白名单。
// 内核遇到不认识的协议名会直接拒绝加载整份配置（unknown config id），
// 因此对 Xray 暂不支持的协议（anytls/mieru/ssr/snell/tuic/shadowtls/juicity/hysteria-v1 等）
// 降级为 blackhole：内核仍能正常启动，且该节点会明确表现为不可用，而不是让整个代理失效。
// 协议能力白名单集中在 xray.protocols（换内核只需改那一个文件）
xrayProtocols = ..xray.protocols.xrayNative;

// 确保出站协议被内核支持，否则降级为 blackhole（返回新表；无需改动时原样返回）
ensureSupportedOutbound = function(ob,tag){
	if(!ob) return ob;
	var blackhole = {
		protocol="blackhole";
		settings={};
		tag=tag;
	};
	if(!ob.protocol || !..table.find(xrayProtocols,ob.protocol)) return blackhole;

	// wireguard 需要合法的 32 字节 base64 密钥，密钥非法时内核会拒绝加载整份配置
	if(ob.protocol=="wireguard"){
		var st = ob.settings;
		var peer = (type(st)=="table" && type(st.peers)=="table") ? st.peers[1] : null;
		if( type(st)!="table" || !normalizeRealityKey(st.secretKey)
			|| type(peer)!="table" || !normalizeRealityKey(peer.publicKey) ){
			return blackhole;
		}
	}
	return ob;
};

// 取单值字符串（兼容数组形式，例如 host=["a","b"]）
firstString = function(v){
	if(..table.isArrayLike(v)) v = v[1];
	return (type(v)=="string" && #v) ? v : null;
};

// 合法传输名（精确匹配，避免脏数据被当成合法子串）
validNetworks = ["raw";"tcp";"ws";"websocket";"grpc";"xhttp";"httpupgrade";"mkcp";"kcp";"quic";"hysteria";"http";"h2"];

// 网络名是否合法
isValidNetwork = function(net){
	if(type(net)!="string") return false;
	net = ..string.lower(net);
	if(net=="http" || net=="h2" || net=="splithttp") return true;
	return ..table.find(validNetworks,net) ? true : false;
};

// 标准化网络类型：Xray 26 已移除 HTTP 传输，统一迁移为 XHTTP；非法值返回 null
normalizeNetwork = function(outbound){
	var net = outbound.network;
	if(type(net)!="string") return null;
	net = ..string.lower(net);
	if(net=="http" || net=="h2" || net=="splithttp") return "xhttp";
	if(!..table.find(validNetworks,net)) return null;
	return net;
};

// REALITY 公钥归一化：Xray 要求 base64 raw URL 编码（43 字符、无 padding）。
// 标准 base64（44 字符带 '='）会被 Xray 判为 invalid "password" 而拒绝加载整份配置。
normalizeRealityKey = function(v){
	if(type(v)!="string") return null;
	v = ..string.trim(v);
	if(!#v) return null;
	var der = ..crypt.decodeBin(v);
	if(der && #der==32) return ..crypt.encodeUrlBase64(der);
	return null;
};

// shortId 必须是偶数长度的 hex，否则 Xray 会拒绝加载整份配置
normalizeShortId = function(v){
	if(type(v)!="string") return null;
	v = ..string.trim(v);
	if(!#v) return null;
	if(!..string.match(v,"^[0-9a-fA-F]+$")) return null;
	if(#v % 2) return null;
	return v;
};

// 是否 REALITY 节点（公钥必须能解码为 32 字节，否则无法构成有效 REALITY 配置）
isReality = function(outbound){
	if(!firstString(outbound["public-key"])) return false;
	return normalizeRealityKey(firstString(outbound["public-key"])) ? true : false;
};

// 出站（客户端）realitySettings
buildRealitySettings = function(outbound){
	return {
		serverName = firstString(outbound.sni) : firstString(outbound.host);
		password = normalizeRealityKey(firstString(outbound["public-key"]) : firstString(outbound.password));
		shortId = normalizeShortId(firstString(outbound["short-id"]) : firstString(outbound.shortId));
		fingerprint = firstString(outbound["client-fingerprint"]) : (firstString(outbound.fingerprint) : "chrome");
		spiderX = firstString(outbound["spider-x"]) : firstString(outbound.spiderX);
		mldsa65Verify = normalizeRealityKey(firstString(outbound["mldsa65-verify"]));
	};
};

// xhttpSettings
buildXhttpSettings = function(outbound){
	var xo = outbound["xhttp-opts"];
	var isXo = (type(xo)=="table") ? true : false;
	return {
		path = outbound.path : (isXo ? xo.path : null);
		host = firstString(outbound.host) : (isXo ? firstString(xo.host) : null);
		mode = outbound.mode : (isXo ? xo.mode : null);
		authority = outbound.authority : (isXo ? xo.authority : null);
		extra = outbound.extra : (isXo ? xo.extra : null);
		headers = outbound.headers : (isXo ? xo.headers : null);
		xPaddingBytes = outbound["x-padding-bytes"] : (isXo ? xo["x-padding-bytes"] : null);
		noGRPCHeader = outbound["no-grpc-header"] : (isXo ? xo["no-grpc-header"] : null);
	};
};

// httpupgradeSettings
buildHttpUpgradeSettings = function(outbound){
	return {
		path = outbound.path;
		host = firstString(outbound.host);
		headers = outbound.headers;
	};
};

/* ------------------------------------------------------------
   以下协议当前内核（Xray）尚不支持，但按协议规范完整生成配置并保留。
   它们会被 ensureSupportedOutbound 降级为 blackhole，以保证程序正常运行
   （内核遇到不认识的协议名会拒绝加载整份配置）。
   将来内核支持后，只需把协议名加入 xray.protocols.xrayNative，
   这里生成的配置即可直接生效，无需改动其他代码。
   ------------------------------------------------------------ */
buildUnsupportedOutbound = function(outbound,tag){
	var p = outbound.protocol;
	var port = tonumber(outbound.port);
	var settings;

	if(p=="anytls"){
		settings = {
			address=outbound.address; port=port;
			password=outbound.password : outbound.id;
			idle_session_check_interval=outbound.idleSessionCheckInterval;
			idle_session_timeout=outbound.idleSessionTimeout;
			min_idle_session=tonumber(outbound.minIdleSession);
		};
	}
	elseif(p=="tuic"){
		settings = {
			address=outbound.address; port=port;
			uuid=outbound.uuid : outbound.id;
			password=outbound.password;
			congestion_control=outbound.congestionControl : outbound.congestion;
			udp_relay_mode=outbound.udpRelayMode;
			udp_over_stream=outbound.udpOverStream;
			zero_rtt_handshake=outbound.zeroRttHandshake;
			heartbeat=outbound.heartbeat;
			reduce_rtt=outbound.reduceRtt;
		};
	}
	elseif(p=="shadowtls"){
		settings = {
			address=outbound.address; port=port;
			version=tonumber(outbound.version) : 3;
			password=outbound.password : outbound.id;
			sni=outbound.sni;
		};
	}
	elseif(p=="snell"){
		var obfsMode = outbound.obfs;
		settings = {
			address=outbound.address; port=port;
			psk=outbound.psk : outbound.id;
			version=tonumber(outbound.version) : 4;
			obfs_opts=(type(obfsMode)=="string" && #obfsMode && obfsMode!="none") ? {
				mode=obfsMode;
				host=outbound.host;
			} : null;
		};
	}
	elseif(p=="mieru"){
		settings = {
			address=outbound.address; port=port;
			username=outbound.username;
			password=outbound.password : outbound.id;
			multiplexing=outbound.multiplexing;
		};
	}
	elseif(p=="juicity"){
		settings = {
			address=outbound.address; port=port;
			uuid=outbound.uuid : outbound.id;
			password=outbound.password;
			congestion_control=outbound.congestionControl : outbound.congestion;
		};
	}
	elseif(p=="ssr"){
		settings = {
			address=outbound.address; port=port;
			method=outbound.security;
			password=outbound.id;
			protocol=outbound.network;
			protocol_param=outbound.protoParam;
			obfs=outbound.obfs;
			obfs_param=outbound.obfsParam;
		};
	}
	elseif(p=="naive"){
		settings = {
			address=outbound.address; port=port;
			username=outbound.username;
			password=outbound.password : outbound.id;
		};
	}
	else {
		// 兜底：保留已知的通用字段
		settings = {
			address=outbound.address; port=port;
			id=outbound.id;
			password=outbound.password;
			username=outbound.username;
			sni=outbound.sni;
		};
	}

	var ob = {
		protocol=p;
		settings=settings;
		tag=tag;
	};

	// 保留传输层信息（若节点带 TLS / ws / grpc 等）
	if(outbound.tls || outbound.network){
		applyStreamSettings(ob,outbound);
	}
	return ob;
};

// 取第一个非 null 值（避免 `a : b` 的假值合并陷阱：a 为 false/0 时会被跳过）
firstValue = function(...){
	var args = [...];
	for(i=1;#args;1){
		if(args[i]!==null) return args[i];
	}
	return null;
};

// 三态布尔解析（兼容 true/false 字符串与数字）
toBool = function(v){
	if(v===null) return null;
	var t = type(v);
	if(t=="boolean") return v;
	if(t=="number") return v!=0;
	if(t=="string"){
		var s = ..string.lower(..string.trim(v));
		if(s=="true" || s=="1" || s=="yes") return true;
		if(s=="false" || s=="0" || s=="no") return false;
	}
	return null;
};

// sockopt（官方 schema：mark / tcpFastOpen / tcpMptcp / tcpNoDelay / domainStrategy / dialerProxy ...）
buildSockopt = function(outbound){
	var mark = firstValue(outbound["routing-mark"],outbound.mark);
	var so = {
		mark = (mark!==null) ? tonumber(mark) : null;
		tcpFastOpen = toBool(firstValue(outbound.tfo,outbound["tcp-fast-open"]));
		tcpNoDelay = toBool(firstValue(outbound["tcp-no-delay"],outbound.tcpNoDelay));
		tcpMptcp = toBool(firstValue(outbound.mptcp,outbound["tcp-mptcp"]));
		tcpCongestion = firstValue(outbound["tcp-congestion"],outbound.tcpCongestion);
		domainStrategy = firstValue(outbound.domainStrategy,outbound["domain-strategy"]);
		dialerProxy = firstValue(outbound["dialer-proxy"],outbound.dialerProxy);
		interface = firstValue(outbound["interface-name"],outbound.interface);
		tcpKeepAliveInterval = tonumber(firstValue(outbound["keep-alive-interval"],outbound.keepAliveInterval));
		acceptProxyProtocol = toBool(outbound["accept-proxy-protocol"]);
		v6only = toBool(outbound.v6only);
		windowClamp = tonumber(firstValue(outbound["window-clamp"],outbound.windowClamp));
		userLevel = tonumber(outbound.userLevel);
	};
	return so;
};

// sockopt 是否有任何有效字段
hasSockopt = function(so){
	return (so.mark!==null || so.tcpFastOpen!==null || so.tcpNoDelay!==null || so.tcpMptcp!==null
		|| so.tcpCongestion || so.domainStrategy || so.dialerProxy || so.interface
		|| so.tcpKeepAliveInterval || so.acceptProxyProtocol!==null || so.v6only!==null
		|| so.windowClamp || so.userLevel) ? true : false;
};

// 统一增强出站：传输迁移 / REALITY / uTLS 指纹 / 嵌套字段回退
// 注意：保持节点原始结构不变，仅在读取时兼容（ws-opts 等嵌套字段）
applyStreamSettings = function(ob,outbound){
	var ss = ob.streamSettings;
	if(type(ss)!="table"){ ss = {}; ob.streamSettings = ss; }

	var net = normalizeNetwork(outbound);
	var fp = firstString(outbound["client-fingerprint"]);
	if(!fp) fp = firstString(outbound.fingerprint);
	if(!fp) fp = firstString(outbound.fp);
	var host = firstString(outbound.host);

	// 1) 传输迁移与生成
	if(net == "xhttp"){
		ss.network = "xhttp";
		ss.httpSettings = null;
		ss.h2Settings = null;
		ss.xhttpSettings = buildXhttpSettings(outbound);
	}
	elseif(net == "httpupgrade"){
		ss.network = "httpupgrade";
		ss.httpupgradeSettings = buildHttpUpgradeSettings(outbound);
	}
	elseif(net == "ws"){
		ss.network = "ws";
		// ws-opts 嵌套字段回退（保持节点原始结构不变）
		var wo = outbound["ws-opts"];
		var ws = (type(ss.wsSettings)=="table") ? ss.wsSettings : {};
		if(type(wo)=="table"){
			if((!ws.path) && wo.path) ws.path = wo.path;
			if(type(wo.headers)=="table"){
				var hs = (type(ws.headers)=="table") ? ws.headers : {};
				for(k,v in wo.headers){ if(hs[k]===null) hs[k] = v; }
				ws.headers = hs;
			}
		}
		if((!ws.path) && outbound.path) ws.path = outbound.path;
		if(!ws.path) ws.path = "/";
		if((!ws.headers) && host) ws.headers = {Host=host};
		ss.wsSettings = ws;
	}
	elseif(net == "grpc"){
		ss.network = "grpc";
		var go = outbound["grpc-opts"];
		var gs = (type(ss.grpcSettings)=="table") ? ss.grpcSettings : {};
		if(!gs.serviceName) gs.serviceName = outbound.grpcSni : (type(go)=="table" ? go["grpc-service-name"] : null);
		if((!gs.authority) && host) gs.authority = host;
		if((!gs.user_agent) && type(go)=="table") gs.user_agent = go["grpc-user-agent"];
		ss.grpcSettings = gs;
	}

	// 2) REALITY（需有效公钥；数据残缺时降级为 TLS，避免整份配置加载失败）
	if(isReality(outbound)){
		ss.security = "reality";
		ss.realitySettings = buildRealitySettings(outbound);
		ss.tlsSettings = null;
		ss.xtlsSettings = null;
	}
	elseif(ss.security == "reality"){
		ss.security = "tls";
		if(type(ss.tlsSettings)!="table"){
			ss.tlsSettings = { serverName = firstString(outbound.sni) : (host : outbound.address) };
		}
		if(fp) ss.tlsSettings.fingerprint = fp;
	}
	// 3) uTLS 指纹（普通 TLS 连接）
	elseif(fp && type(ss.tlsSettings)=="table"){
		ss.tlsSettings.fingerprint = fp;
	}

	// 4) sockopt（tfo / mark / domainStrategy / mptcp ...）
	var so = buildSockopt(outbound);
	if(hasSockopt(so)) ss.sockopt = so;

	// 5) packetEncoding（xudp / packet）
	var pe = firstValue(outbound.packetEncoding,outbound["packet-encoding"]);
	if(pe) ss.packetEncoding = pe;

	// 6) mux 补充字段
	if(type(ob.mux)=="table"){
		var xudpConcurrency = tonumber(outbound.xudpConcurrency);
		if(xudpConcurrency!==null) ob.mux.xudpConcurrency = xudpConcurrency;
		if(outbound.xudpProxyUDP443) ob.mux.xudpProxyUDP443 = outbound.xudpProxyUDP443;
	}

	// 7) tlsSettings 补全（minVersion / maxVersion / cipherSuites / curvePreferences / alpn / fingerprint）
	var ts = ss.tlsSettings;
	if(type(ts)=="table"){
		if(!ts.minVersion) ts.minVersion = firstValue(outbound.minVersion,outbound["tls-min-version"]);
		if(!ts.maxVersion) ts.maxVersion = firstValue(outbound.maxVersion,outbound["tls-max-version"]);
		if(!ts.cipherSuites) ts.cipherSuites = firstValue(outbound.cipherSuites,outbound["cipher-suites"]);
		if(!ts.curvePreferences) ts.curvePreferences = firstValue(outbound.curvePreferences,outbound["curve-preferences"]);
		if(!ts.alpn) ts.alpn = outbound.alpn;
		if(ts.disableSessionResumption===null && outbound.disableSessionResumption!==null) ts.disableSessionResumption = toBool(outbound.disableSessionResumption);
		if(!ts.fingerprint && fp) ts.fingerprint = fp;
		// Xray 26 已移除 allowInsecure，禁止输出
		ts.allowInsecure = null;
	}
	if(ss.security=="reality" && type(ss.realitySettings)=="table" && !ss.realitySettings.fingerprint && fp){
		ss.realitySettings.fingerprint = fp;
	}

	// 8) wsSettings 补全
	if(type(ss.wsSettings)=="table"){
		var wo2 = outbound["ws-opts"];
		var isWo2 = (type(wo2)=="table") ? true : false;
		if(!ss.wsSettings.heartbeatPeriod && isWo2) ss.wsSettings.heartbeatPeriod = tonumber(wo2["heartbeat-period"]);
		if(!ss.wsSettings.earlyDataHeaderName && isWo2) ss.wsSettings.earlyDataHeaderName = wo2["early-data-header-name"];
		if(!ss.wsSettings.maxEarlyData && isWo2) ss.wsSettings.maxEarlyData = tonumber(wo2["max-early-data"]);
		if(ss.wsSettings.acceptProxyProtocol===null){
			var app = isWo2 ? (wo2["accept-proxy-protocol"]) : null;
			if(app===null) app = outbound["accept-proxy-protocol"];
			ss.wsSettings.acceptProxyProtocol = toBool(app);
		}
	}

	// 9) grpcSettings 补全
	if(type(ss.grpcSettings)=="table"){
		var go2 = outbound["grpc-opts"];
		var isGo2 = (type(go2)=="table") ? true : false;
		if(!ss.grpcSettings.idle_timeout && isGo2) ss.grpcSettings.idle_timeout = tonumber(go2["grpc-idle-timeout"]);
		if(!ss.grpcSettings.healthCheckTimeout && isGo2) ss.grpcSettings.healthCheckTimeout = tonumber(go2["grpc-health-check-timeout"]);
		if(ss.grpcSettings.permitWithoutStream===null && isGo2) ss.grpcSettings.permitWithoutStream = toBool(go2["grpc-permit-without-stream"]);
		if(ss.grpcSettings.multiMode===null && isGo2 && go2["grpc-mode"]=="multi") ss.grpcSettings.multiMode = true;
	}

	// 10) hysteriaSettings 补全
	if(type(ss.hysteriaSettings)=="table"){
		if(!ss.hysteriaSettings.udpIdleTimeout) ss.hysteriaSettings.udpIdleTimeout = tonumber(firstValue(outbound.udpIdleTimeout,outbound["udp-idle-timeout"]));
		if(!ss.hysteriaSettings.masquerade) ss.hysteriaSettings.masquerade = outbound.masquerade;
	}

	// 兜底：网络名非法（订阅源脏数据）时降级，避免 Xray 报 unknown transport protocol 使整份配置加载失败
	if(!isValidNetwork(ss.network)) ss.network = "tcp";

	return ob;
};

write  = function(jsonPath,outbound,sockPort,httpPort,searcherSocksPorts,searcherHttpPorts){
	/*
	以config.core.default为模板，并根据节点信息修改参数，生成最终代理节点配置
	*/
	if(!outbound){ return; }
	if(type(outbound.port)!=type.number){
		outbound.port = tonumber(outbound.port);
	}
	
	var currentCore = ..table.clone(..config.core.default);
	if(! ..table.isArrayLike(currentCore.outbounds) ){
		return null,"错误的出站代理服务器配置" 
	}
	
	var inboundsInCore = currentCore.inbounds;
	if(! ..table.isArrayLike(inboundsInCore) ){
		return null,"错误的入站代理服务器配置" 
	}
	
	var proxyOutboundInCore;
	for(k,ob in currentCore.outbounds){
		if(ob.tag == "proxy"){
			proxyOutboundInCore = ob;
		} 
	}
	
	if( type(proxyOutboundInCore) !="table"  ){
		return null,"未找到默认出站代理服务器配置节点" 
	}
	
	var socksInbounds,httpInbounds;
	for(k,ib in currentCore.inbounds){
		if(ib.tag == "proxy"){
			socksInbounds = ib;
			socksInbounds.port = sockPort; 
		} 
		elseif(ib.tag == "http_proxy"){
			httpInbounds = ib;
			httpInbounds.port = httpPort; 
		} 
	}
		
	if( type(socksInbounds) !="table"  ){
		return null,"未找到默认 SOCKS 入站代理服务器配置节点" 
	}
	
	if( type(httpInbounds) !="table"  ){
		return null,"未找到默认 HTTP 入站代理服务器配置节点" 
	}
	
	// 如果代理节点有tls属性，且没有sni属性
	if(#outbound.tls && !outbound.sni){
		var host = outbound.host;
		if(..table.isArrayLike(host)){ host = host[1] } 
		outbound.sni = host ? host : outbound.address
	}
	
	if(outbound.protocol=="vless"){ 
		if(!#outbound.tls && outbound.port==443) outbound.tls = "tls";
		if(!#outbound.tls) outbound.tls = "tls";
		
		var mux = (outbound.concurrency !== null) ? {
			concurrency=outbound.concurrency;
			enabled=outbound.concurrency ? ( outbound.concurrency > 0)
		} : {
			concurrency=8;
			enabled=true
		}; 
			
		var ob = {
			mux = outbound.tls != "xtls" ? mux : null;
			protocol="vless";
			
			settings={
				vnext={
					{
						address=outbound.address; 
						port=tonumber(outbound.port);
						users={
							{  
								id=outbound.id;
								flow=outbound.flow : (outbound.tls == "xtls" ? "xtls-rprx-direct" : null);
								encryption=( (!#outbound.security) || outbound.security=="auto") ? "none" : outbound.security;  
								level=outbound.level : 0;
							}
						}
					}
				};
			};
			streamSettings={
				network=outbound.network : "tcp";
				security=#outbound.tls ? outbound.tls : null;
				tlsSettings = (#outbound.tls && outbound.tls != "xtls") ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni : outbound.address;
					alpn = outbound.alpn;
					disableSessionResumption = outbound.disableSessionResumption;
				} : null;
				xtlsSettings = outbound.tls == "xtls" ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni : outbound.address;
					alpn = outbound.alpn;
					disableSessionResumption = outbound.disableSessionResumption;
				} : null;
			};
			tag="proxy"
		};
		
		if( outbound.network == "ws" ){
			ob.streamSettings.wsSettings = {
				path = outbound.path;
				headers = outbound.headers;
			}
			
			if( outbound.host ) {
				if(!ob.streamSettings.wsSettings.headers){
					ob.streamSettings.wsSettings.headers = {}
				}
				ob.streamSettings.wsSettings.headers.Host = outbound.host;
			}
		}
		elseif( (outbound.network == "http") || (outbound.network == "h2")  ){
			var host = outbound.host;
			if(type.isString(host)){host = {host}}; 
			
			ob.streamSettings.httpSettings = {
				path = outbound.path;
				host = host;
			}
		}
		elseif( outbound.network == "tcp" ){
			if( outbound.type == "http" ){
				ob.streamSettings.tcpSettings = {
					header = {
						request={
							headers=..table.assign({ 
								Connection={
									"keep-alive"
								};
								Host=outbound.host;
								Pragma="no-cache";
								["Accept-Encoding"]={
									"gzip, deflate"
								};
								["User-Agent"]={
									"Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/55.0.2883.75 Safari/537.36";
									"Mozilla/5.0 (iPhone; CPU iPhone OS 10_0_2 like Mac OS X) AppleWebKit/601.1 (KHTML, like Gecko) CriOS/53.0.2785.109 Mobile/14A456 Safari/601.1.46"
								}
							},outbound.headers);
							method = outbound.httpMethod : "GET";
							path = outbound.path;
							version="1.1"
						};
						type="http"; 
					} 
				} 
			}
		}
		elseif( outbound.network == "kcp" ){ 
			ob.streamSettings.kcpSettings = { 
				congestion = outbound.congestion;
				seed = outbound.seed;
				mtu = outbound.mtu;
				tti = outbound.tti;
				uplinkCapacity = outbound.uplinkCapacity;
				downlinkCapacity = outbound.downlinkCapacity;
				readBufferSize = outbound.readBufferSize;
				writeBufferSize = outbound.writeBufferSize;
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "quic" ){ 
			ob.streamSettings.kcpSettings = {
				key = outbound.key; 
				security = outbound.security ? outbound.security : "none";
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "grpc" ){
			ob.streamSettings.grpcSettings = {
				serviceName = outbound.grpcSni;
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	}
	elseif(outbound.protocol=="vmess"){
		if(!#outbound.security) outbound.security = "auto";
			
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=8;
				enabled=true
			}; 
			protocol="vmess";
			settings={
				vnext={
					{
						address=outbound.address;
						level=outbound.level : null;
						port=tonumber(outbound.port);
						users={
							{
								alterId=tonumber(outbound.alterId) : 0;
								email=outbound.email : "t@t.tt";
								id=outbound.id;
								security=outbound.security;
							}
						}
					}
				};
			};
			streamSettings={
				network=outbound.network : "tcp";
				security=#outbound.tls ? outbound.tls : null;
				// Xray 26.x 已移除 allowInsecure（2026-06-01 起为硬错误），改用证书指纹/名称校验
				tlsSettings = #outbound.tls ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni;
				} : null
			};
			tag="proxy"
		};
		
		if( outbound.network == "ws" ){
			ob.streamSettings.wsSettings = {
				path = outbound.path;
				headers = outbound.headers;
			}
			
			if( outbound.host ) {
				if(!ob.streamSettings.wsSettings.headers){
					ob.streamSettings.wsSettings.headers = {}
				}
				ob.streamSettings.wsSettings.headers.Host = outbound.host;
			}
		}
		elseif( (outbound.network == "http") || (outbound.network == "h2")  ){
			var host = outbound.host;
			if(type.isString(host)){host = {host}}; 
			
			ob.streamSettings.httpSettings = {
				path = outbound.path;
				host = host;
			}
		}
		elseif( outbound.network == "tcp" ){
			if( outbound.type == "http" ){
				ob.streamSettings.tcpSettings = {
					header = {
						request={
							headers=..table.assign({ 
								Connection={
									"keep-alive"
								};
								Host=outbound.host;
								Pragma="no-cache";
								["Accept-Encoding"]={
									"gzip, deflate"
								};
								["User-Agent"]={
									"Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/55.0.2883.75 Safari/537.36";
									"Mozilla/5.0 (iPhone; CPU iPhone OS 10_0_2 like Mac OS X) AppleWebKit/601.1 (KHTML, like Gecko) CriOS/53.0.2785.109 Mobile/14A456 Safari/601.1.46"
								}
							},outbound.headers);
							method=outbound.httpMethod : "GET";
							path = outbound.path;
							version="1.1"
						};
						type="http"; 
					} 
				} 
			}
		}
		elseif( outbound.network == "kcp" ){ 
			ob.streamSettings.kcpSettings = { 
				congestion = outbound.congestion;
				seed = outbound.seed;
				mtu = outbound.mtu;
				tti = outbound.tti;
				uplinkCapacity = outbound.uplinkCapacity;
				downlinkCapacity = outbound.downlinkCapacity;
				readBufferSize = outbound.readBufferSize;
				writeBufferSize = outbound.writeBufferSize;
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "quic" ){ 
			ob.streamSettings.kcpSettings = {
				key = outbound.key; 
				security = outbound.security ? outbound.security : "none";
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "grpc" ){
			ob.streamSettings.grpcSettings = {
				serviceName = outbound.grpcSni;
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	}
	elseif(outbound.protocol=="trojan" || outbound.protocol=="trojan-go"){
		outbound.tls = #outbound.tls ? outbound.tls : "tls";
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=-1;
				enabled=false
			}; 
			protocol="trojan";
			settings={
				servers={
					{
						address=outbound.address;
						email=outbound.email;
						password=outbound.id;
						port=outbound.port; 
						level=outbound.level : 0; 
						encryption=outbound.security;  
						flow=outbound.flow : (outbound.tls == "xtls" ? "xtls-rprx-direct" : null);
					}
				};
			};
			streamSettings={
				network = outbound.network : "tcp";
				security = #outbound.tls ? outbound.tls : "tls";  
				
				tlsSettings =  (outbound.tls === "tls") ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni;
				} : null
			};
			tag="proxy"
		};
		
		if( outbound.network == "ws" ){
			ob.streamSettings.wsSettings = {
				path = outbound.path;
				headers = outbound.headers;
			}
			
			if( outbound.host ) {
				if(!ob.streamSettings.wsSettings.headers){
					ob.streamSettings.wsSettings.headers = {}
				}
				ob.streamSettings.wsSettings.headers.Host = outbound.host;
			}
		}
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	elseif(outbound.protocol=="shadowsocks"){
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=-1;
				enabled=false
			}; 
			protocol="shadowsocks";
			settings={
				servers={
					{
						address=outbound.address;
						level=outbound.level : 0;
						method=outbound.security;
						ota=!!outbound.ota;
						password=outbound.id;
						port=outbound.port;
					}
				};
			};
			streamSettings={
				network = outbound.network : "tcp";
			};
			tag="proxy"
		};
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	elseif(outbound.protocol=="socks" || outbound.protocol=="socks5"){
		
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=-1;
				enabled=false
			}; 
			protocol="socks";
			settings={
				servers={
					{
						address=outbound.address;
						port=outbound.port;
					}
				};
			};
			streamSettings={
				network = outbound.network : "tcp";
			};
			tag="proxy"
		};
			
		if(outbound.username || #outbound.id){
			// Xray 26.x 要求 users 必须是数组（写成对象会报 cannot unmarshal object）
			// 认证信息优先取节点独立的 username/password 字段，其次兼容 "user:pass" 写法
			var user = outbound.username;
			var password = outbound.password : outbound.id;
			if(!user){
				var u,p = ..string.match(outbound.id,"([^\:]+)\:(.+)");
				if(u && p){ user,password = u,p; }
			}
			if(user){
				ob.settings.servers[1].users = {
					{
						user = user;
						password = password;
						level = outbound.level : 0;
					}
				};
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	elseif(outbound.protocol=="https" || outbound.protocol=="http"){
		
		var ob = { 
			protocol="http";
			settings={
				servers={
					{
						address=outbound.address;
						port=outbound.port;
					}
				};
			};
			streamSettings={
				security = outbound.protocol=="https"  ? "tls" : "none";  
				tlsSettings = (outbound.protocol=="https") ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
				} : null;
			};
			tag="proxy"
		};
			
		if(outbound.username || #outbound.id){
			// Xray 26.x 要求 users 必须是数组（写成对象会报 cannot unmarshal object）
			// 认证信息优先取节点独立的 username/password 字段，其次兼容 "user:pass" 写法
			var user = outbound.username;
			var password = outbound.password : outbound.id;
			if(!user){
				var u,p = ..string.match(outbound.id,"([^\:]+)\:(.+)");
				if(u && p){ user,password = u,p; }
			}
			if(user){
				ob.settings.servers[1].users = {
					{
						user = user;
						password = password;
					}
				};
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 

	elseif(outbound.protocol=="hysteria2" || outbound.protocol=="hysteria"){
		// Xray 26.x 原生支持 Hysteria2：协议名必须写 "hysteria"，且 version 必须为 2。
		// 协议层只放 address/port，认证等参数放在 streamSettings.hysteriaSettings（官方要求）。
		var ob = {
			protocol="hysteria";
			settings={
				version=2;
				address=outbound.address;
				port=tonumber(outbound.port);
			};
			streamSettings={
				network="hysteria";
				security="tls";
				tlsSettings={
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni : outbound.address;
				};
				hysteriaSettings={
					version=2;
					auth=outbound.id;
				};
			};
			tag="proxy"
		};

		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob);
	}

	elseif(outbound.protocol=="wireguard"){
		// Xray 26.x 原生支持 WireGuard 出站（官方 schema：secretKey/address/peers/mtu/reserved/domainStrategy）
		// 注意：wireguard 出站不支持 streamSettings，因此不调用 applyStreamSettings
		var secretKey = outbound["private-key"] : (outbound.secretKey : outbound.privateKey);
		var pubKey = outbound["public-key"] : outbound.publicKey;

		// 本地 tun 地址（Clash: ip / ipv6）；address 字段被项目统一用作服务器地址
		var localAddr = outbound["local-address"] : outbound.localAddress;
		var addresses;
		if(type(localAddr)=="table") addresses = localAddr;
		elseif(type(localAddr)=="string" && #localAddr) addresses = [localAddr];
		else{
			addresses = ..table.array();
			if(type(outbound.ip)=="string" && #outbound.ip) ..table.push(addresses,outbound.ip);
			if(type(outbound.ipv6)=="string" && #outbound.ipv6) ..table.push(addresses,outbound.ipv6);
			if(!#addresses) addresses = null;
		}

		var allowedIPs = outbound["allowed-ips"] : outbound.allowedIPs;
		if(type(allowedIPs)=="string") allowedIPs = [allowedIPs];

		var endpoint = outbound.endpoint;
		if(!endpoint && outbound.address) endpoint = tostring(outbound.address) ++ ":" ++ tostring(outbound.port);

		var ob = {
			protocol="wireguard";
			settings={
				secretKey=secretKey;
				address=addresses;
				// 多出口并发（后台搜索）时禁用系统虚拟网卡，避免路由表 10230+ 冲突
				noKernelTun=true;
				mtu=tonumber(outbound.mtu);
				reserved=(type(outbound.reserved)=="table") ? outbound.reserved : null;
				domainStrategy=outbound.domainStrategy;
				peers={
					{
						endpoint=endpoint;
						publicKey=pubKey;
						preSharedKey=outbound["pre-shared-key"] : outbound.preSharedKey;
						keepAlive=tonumber(outbound.keepAlive);
						allowedIPs=allowedIPs;
					}
				};
			};
			tag="proxy";
			streamSettings=null;
		};

		..table.assign(proxyOutboundInCore,ob);
	}

	// 当前内核尚不支持的协议：按协议规范完整生成（随后被 ensureSupportedOutbound 降级为 blackhole）
	elseif(!..table.find(xrayProtocols,outbound.protocol)){
		..table.assign(proxyOutboundInCore,buildUnsupportedOutbound(outbound,"proxy"));
	}
	// === 多出口服务器并行搜索：生成 N 个搜索器槽位（入站 + 路由规则） ===
	if(..table.isArrayLike(searcherSocksPorts) && ..table.isArrayLike(searcherHttpPorts) && #searcherSocksPorts && #searcherHttpPorts){
		var nSlots = (#searcherSocksPorts < #searcherHttpPorts) ? #searcherSocksPorts : #searcherHttpPorts;
		
		// 确保 routing.rules 存在
		if(!currentCore.routing) currentCore.routing = {};
		if(!..table.isArrayLike(currentCore.routing[["rules"]])) currentCore.routing[["rules"]] = ..table.array();
		
		// 1. 移除旧的单搜索器入站
		var cleanInbounds = ..table.array();
		for(k,ib in currentCore.inbounds){
			if(ib.tag == "proxySearcher" || ib.tag == "http_proxySearcher"){
				continue;
			}
			..table.push(cleanInbounds, ib);
		}
		currentCore.inbounds = cleanInbounds;
		
		// 2. 移除旧的搜索器路由规则
		var cleanRules = ..table.array();
		for(k,r in currentCore.routing[["rules"]]){
			var isSearcherRule = false;
			if(r.outboundTag == "proxySearcher"){
				isSearcherRule = true;
			}
			elseif(..table.isArrayLike(r.inboundTag)){
				for(m,t in r.inboundTag){
					if(t == "proxySearcher" || t == "http_proxySearcher"){
						isSearcherRule = true;
						break;
					}
				}
			}
			if(isSearcherRule) continue;
			..table.push(cleanRules, r);
		}
		currentCore.routing[["rules"]] = cleanRules;
		
		// 3. 生成 N 个搜索器入站 + N 条路由规则
		for(i=1;nSlots;1){
			..table.push(currentCore.inbounds, {
				listen = "0.0.0.0";
				port = searcherSocksPorts[i];
				protocol = "socks";
				tag = "proxySearcher_" + i;
				settings = {
					auth = "noauth";
					udp = true;
				};
				sniffing = {
					destOverride = {"http";"tls"};
					enabled = true;
				};
			});
			..table.push(currentCore.inbounds, {
				listen = "0.0.0.0";
				port = searcherHttpPorts[i];
				protocol = "http";
				tag = "http_proxySearcher_" + i;
				settings = {};
				sniffing = {
					destOverride = {"http";"tls"};
					enabled = true;
				};
			});
			// 插入到 rules 最前面：Xray 按顺序匹配路由规则，必须保证搜索器流量优先命中对应槽位出站，
			// 否则会被前面默认规则（如 domain→proxy）抢先导向默认出站。
			..table.insert(currentCore.routing[["rules"]], {
				inboundTag = {"proxySearcher_" + i; "http_proxySearcher_" + i};
				outboundTag = "proxySearcher_" + i;
				type = "field";
			}, 1);
		}
	}

	// Xray 26.x（新版本）已移除 legacy reverse 功能（迁移到 VLESS Reverse Proxy），
	// 旧配置模板与持久化配置中的 reverse 字段会导致内核启动失败，
	// 因此在这里统一删除，确保新老配置都能被新内核接受。
	currentCore.reverse = null;

	// 不支持的协议降级，避免 unknown config id 导致整份配置加载失败
	var fixedProxy = ensureSupportedOutbound(proxyOutboundInCore,proxyOutboundInCore.tag : "proxy");
	if(fixedProxy !== proxyOutboundInCore){
		..table.clear(proxyOutboundInCore);
		..table.assign(proxyOutboundInCore,fixedProxy);
	}

	..string.save(jsonPath,..web.json.stringify(currentCore) );
	return jsonPath;
}

writeSearcherOutboundConfig  = function(jsonPath,outbound,proxyTag){
	import console
	/*
	以config.core.default为模板，并根据节点信息修改参数，生成最终代理节点配置
	*/
	if(!outbound){ return; }
	if(type(outbound.port)!=type.number){
		outbound.port = tonumber(outbound.port);
	}
	
	var currentCore = ..table.clone(..config.core.outBoundDefault);
	if(! ..table.isArrayLike(currentCore.outbounds) ){
		return null,"错误的出站代理服务器配置" 
	}

	
	var proxyOutboundInCore;
	//console.dump(currentCore);
	var j=1;
	for(i=1;#currentCore.outbounds;1){		
		
		var ob = currentCore.outbounds[j];
		//console.log("输出j="+j+",outbounds数量为："+#currentCore.outbounds)
		//console.dump(currentCore.outbounds);
		//console.dump(ob);
		if(ob.tag == "proxy"){
			proxyOutboundInCore = ob;
			if(j == #currentCore.outbounds) break;
			j++
		} 
		else {			
			..table.remove(currentCore.outbounds,j);
			
		}
		
	}
		
	
	
	if( type(proxyOutboundInCore) !="table"  ){
		return null,"未找到默认出站代理服务器配置节点" 
	}
	
	var socksInbounds,httpInbounds;


	
	// 如果代理节点有tls属性，且没有sni属性
/*
	if(#outbound.tls && !outbound.sni){
*/
	if(outbound.tls && !outbound.sni){
		var host = outbound.host;
		if(..table.isArrayLike(host)){ host = host[1] } 
		outbound.sni = host ? host : outbound.address
	}
	
	if(outbound.protocol=="vless"){ 
		if(!#outbound.tls && outbound.port==443) outbound.tls = "tls";
		if(!#outbound.tls) outbound.tls = "tls";
		
		var mux = (outbound.concurrency !== null) ? {
			concurrency=outbound.concurrency;
			enabled=outbound.concurrency ? ( outbound.concurrency > 0)
		} : {
			concurrency=8;
			enabled=true
		}; 
			
		var ob = {
			mux = outbound.tls != "xtls" ? mux : null;
			protocol="vless";
			
			settings={
				vnext={
					{
						address=outbound.address; 
						port=tonumber(outbound.port);
						users={
							{  
								id=outbound.id;
								flow=outbound.flow : (outbound.tls == "xtls" ? "xtls-rprx-direct" : null);
								encryption=( (!#outbound.security) || outbound.security=="auto") ? "none" : outbound.security;  
								level=outbound.level : 0;
							}
						}
					}
				};
			};
			streamSettings={
				network=outbound.network : "tcp";
				security=#outbound.tls ? outbound.tls : null;
				tlsSettings = (#outbound.tls && outbound.tls != "xtls") ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni : outbound.address;
					alpn = outbound.alpn;
					disableSessionResumption = outbound.disableSessionResumption;
				} : null;
				xtlsSettings = outbound.tls == "xtls" ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni : outbound.address;
					alpn = outbound.alpn;
					disableSessionResumption = outbound.disableSessionResumption;
				} : null;
			};
			tag=proxyTag
		};
		
		if( outbound.network == "ws" ){
			ob.streamSettings.wsSettings = {
				path = outbound.path;
				headers = outbound.headers;
			}
			
			if( outbound.host ) {
				if(!ob.streamSettings.wsSettings.headers){
					ob.streamSettings.wsSettings.headers = {}
				}
				ob.streamSettings.wsSettings.headers.Host = outbound.host;
			}
		}
		elseif( (outbound.network == "http") || (outbound.network == "h2")  ){
			var host = outbound.host;
			if(type.isString(host)){host = {host}}; 
			
			ob.streamSettings.httpSettings = {
				path = outbound.path;
				host = host;
			}
		}
		elseif( outbound.network == "tcp" ){
			if( outbound.type == "http" ){
				ob.streamSettings.tcpSettings = {
					header = {
						request={
							headers=..table.assign({ 
								Connection={
									"keep-alive"
								};
								Host=outbound.host;
								Pragma="no-cache";
								["Accept-Encoding"]={
									"gzip, deflate"
								};
								["User-Agent"]={
									"Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/55.0.2883.75 Safari/537.36";
									"Mozilla/5.0 (iPhone; CPU iPhone OS 10_0_2 like Mac OS X) AppleWebKit/601.1 (KHTML, like Gecko) CriOS/53.0.2785.109 Mobile/14A456 Safari/601.1.46"
								}
							},outbound.headers);
							method = outbound.httpMethod : "GET";
							path = outbound.path;
							version="1.1"
						};
						type="http"; 
					} 
				} 
			}
		}
		elseif( outbound.network == "kcp" ){ 
			ob.streamSettings.kcpSettings = { 
				congestion = outbound.congestion;
				seed = outbound.seed;
				mtu = outbound.mtu;
				tti = outbound.tti;
				uplinkCapacity = outbound.uplinkCapacity;
				downlinkCapacity = outbound.downlinkCapacity;
				readBufferSize = outbound.readBufferSize;
				writeBufferSize = outbound.writeBufferSize;
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "quic" ){ 
			ob.streamSettings.kcpSettings = {
				key = outbound.key; 
				security = outbound.security ? outbound.security : "none";
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "grpc" ){
			ob.streamSettings.grpcSettings = {
				serviceName = outbound.grpcSni;
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	}
	elseif(outbound.protocol=="vmess"){
		if(!#outbound.security) outbound.security = "auto";
			
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=8;
				enabled=true
			}; 
			protocol="vmess";
			settings={
				vnext={
					{
						address=outbound.address;
						level=outbound.level : null;
						port=tonumber(outbound.port);
						users={
							{
								alterId=tonumber(outbound.alterId) : 0;
								email=outbound.email : "t@t.tt";
								id=outbound.id;
								security=outbound.security;
							}
						}
					}
				};
			};
			streamSettings={
				network=outbound.network : "tcp";
				/*
security=#outbound.tls ? outbound.tls : null;
*/
				security=outbound.tls ? outbound.tls : null;
				// Xray 26.x 已移除 allowInsecure（2026-06-01 起为硬错误），改用证书指纹/名称校验
/*
				tlsSettings = #outbound.tls ? {
*/
				tlsSettings = outbound.tls ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni;
				} : null
			};
			tag=proxyTag
		};
		
		if( outbound.network == "ws" ){
			ob.streamSettings.wsSettings = {
				path = outbound.path;
				headers = outbound.headers;
			}
			
			if( outbound.host ) {
				if(!ob.streamSettings.wsSettings.headers){
					ob.streamSettings.wsSettings.headers = {}
				}
				ob.streamSettings.wsSettings.headers.Host = outbound.host;
			}
		}
		elseif( (outbound.network == "http") || (outbound.network == "h2")  ){
			var host = outbound.host;
			if(type.isString(host)){host = {host}}; 
			
			ob.streamSettings.httpSettings = {
				path = outbound.path;
				host = host;
			}
		}
		elseif( outbound.network == "tcp" ){
			if( outbound.type == "http" ){
				ob.streamSettings.tcpSettings = {
					header = {
						request={
							headers=..table.assign({ 
								Connection={
									"keep-alive"
								};
								Host=outbound.host;
								Pragma="no-cache";
								["Accept-Encoding"]={
									"gzip, deflate"
								};
								["User-Agent"]={
									"Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/55.0.2883.75 Safari/537.36";
									"Mozilla/5.0 (iPhone; CPU iPhone OS 10_0_2 like Mac OS X) AppleWebKit/601.1 (KHTML, like Gecko) CriOS/53.0.2785.109 Mobile/14A456 Safari/601.1.46"
								}
							},outbound.headers);
							method=outbound.httpMethod : "GET";
							path = outbound.path;
							version="1.1"
						};
						type="http"; 
					} 
				} 
			}
		}
		elseif( outbound.network == "kcp" ){ 
			ob.streamSettings.kcpSettings = { 
				congestion = outbound.congestion;
				seed = outbound.seed;
				mtu = outbound.mtu;
				tti = outbound.tti;
				uplinkCapacity = outbound.uplinkCapacity;
				downlinkCapacity = outbound.downlinkCapacity;
				readBufferSize = outbound.readBufferSize;
				writeBufferSize = outbound.writeBufferSize;
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "quic" ){ 
			ob.streamSettings.kcpSettings = {
				key = outbound.key; 
				security = outbound.security ? outbound.security : "none";
				header = {
					type = outbound.type;
				}
			}
		}
		elseif( outbound.network == "grpc" ){
			ob.streamSettings.grpcSettings = {
				serviceName = outbound.grpcSni;
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	}
	elseif(outbound.protocol=="trojan" || outbound.protocol=="trojan-go"){
		outbound.tls = #outbound.tls ? outbound.tls : "tls";
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=-1;
				enabled=false
			}; 
			protocol="trojan";
			settings={
				servers={
					{
						address=outbound.address;
						email=outbound.email;
						password=outbound.id;
						port=outbound.port; 
						level=outbound.level : 0; 
						encryption=outbound.security;  
						flow=outbound.flow : (outbound.tls == "xtls" ? "xtls-rprx-direct" : null);
					}
				};
			};
			streamSettings={
				network = outbound.network : "tcp";
				security = #outbound.tls ? outbound.tls : "tls";  
				
				tlsSettings =  (outbound.tls === "tls") ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni;
				} : null
			};
			tag=proxyTag
		};
		
		if( outbound.network == "ws" ){
			ob.streamSettings.wsSettings = {
				path = outbound.path;
				headers = outbound.headers;
			}
			
			if( outbound.host ) {
				if(!ob.streamSettings.wsSettings.headers){
					ob.streamSettings.wsSettings.headers = {}
				}
				ob.streamSettings.wsSettings.headers.Host = outbound.host;
			}
		}
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	elseif(outbound.protocol=="shadowsocks"){
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=-1;
				enabled=false
			}; 
			protocol="shadowsocks";
			settings={
				servers={
					{
						address=outbound.address;
						level=outbound.level : 0;
						method=outbound.security;
						ota=!!outbound.ota;
						password=outbound.id;
						port=outbound.port;
					}
				};
			};
			streamSettings={
				network = outbound.network : "tcp";
			};
			tag=proxyTag
		};
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	elseif(outbound.protocol=="socks" || outbound.protocol=="socks5"){
		
		var ob = {
			mux = (outbound.concurrency !== null) ? {
				concurrency=outbound.concurrency;
				enabled=outbound.concurrency ? ( outbound.concurrency > 0)
			} : {
				concurrency=-1;
				enabled=false
			}; 
			protocol="socks";
			settings={
				servers={
					{
						address=outbound.address;
						port=outbound.port;
					}
				};
			};
			streamSettings={
				network = outbound.network : "tcp";
			};
			tag=proxyTag
		};
			
		if(outbound.username || #outbound.id){
			// Xray 26.x 要求 users 必须是数组（写成对象会报 cannot unmarshal object）
			// 认证信息优先取节点独立的 username/password 字段，其次兼容 "user:pass" 写法
			var user = outbound.username;
			var password = outbound.password : outbound.id;
			if(!user){
				var u,p = ..string.match(outbound.id,"([^\:]+)\:(.+)");
				if(u && p){ user,password = u,p; }
			}
			if(user){
				ob.settings.servers[1].users = {
					{
						user = user;
						password = password;
						level = outbound.level : 0;
					}
				};
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	elseif(outbound.protocol=="https" || outbound.protocol=="http"){
		
		var ob = { 
			protocol="http";
			settings={
				servers={
					{
						address=outbound.address;
						port=outbound.port;
					}
				};
			};
			streamSettings={
				security = outbound.protocol=="https"  ? "tls" : "none";  
				tlsSettings = (outbound.protocol=="https") ? {
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
				} : null;
			};
			tag=proxyTag
		};
			
		if(outbound.username || #outbound.id){
			// Xray 26.x 要求 users 必须是数组（写成对象会报 cannot unmarshal object）
			// 认证信息优先取节点独立的 username/password 字段，其次兼容 "user:pass" 写法
			var user = outbound.username;
			var password = outbound.password : outbound.id;
			if(!user){
				var u,p = ..string.match(outbound.id,"([^\:]+)\:(.+)");
				if(u && p){ user,password = u,p; }
			}
			if(user){
				ob.settings.servers[1].users = {
					{
						user = user;
						password = password;
					}
				};
			}
		}
		
		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob); 
	} 
	
	elseif(outbound.protocol=="hysteria2" || outbound.protocol=="hysteria"){
		// Xray 26.x 原生支持 Hysteria2：协议名必须写 "hysteria"，且 version 必须为 2。
		// 协议层只放 address/port，认证等参数放在 streamSettings.hysteriaSettings（官方要求）。
		var ob = {
			protocol="hysteria";
			settings={
				version=2;
				address=outbound.address;
				port=tonumber(outbound.port);
			};
			streamSettings={
				network="hysteria";
				security="tls";
				tlsSettings={
					pinnedPeerCertSha256 = outbound.pinnedPeerCertSha256; verifyPeerCertByName = outbound.verifyPeerCertByName;
					serverName = outbound.sni : outbound.address;
				};
				hysteriaSettings={
					version=2;
					auth=outbound.id;
				};
			};
			tag=proxyTag
		};

		applyStreamSettings(ob,outbound);
		..table.assign(proxyOutboundInCore,ob);
	}

	elseif(outbound.protocol=="wireguard"){
		// Xray 26.x 原生支持 WireGuard 出站（官方 schema：secretKey/address/peers/mtu/reserved/domainStrategy）
		// 注意：wireguard 出站不支持 streamSettings，因此不调用 applyStreamSettings
		var secretKey = outbound["private-key"] : (outbound.secretKey : outbound.privateKey);
		var pubKey = outbound["public-key"] : outbound.publicKey;

		// 本地 tun 地址（Clash: ip / ipv6）；address 字段被项目统一用作服务器地址
		var localAddr = outbound["local-address"] : outbound.localAddress;
		var addresses;
		if(type(localAddr)=="table") addresses = localAddr;
		elseif(type(localAddr)=="string" && #localAddr) addresses = [localAddr];
		else{
			addresses = ..table.array();
			if(type(outbound.ip)=="string" && #outbound.ip) ..table.push(addresses,outbound.ip);
			if(type(outbound.ipv6)=="string" && #outbound.ipv6) ..table.push(addresses,outbound.ipv6);
			if(!#addresses) addresses = null;
		}

		var allowedIPs = outbound["allowed-ips"] : outbound.allowedIPs;
		if(type(allowedIPs)=="string") allowedIPs = [allowedIPs];

		var endpoint = outbound.endpoint;
		if(!endpoint && outbound.address) endpoint = tostring(outbound.address) ++ ":" ++ tostring(outbound.port);

		var ob = {
			protocol="wireguard";
			settings={
				secretKey=secretKey;
				address=addresses;
				// 多出口并发（后台搜索）时禁用系统虚拟网卡，避免路由表 10230+ 冲突
				noKernelTun=true;
				mtu=tonumber(outbound.mtu);
				reserved=(type(outbound.reserved)=="table") ? outbound.reserved : null;
				domainStrategy=outbound.domainStrategy;
				peers={
					{
						endpoint=endpoint;
						publicKey=pubKey;
						preSharedKey=outbound["pre-shared-key"] : outbound.preSharedKey;
						keepAlive=tonumber(outbound.keepAlive);
						allowedIPs=allowedIPs;
					}
				};
			};
			tag=proxyTag;
			streamSettings=null;
		};

		..table.assign(proxyOutboundInCore,ob);
	}

	// 当前内核尚不支持的协议：按协议规范完整生成（随后被 ensureSupportedOutbound 降级为 blackhole）
	elseif(!..table.find(xrayProtocols,outbound.protocol)){
		..table.assign(proxyOutboundInCore,buildUnsupportedOutbound(outbound,proxyTag));
	}
	// 不支持的协议降级，避免 unknown config id 导致整份配置加载失败
	var fixedProxy = ensureSupportedOutbound(proxyOutboundInCore,proxyOutboundInCore.tag : proxyTag);
	if(fixedProxy !== proxyOutboundInCore){
		..table.clear(proxyOutboundInCore);
		..table.assign(proxyOutboundInCore,fixedProxy);
	}

	//jsonPath 为 null 时仅构建出站对象并返回（供 gRPC 直接下发，不写磁盘文件）
	if(jsonPath === null){
		return proxyOutboundInCore;
	}
	//console.dump(currentCore.outbounds);
	..string.save(jsonPath,..web.json.stringify(currentCore) );
	return jsonPath;
}

	