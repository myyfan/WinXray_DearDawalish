//xray.logPanel - 智能日志面板（批量刷新 + 底部跟随 + 查看历史不打扰 + 按行裁剪）
/*
win.ui.ctrl.edit / richedit 的 log 方法每次输出都执行：

	owner.text = string.concat(owner.text,...)   //全量重写文本

30000 字符的 SetWindowText 实测约 900 毫秒 → 每条日志卡约 1 秒。

本库在控件实例上覆盖 log 与 printf 方法（edit/richedit 的 print、dump，以及
process.popen.logResponse 最终都调用 owner.log，因此全部自动生效），实现：

1. 批量刷新
   日志先写入缓冲区，由定时器合并成一次 appendText 写入。
   实测 1000 条日志约 78 毫秒（原实现约 1000 毫秒/条）。

2. 底部跟随 / 查看历史不打扰（本库的核心）

   视图在底部时：按 flushInterval（默认 40 毫秒）合并写入，并 scrollBottom() 跟随最新日志。

   视图不在底部时（用户正在翻阅历史日志）：
   新日志只进缓冲区，改按 historyFlushInterval（默认 5000 毫秒）批量追加到末尾。
   追加之前用 EM_GETSCROLLPOS 记下滚动位置，追加之后用 EM_SETSCROLLPOS 精确还原。

   ★ 为什么「追加后还原同一个滚动位置」就能停在原地：
     追加只发生在文档末尾，已有内容的文档坐标完全不变，
     因此还原同一个滚动位置 = 还原到同一段内容（实测字符索引逐字节一致）。

   ★ 为什么不能「追加时完全不动控件、等用户回到底部再一次性倒出」：
     那样用户滚到底部的瞬间，之前积压的大量日志会一次性灌入并跳到最新，
     用户想接着往下看的那一行会被冲走，再也找不回来。
     按长间隔持续追加则每次只增加一小段，用户的视线位置由还原机制牢牢钉住。

   用户按住鼠标左键（拖滚动条 / 选择文本）时跳过本次追加，避免与用户操作打架。

   追加期间用 WM_SETREDRAW 关闭重绘，追加与还原之间不会出现「先跳到底再跳回来」的中间态闪烁。

3. 按行裁剪
   视图位于底部时正常裁剪（用 EM_LINEINDEX 精确定位行首，保留最近 maxLines 行）。
   查看历史期间不裁剪（裁剪会整体上移、破坏用户视线位置），
   仅当行数超过 FORCE_TRIM_LINES（50000 行）时才强制裁剪一次，
   此时先记录视图顶部字符索引，裁剪后用「字符索引 → 行号 → 相对滚动」把视线拉回原处。

注意：必须在任何日志输出之前调用 attach；控件建议使用 richedit（只读）。
*/
namespace xray.logPanel;

/*
接管日志控件。

@ctrl 日志控件（richedit 或 edit 均可）。
@maxLines 保留的最大行数，超出后裁剪头部，默认 3000 行。
@flushInterval 视图在底部时的批量刷新间隔（毫秒），默认 40。
@historyFlushInterval 查看历史期间的批量追加间隔（毫秒），默认 5000。

返回参数 @ctrl 以便链式调用；参数无效时返回 null。
*/
attach = function(ctrl,maxLines,flushInterval,historyFlushInterval){
	if( !ctrl || !ctrl.hwnd ) return null;

	//避免重复接管
	if( ctrl.logPanelAttached ) return ctrl;
	ctrl.logPanelAttached = true;

	maxLines = maxLines : 3000;
	flushInterval = flushInterval : 40;
	historyFlushInterval = historyFlushInterval : 5000;

	var WM_VSCROLL = 0x0115;
	var WM_SETREDRAW = 0x000B;
	var SB_VERT = 1;
	var SB_BOTTOM = 7;
	var EM_GETLINECOUNT = 0xBA;
	var EM_LINEINDEX = 0xBB;
	var EM_LINEFROMCHAR = 0xC9;
	var EM_GETFIRSTVISIBLELINE = 0xCE;
	var EM_POSFROMCHAR = 0xD6;
	var EM_GETSCROLLPOS = 0x4DD;
	var EM_SETSCROLLPOS = 0x4DE;
	var EM_SETSEL = 0xB1;
	var EM_EXGETSEL = 0x434;
	var VK_LBUTTON = 0x01;

	var CHECK_CHARS = 20000;        //每累积这么多字符检查一次行数（摊销 EM_GETLINECOUNT 成本）
	var MAX_BUFFER_CHARS = 200000;  //查看历史期间最多缓存的字符数
	var FORCE_TRIM_LINES = 50000;   //查看历史期间强制裁剪的行数上限

	var hwnd = ctrl.hwnd;
	var buffer = {};        //待输出缓冲
	var bufferChars = 0;    //缓冲区字符数
	var flushTimerId;       //刷新定时器
	var flushTimerIsHistory = false; //当前排定的定时器是否为「查看历史」的长间隔定时器
	var charSinceCheck = 0; //自上次行数检查后累积的字符数
	var lineHeightCache = 0;

	var isWindowAlive = function(){
		return ::User32.IsWindow(hwnd) != 0;
	};

	//量取一行文本的高度（作为「是否位于底部」的容差）
	//注意：必须在 `var hwnd` 之后定义（aardio 无变量提升、无前向引用）
	var getLineHeight = function(){
		if( lineHeightCache ) return lineHeightCache;

		var idx1 = ::User32.SendMessage(hwnd,EM_LINEINDEX,0,null);
		var idx2 = ::User32.SendMessage(hwnd,EM_LINEINDEX,1,null);
		if( idx2 > idx1 ){
			var p1 = {int x;int y};
			var p2 = {int x;int y};
			::User32.SendMessage(hwnd,EM_POSFROMCHAR,p1,idx1);
			::User32.SendMessage(hwnd,EM_POSFROMCHAR,p2,idx2);
			var h = p2.y - p1.y;
			if( h > 4 && h < 200 ){
				lineHeightCache = h;
				return h;
			}
		}
		return 16;
	};

	//是否位于底部（决定「跟随最新日志」还是「不打扰用户查看历史」）
	var isAtBottom = function(){
		var si = {uint cbSize=28;uint fMask=0x17;int nMin;int nMax;uint nPage;int nPos;int nTrackPos};
		::User32.GetScrollInfo(hwnd,SB_VERT,si);

		var maxY = si.nMax - si.nPage;
		if( maxY <= 0 ) return true;               //内容不足一屏（没有滚动条）
		if( si.nPos >= maxY ) return true;         //精确到底
		if( si.nPos < maxY - 64 ) return false;    //明显不在底部（不必量行高）
		return si.nPos >= maxY - getLineHeight();  //临界区：按一行高度判定

		//容差取「一行文本高度」的原因：用户把滚动条滑块拖到最底时，松手位置常差
		//几个像素到不了精确底部（拖拽是按像素比例映射的），容差过小就会被判成
		//「不在底部」而从此不再跟随。滚轮一格约滚 3 行，远大于一行高度，
		//所以不会把「用户在看历史」误判成底部。
	};

	var scrollBottom = function(){
		::User32.SendMessage(hwnd,WM_VSCROLL,SB_BOTTOM,null);
	};

	//取视图顶部的字符索引（用于裁剪后的位置锚定；失败返回 -1）
	//★ 不可用 `& 0xFFFF` 截断返回值：字符位置很容易超过 65535，
	//  截断后会得到一个错误但"看起来合法"的位置（实测 117850 被截成 52314）。
	var getTopCharIndex = function(){
		//★ 不能用 EM_CHARFROMPOS(0,0) 定位视口顶部：点 (0,0) 落在首行文字上方
		//  那一丝空隙里，返回的是【首行的上一行】的字符（实测 firstVisible=253
		//  时返回第 252 行的字符）。把插入点钉到那里，richedit 为了显示插入点
		//  会向上滚一行（实测 253 → 252）—— 这正是"点回日志窗口时视图回退一行"。
		var topLine = ::User32.SendMessage(hwnd,EM_GETFIRSTVISIBLELINE,null,null);
		if( topLine < 0 ) return -1;

		var idx = ::User32.SendMessage(hwnd,EM_LINEINDEX,topLine,null);
		if( idx < 0 || idx === 0xFFFFFFFF ) return -1;
		return idx;
	};

	/*
	把插入点（caretPos）钉在当前视口内，返回是否真的移动了插入点。

	★ 为什么必须这么做：
	  appendText 会把插入点留在文本末尾，而 richedit 在重新获得输入焦点时会
	  滚动到插入点（EnsureCaretVisible）。若插入点停在末尾，用户"把日志往上
	  翻 → 切到别的程序 → 切回来"时视图就会自己跳回底部（切走期间控件失焦，
	  插入点又被 appendText 留在末尾），用户正在看的那一段被冲走。
	  把插入点钉在视口内，重新获得焦点时就不会再触发滚动。

	★ 为什么 flush（跟随底部）也需要：
	  否则用户"在底部看日志 → 往上翻（此刻没有新日志，既不会走 flush 也不会
	  走 flushHistory）→ 切走 → 切回"时，插入点仍停在末尾，照样会跳到底部。

	仅在用户没有选区时移动插入点，避免破坏用户正在选择的内容。
	*/
	var pinCaretToViewport = function(){
		var cr = {int cpMin;int cpMax};
		::User32.SendMessage(hwnd,EM_EXGETSEL,0,cr);
		if( cr.cpMin !== cr.cpMax ) return false; //用户有选区，不动

		var topIdx = getTopCharIndex();
		if( topIdx < 0 ) return false;

		//★ 钉在「首行的下一行行首」而不是首行行首：首行常被像素级滚出一部分
		//  （实测首行首字符 y = -15，即它在客户区之外），插入点放在那里，
		//  richedit 为了显示插入点仍可能上滚一行。下一行必然是完整可见的。
		var topLine = ::User32.SendMessage(hwnd,EM_GETFIRSTVISIBLELINE,null,null);
		var anchorIdx = ::User32.SendMessage(hwnd,EM_LINEINDEX,topLine + 1,null);
		if( anchorIdx < 0 ) anchorIdx = topIdx; //最后一行已在视口内时回退

		var sp = {int x;int y};
		::User32.SendMessage(hwnd,EM_GETSCROLLPOS,0,sp);

		::User32.SendMessage(hwnd,EM_SETSEL,anchorIdx,anchorIdx);

		//★ 万一移动插入点仍然引起滚动（例如首行被像素级滚出了一部分），把滚动位置
		//  设回原值 —— 保证"钉插入点"这个动作本身绝不移动用户的视线。
		::User32.SendMessage(hwnd,EM_SETSCROLLPOS,0,sp);
		return true;
	};

	//重绘整个控件（含滚动条等非客户区），用于解除 WM_SETREDRAW 后立即刷新
	var redraw = function(){
		::User32.SendMessage(hwnd,WM_SETREDRAW,1,null);
		::User32.InvalidateRect(hwnd,null,1);
		::User32.UpdateWindow(hwnd);
	};

	/*
	按行裁剪：用 EM_LINEINDEX 精确定位行首，避免残留半行。

	参数 @keepPosition 为真时（查看历史期间），先记录视图顶部字符索引，
	裁剪后用「字符索引 → 行号 → EM_LINESCROLL 相对滚动」把视线拉回原处。
	*/
	var trim = function(keepPosition){
		charSinceCheck = 0;

		var total = ::User32.SendMessage(hwnd,EM_GETLINECOUNT,null,null);
		if( total <= maxLines ) return;

		var charPos = ::User32.SendMessage(hwnd,EM_LINEINDEX,total - maxLines,null);
		if( charPos <= 0 ) return;

		var topIdx = -1;
		if( keepPosition ) topIdx = getTopCharIndex();

		//裁剪用 setSel 会滚动到插入点，期间关重绘避免中间态闪烁
		::User32.SendMessage(hwnd,WM_SETREDRAW,0,null);

		ctrl.setSel(1,charPos);
		ctrl.selText = "";

		if( keepPosition && topIdx > charPos ){
			//被删除的内容全部位于视图上方，因此原来看的那个字符索引前移了 charPos
			var newIdx = topIdx - charPos;
			var newLine = ::User32.SendMessage(hwnd,EM_LINEFROMCHAR,newIdx,null);
			var curLine = ::User32.SendMessage(hwnd,EM_GETFIRSTVISIBLELINE,null,null);
			::User32.SendMessage(hwnd,EM_LINESCROLL,0,newLine - curLine);
		}

		redraw();
	};

	/*
	★ flush 与 scheduleFlush 互相引用，必须先用 var 前向声明。
	  aardio 无变量提升：若写成 `var flush = function(){ ... flush() ... }`，
	  函数体内部的 flush 会被解析为 self.flush（命名空间成员）→ null，
	  运行时报「不支持此操作:call 名字:'flush' 类型:null」。
	*/
	var flush,scheduleFlush,flushHistory;

	scheduleFlush = function(isHistory){
		if( flushTimerId ) return;
		flushTimerIsHistory = isHistory;
		flushTimerId = ctrl.setTimeout(
			function(){
				flushTimerId = null;
				var wasHistory = flushTimerIsHistory;
				flushTimerIsHistory = false;
				if( wasHistory ){
					flushHistory();
				}
				else{
					flush();
				}
			},isHistory ? historyFlushInterval : flushInterval
		);
	};

	//视图在底部：正常追加并跟随
	flush = function(){
		if( !#buffer ) return;

		if( !isWindowAlive() ){ //控件已销毁
			buffer = {};
			bufferChars = 0;
			return;
		}

		//★ 视图不在底部（用户正在查看历史日志）→ 转入长间隔批量追加模式
		if( !isAtBottom() ){
			//★ 顺手把插入点钉进视口：从「发现视图离开底部」到「长间隔到达」之间
			//  可能有好几秒，这段时间插入点还停在文本末尾；只要控件在这期间重新
			//  获得焦点（切走再切回、程序内聚焦），richedit 就会把视图甩到底部。
			pinCaretToViewport();
			scheduleFlush(true);
			return;
		}

		var s = ..string.join(buffer);
		buffer = {};
		bufferChars = 0;

		ctrl.appendText(s);
		scrollBottom();

		//容量管理：仅在底部时裁剪，避免打断查看历史日志
		charSinceCheck += #s;
		if( charSinceCheck > CHECK_CHARS ){
			trim(false);
			scrollBottom();
		}

		/*
		★ 这里刻意不调用 pinCaretToViewport()：
		  视图在底部时，插入点停在文本末尾才是正确状态 —— 聚焦时滚到末尾
		  仍然停在底部，不会造成任何视觉跳动。反而在这里移动插入点会把视图
		  从"精确底部"挪开，破坏"跟随最新日志"的观感。
		  "用户翻到中间后插入点还留在末尾"这类情况由 onFocusLost 与
		  flushHistory 负责处理。
		*/
	};

	//视图不在底部：批量追加到末尾，然后精确还原用户正在查看的位置
	flushHistory = function(){
		if( !#buffer ) return;

		if( !isWindowAlive() ){
			buffer = {};
			bufferChars = 0;
			return;
		}

		//用户已经回到底部 → 立即恢复实时跟随
		if( isAtBottom() ){
			flush();
			return;
		}

		//用户正按住鼠标左键（拖滚动条或选择文本）→ 本次跳过，稍后再来
		if( ::User32.GetAsyncKeyState(VK_LBUTTON) & 0x8000 ){
			scheduleFlush(true);
			return;
		}

		//追加前记录滚动位置
		var sp = {int x;int y};
		::User32.SendMessage(hwnd,EM_GETSCROLLPOS,0,sp);

		var s = ..string.join(buffer);
		buffer = {};
		bufferChars = 0;

		//★ 关重绘：追加会让 richedit 把视图甩到文本尾部（此时还原动作尚未执行），
		//  开着重绘就会看到「先跳到底、再跳回来」的闪烁。
		::User32.SendMessage(hwnd,WM_SETREDRAW,0,null);

		ctrl.appendText(s);

		//★ 追加只发生在文档末尾，前面内容的文档坐标不变，
		//  因此把滚动位置设回原值 = 停在用户原来正在看的那一段内容。
		var restored = ::User32.SendMessage(hwnd,EM_SETSCROLLPOS,0,sp);

		//★ 插入点钉在视口内（详见 pinCaretToViewport 注释，其内部已保证不移动视线）
		if( restored ) pinCaretToViewport();

		redraw();

		//还原失败时重试一次；绝不再 scrollBottom —— 那等于把正在查看历史的
		//用户强行甩到底部，比"位置略有偏差"糟糕得多。
		if( !restored ) ::User32.SendMessage(hwnd,EM_SETSCROLLPOS,0,sp);

		//容量管理：查看历史期间一般不裁剪（会破坏视线位置），仅在行数极端时兜底
		charSinceCheck += #s;
		if( charSinceCheck > CHECK_CHARS ){
			charSinceCheck = 0;
			var total = ::User32.SendMessage(hwnd,EM_GETLINECOUNT,null,null);
			if( total > FORCE_TRIM_LINES ) trim(true);
		}
	};

	//覆盖 log：所有日志输出的统一入口
	ctrl.log = function(...){
		var s = ..string.concat(...);
		..table.push(buffer,s);
		bufferChars += #s;

		//查看历史期间限制缓冲区大小（超出时丢弃最旧的部分）
		while( bufferChars > MAX_BUFFER_CHARS && #buffer > 1 ){
			bufferChars -= #buffer[1];
			..table.remove(buffer,1);
		}

		if( !flushTimerId ){
			//首条立即写入（底部时保证实时性；查看历史时会自动转入长间隔模式）
			flush();
			scheduleFlush(false);
		}
		elseif( flushTimerIsHistory ){
			//★ 正在等待长间隔：若用户此刻已把视图拉回底部，取消等待、立即恢复跟随
			if( isWindowAlive() && isAtBottom() ){
				//richedit 控件没有 clearTimeout，但 clearInterval 与 setTimeout 共用同一套定时器 id
				ctrl.clearInterval(flushTimerId);
				flushTimerId = null;
				flushTimerIsHistory = false;
				flush();
				scheduleFlush(false);
			}
		}
	};

	//printf 原本直接 appendText + vScroll（会跳到底部、绕过容量管理），统一走 log
	ctrl.printf = function(f,...){
		if(f) ctrl.log( ..string.format(f,...),'\r\n' );
	};

	/*
	★ 失焦瞬间把插入点钉在当前视口内。

	只在 flush/flushHistory 里钉插入点还不够：用户"把日志往上翻 → 切走"时，
	如果这段时间前后都没有新日志（既不走 flush 也不走 flushHistory），
	插入点会停在上次追加时的位置（可能与当前视口相差很远），切回来时
	richedit 滚动到该插入点，用户正在看的那一段照样被冲走。

	在失焦这一刻钉住插入点，可以完整覆盖这种情况：
	用户切到别的程序时控件必然失去焦点，此时把插入点对齐到当前视口，
	之后再回到程序（控件重新获得焦点）就不会滚动。
	*/
	ctrl.onFocusLost = function(){
		pinCaretToViewport();
	};

	return ctrl;
}
