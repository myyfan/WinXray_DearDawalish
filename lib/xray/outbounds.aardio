//outbounds 出站代理
import web.json;
import inet.url;
import win.clip;
import crypt;
import crypt.bin;
import console
import debug
import inet.http;
import string.regex;



namespace xray.outbounds;
// 分享链接里的用户名/密码解码。
// inet.url.split 不会自动解码 user，而导出端会 inet.url.encode，
// 因此导入端必须解码，否则密码含 + % @ : 等字符时往返即损坏。
// inet.url.decode 遇到非法转义（例如密码本身含裸 %）会返回 null，此时保留原值。
var decodeUser = function(v){
	if(type(v)!="string" || !v) return v;
	if(!..string.indexOf(v,"%")) return v;
	var d = ..inet.url.decode(v);
	return d ? d : v;
};
//分享链接
exportSharedLinks = function(outbounds){
	var outString = {};
	for i,outbound in ..table.eachIndex(outbounds){
		// 空字符串在 aardio 中是真值，会让 if(outbound.id) 判定通过，生成非法的 http://@host:port 形式链接；
		// 这里把空串按「无认证」处理（该值本身就是无效数据）。
		if(type(outbound.id)=="string" && !#outbound.id) outbound.id = null;
		// clash 源里 ws 的自定义 Host 可能以大写键残留在顶层，导出前归一化
		if(outbound.Host && !outbound.host) outbound.host = outbound.Host;
		if(outbound.protocol == "vmess"){
			var info = {
				v = 2;
				add = outbound.address;
				aid = outbound.alterId;
				id = outbound.id; 
				port = outbound.port;
				net = outbound.network;
				type = outbound.type;
				path = outbound.path;
				host = outbound.host;
				tls = outbound.tls;
				ps = outbound.ps;
				sni = outbound.sni;
				alpn = outbound.alpn;
				fp = outbound["client-fingerprint"];
				allowInsecure = outbound.allowInsecure;
			}
			if(outbound.security) info.scy = outbound.security;

			if(outbound.network=="quic"){
				info.host = outbound.quicSecutity;
				info.path = outbound.key;
			}
			elseif(outbound.network=="kcp"){
				info.path = outbound.seed;
			}
			elseif(outbound.network=="grpc"){
				info.path = outbound.grpcSni;
			}

			var json = ..web.json.stringify(info);
			var vmess = "vmess://" + ..crypt.encodeBin(json);
			..table.push(outString,vmess);
		}
		elseif(outbound.protocol == "shadowsocks"){
			if(outbound.plugin){
				var pluginInfo;
				if(outbound.pluginOptions){
					pluginInfo = ..inet.url.encode(outbound.plugin+";"+outbound.pluginOptions);
				}
				else {
					pluginInfo = ..inet.url.encode(outbound.plugin);
				}
				var ss = "ss://" + ..crypt.encodeBin( outbound.security + ":" + outbound.id ) + "@" + outbound.address + ":" + outbound.port + "/?plugin=" + pluginInfo + "#" + ..inet.url.encode(outbound.ps);
				..table.push(outString,ss);
			}
			else {
				var ss = "ss://" + ..crypt.encodeBin( outbound.security + ":" + outbound.id ) + "@" + outbound.address + ":" + outbound.port + "#" + ..inet.url.encode(outbound.ps);
				..table.push(outString,ss);
			}
		} 
		elseif(outbound.protocol == "socks"){
			var ss;
			if(outbound.id) ss = outbound.protocol + "://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else ss = outbound.protocol + "://" + outbound.address + ":" + outbound.port;
			..table.push(outString,ss);
		} 
		elseif(outbound.protocol == "ssr" ){
			var ssrUrl =  outbound.address + ":" + outbound.port 
				+ ":" + (outbound.network:"origin")+ ":" + (outbound.security:"")+ ":" + (outbound.obfs:"plain") 
				+ ":" + ..crypt.bin.encodeUrlBase64(outbound.id:"");

			var info = {};

			if(#outbound.ps)info.remarks = ..crypt.bin.encodeUrlBase64(outbound.ps);
			if(#outbound.obfsParam)info.obfsparam = ..crypt.bin.encodeUrlBase64(outbound.obfsParam);
			if(#outbound.networkParam)info.protoparam = ..crypt.bin.encodeUrlBase64(outbound.networkParam);

			if(#outbound.path)info.ot_path = ..crypt.bin.encodeUrlBase64(outbound.path);
			if(#outbound.sni)info.ot_domain = ..crypt.bin.encodeUrlBase64(outbound.sni);
			if(outbound.tls=="tls"){ info.ot_enable = "1"; }

			if(..table.count(info)){
				ssrUrl = ssrUrl +"/?"+ ..inet.url.stringifyParameters(info) 
			}

			..table.push(outString,outbound.protocol + "://" + ..crypt.encodeBin(ssrUrl) );
		}  
		elseif(outbound.protocol == "trojan"  || outbound.protocol == "trojan-go"){
			var trojan;
			if(outbound.id) trojan = outbound.protocol + "://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else trojan = outbound.protocol + "://" + outbound.address + ":" + outbound.port;

			var info = {};
			if(outbound.network!="tcp") info.type = outbound.network;
			if(outbound.sni){ info.sni = outbound.sni;}
			if(outbound.host) info.host = outbound.host;
			if(outbound.path) info.path = outbound.path;
			// trojan 必须带上传输安全信息，否则往返后 TLS 丢失、节点不可用
			if(outbound.tls) info.security = outbound.tls;
			if(outbound.allowInsecure) info.allowInsecure = outbound.allowInsecure;
			if(outbound.alpn) info.alpn = outbound.alpn;
			if(outbound["client-fingerprint"]) info.fp = outbound["client-fingerprint"];

			if(..table.count(info)){
				trojan = ..inet.url.appendExtraInfo(trojan,info) 
			}

			if(outbound.ps){
				trojan = trojan + "#" + ..inet.url.encode(outbound.ps);
			} 
			..table.push(outString,trojan);
		} 
		elseif(outbound.protocol == "vless"){
			var vless;
			if(outbound.id) vless = "vless://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else vless = "vless://" + outbound.address + ":" + outbound.port;

			var info = {};
			if(outbound.network && outbound.network!="tcp") info.type = outbound.network;
			// 注意：security 在部分订阅源里表示「传输安全」（tls/reality/xtls），
			// 不能直接当成 VLESS 的 encryption 导出，否则分享链接会带上非法 encryption，
			// 被别的客户端导入后同样会导致内核拒绝加载整份配置。
			// 用与生成配置一致的解析逻辑，导出即顺带修正脏数据（导出后再导入可自愈）。
			import xray.core.configJson;
			var vlessEnc = ..xray.core.configJson.resolveVlessEncryption(outbound);
			if(vlessEnc != "none") info.encryption = vlessEnc;
			if(outbound.tls) info.security = outbound.tls;
			if(outbound.flow) info.flow = outbound.flow;
			if(outbound.allowInsecure) info.allowInsecure = outbound.allowInsecure;
			if(outbound.alpn) info.alpn = outbound.alpn;
			if(outbound.disableSessionResumption) info.disableSessionResumption = outbound.disableSessionResumption;
			if(outbound.sni){ info.sni = outbound.sni;}
			if(outbound.host) info.host = outbound.host;
			if(outbound.path) info.path = outbound.path;
			if(outbound.seed) info.seed = outbound.seed;
			if(outbound.key) info.key = outbound.key;
			// headerType 是 tcp 传输的伪装类型（http/none），与上面的 type（传输名）不是一回事
			if(outbound.type) info.headerType = outbound.type;
			// REALITY / uTLS 指纹 / gRPC / XHTTP（缺这些会导致导出再导入时丢配置）
			if(outbound["public-key"]) info.pbk = outbound["public-key"];
			if(outbound["short-id"]) info.sid = outbound["short-id"];
			if(outbound["spider-x"]) info.spx = outbound["spider-x"];
			if(outbound["client-fingerprint"]) info.fp = outbound["client-fingerprint"];
			if(outbound.grpcSni) info.serviceName = outbound.grpcSni;
			if(outbound.mode) info.mode = outbound.mode;
			if(outbound.authority) info.authority = outbound.authority;
			if(outbound.packetEncoding) info.packetEncoding = outbound.packetEncoding;

			if(..table.count(info)){
				vless = ..inet.url.appendExtraInfo(vless,info) 
			}

			if(outbound.ps){
				vless = vless + "#" + ..inet.url.encode(outbound.ps);
			} 
			..table.push(outString,vless);
		} 
		elseif(outbound.protocol == "naive"){
			var urlInfo = {
				host = outbound.address;
				port = outbound.port;
				scheme = "naive+"+outbound.network;
				location = outbound.ps;
			}

			if(outbound.headers){
				urlInfo.extraInfo ={
					["extra-headers"] = outbound.headers
				}
			}

			if(outbound.id){
// 【模式匹配】从节点 id 拆出「用户名:密码」。([^\:]+)=不含冒号的用户名，\:=字面冒号，([^\:]+)=不含冒号的密码。用于 naive 导出
				var u,p = ..string.match(outbound.id,"([^\:]+)\:([^\:]+)")
				if(u && p){
					urlInfo.user = u;
					urlInfo.password = p;
				}
				else {
					urlInfo.user = outbound.id;
				} 
			} 

			..table.push(outString,..inet.url.stringify(urlInfo));
		} 
		elseif(outbound.protocol == "hysteria2"){
			var hy;
			if(outbound.id) hy = "hysteria2://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else hy = "hysteria2://" + outbound.address + ":" + outbound.port;

			var info = {};
			if(outbound.sni) info.sni = outbound.sni;
			if(outbound.obfs) info.obfs = outbound.obfs;
			if(outbound["obfs-password"]) info["obfs-password"] = outbound["obfs-password"];
			if(outbound.pinnedPeerCertSha256) info.pinSHA256 = outbound.pinnedPeerCertSha256;
			if(outbound.allowInsecure) info.insecure = 1;
			if(outbound["client-fingerprint"]) info.fp = outbound["client-fingerprint"];
			if(outbound.alpn) info.alpn = outbound.alpn;

			if(..table.count(info)){
				hy = ..inet.url.appendExtraInfo(hy,info)
			}

			if(outbound.ps){
				hy = hy + "#" + ..inet.url.encode(outbound.ps);
			}
			..table.push(outString,hy);
		}
		elseif((outbound.protocol == "https") || (outbound.protocol == "http")){
			var urlInfo = {
				host = outbound.address;
				port = outbound.port;
				scheme = outbound.protocol;//"proxy"
				location = outbound.ps;
			}

			// http(s) 代理节点常带 tls / sni / allowInsecure，必须一并导出，否则往返即丢
			var httpExtra = {};
			if(outbound.tls) httpExtra.tls = outbound.tls;
			if(outbound.sni) httpExtra.sni = outbound.sni;
			if(outbound.allowInsecure) httpExtra.allowInsecure = 1;
			if(outbound["client-fingerprint"]) httpExtra.fp = outbound["client-fingerprint"];
			if(..table.count(httpExtra)){ urlInfo.extraInfo = httpExtra; }

			if(outbound.id){
// 【模式匹配】同上：从 id 拆出「用户名:密码」，用于 http(s) 代理导出
				var u,p = ..string.match(outbound.id,"([^\:]+)\:([^\:]+)")
				if(u && p){
					urlInfo.user = u;
					urlInfo.password = p;
				}
				else {
					urlInfo.user = outbound.id;
				} 
			} 

			..table.push(outString,..inet.url.stringify(urlInfo));
		} 
	}	

	return ..string.join(outString,'\r\n');
}
//设置元表，弱引用键、值，弱引用不会增加引用计数、不会阻止垃圾回收器删除对象
var _subscriptionResponseCache = {
	@{_weak="kv"}
}

// ==========================================================================
// 从 sing-box 配置导入节点
//
// 参数 @cfg 可以是「已解析好的 sing-box 配置表」（顶层含 outbounds 数组），
//            也可以是单个出站对象表。
//
// 只导入真实节点；下面这些不是节点的类型会被跳过：
//   direct / block / dns / selector / urltest
//
// 字段对应关系（sing-box → 本项目）：
//   type → protocol    server → address    server_port → port    tag → ps
//   uuid/password/auth_str → id            method → security      alter_id → alterId
//   tls.enabled → tls=\"tls\"              tls.server_name → sni  tls.insecure → allowInsecure
//   tls.alpn → alpn                        tls.utls.fingerprint → client-fingerprint
//   tls.reality.* → tls=\"reality\" + public-key / short-id
//   transport.type → network               transport.path → path  transport.headers.Host → host
//   transport.service_name → grpcSni
//
// 返回：本项目的出站数组
// ==========================================================================
importFromSingbox = function(cfg){

	if(type(cfg)!=type.table) return ..table.array();

	// 顶层有 outbounds 数组就按配置处理，否则当成单个出站对象
	var list = cfg[["outbounds"]];
	if( !(..table.isArrayLike(list) && #list) ){
		list = ..table.array(cfg);
	}

	// sing-box 的协议名与本项目基本一致，只有 hysteria(v1) 需要改名
	var protocolMap = {
		["hysteria"] = "hysteria1";
	};

	// 这些不是节点，直接跳过
	var skipTypes = {
		["direct"] = true;
		["block"] = true;
		["dns"] = true;
		["selector"] = true;
		["urltest"] = true;
	};

	var outbounds = ..table.array();

	for(i=1;#list;1){
		var ob = list[i];
		if(type(ob)!=type.table) continue;

		var typ = ob.type;
		if(type(typ)!=type.string) continue;
		typ = ..string.lower(typ);
		if(!#typ || skipTypes[typ]) continue;

		var o = {
			protocol = protocolMap[typ] : typ;
			address = ob.server;
			port = ..tonumber(ob.server_port);
			network = "tcp";
		};
		if(ob.tag) o.ps = ob.tag;

		//---- 各协议的账号/密码 ----
		if(o.protocol=="vless" || o.protocol=="vmess"){
			if(ob.uuid) o.id = ob.uuid;
		}
		elseif(o.protocol=="trojan"){
			if(ob.password) o.id = ob.password;
		}
		elseif(o.protocol=="shadowsocks"){
			if(ob.method) o.security = ob.method;
			if(ob.password) o.id = ob.password;
		}
		elseif(o.protocol=="hysteria2" || o.protocol=="hysteria1" || o.protocol=="tuic"){
			if(ob.password) o.id = ob.password;
			if(ob.auth_str) o.id = ob.auth_str;
		}

		//---- 其它协议也尽量把账号取出来（取不到就留空，交给生成端降级处理）----
		if(!o.id){
			if(ob.password) o.id = ob.password;
			elseif(ob.uuid) o.id = ob.uuid;
			elseif(ob.auth_str) o.id = ob.auth_str;
		}

		//---- http / socks 代理用「用户名:密码」形式 ----
		if(o.protocol=="http" || o.protocol=="socks"){
			if(ob.username && ob.password) o.id = ob.username ++ ":" ++ ob.password;
			elseif(ob.username) o.id = ob.username;
			elseif(ob.password) o.id = ob.password;
		}

		//---- vmess 专有 ----
		if(o.protocol=="vmess"){
			if(ob.alter_id) o.alterId = ..tonumber(ob.alter_id);
			if(ob.security) o.security = ob.security;
		}

		//---- vless 专有 ----
		if(o.protocol=="vless"){
			if(ob.flow) o.flow = ob.flow;
		}

		//---- hysteria2 的 salamander 混淆 ----
		if(o.protocol=="hysteria2"){
			var obfs = ob[["obfs"]];
			if(type(obfs)==type.table){
				if(obfs.type) o.obfs = obfs.type;
				if(obfs.password) o["obfs-password"] = obfs.password;
			}
		}

		//---- wireguard ----
		if(o.protocol=="wireguard"){
			if(ob.private_key) o["private-key"] = ob.private_key;
			if(ob.peer_public_key) o["public-key"] = ob.peer_public_key;
			if(ob.pre_shared_key) o["pre-shared-key"] = ob.pre_shared_key;
			if(ob.local_address) o["local-address"] = ob.local_address;
			if(ob.reserved) o.reserved = ob.reserved;
			if(ob.mtu) o.mtu = ..tonumber(ob.mtu);
			if(ob.peers) o.peers = ob.peers;
		}

		//---- 其它通用字段 ----
		if(ob.packet_encoding) o.packetEncoding = ob.packet_encoding;

		//---- TLS / REALITY / uTLS 指纹 ----
		var tls = ob[["tls"]];
		if(type(tls)==type.table && tls.enabled){
			o.tls = "tls";
			if(tls.server_name) o.sni = tls.server_name;
			if(tls.insecure) o.allowInsecure = true;
			if(tls.alpn) o.alpn = tls.alpn;

			var utls = tls[["utls"]];
			if(type(utls)==type.table && utls.fingerprint) o["client-fingerprint"] = utls.fingerprint;

			var reality = tls[["reality"]];
			if(type(reality)==type.table && reality.enabled){
				o.tls = "reality";
				if(reality.public_key) o["public-key"] = reality.public_key;
				if(reality.short_id) o["short-id"] = reality.short_id;
			}
		}

		//---- 传输层 ----
		var tr = ob[["transport"]];
		if(type(tr)==type.table){
			if(tr.type) o.network = tr.type;
			if(tr.path) o.path = tr.path;
			if(tr.host) o.host = tr.host;
			if(tr.service_name) o.grpcSni = tr.service_name;
			var hd = tr[["headers"]];
			if(type(hd)==type.table){
				var host = hd[["Host"]] : hd[["host"]];
				if(host) o.host = host;
			}
		}

		// 交给统一的规范化/校验逻辑（同时会补全/过滤无效节点）
		validOutbound(o);
		if( o.address ) ..table.push(outbounds,o);
	}

	return outbounds;
}

//导入节点
importFromString = function(str,subscribeUrl,subps){
	import debug
	import debug.log
	import console
	//debug.debug();
//	debug.log.print("从"+str);
	var tempForDebugLog = str;
	
	if(!str){ return; }
	str = ..string.trim(str);//从字符串首尾清除所有空白字符

	// http(s) 代理链接（带认证或不带认证）都应作为节点导入，而不是被当成订阅源网址去请求。
	// 判定要求「必须带端口」，且端口之后只允许尾斜杠、?查询串或 #备注；
	// 这样既能识别 http://user:pass@host:port，也不会把 http://host:port/sub.txt 这类订阅源误判为节点。
	// 判定时先剥离 ? 与 # 之后的内容，再匹配主体。
	var httpProbe = str;
	var httpCut = ..string.indexOf(httpProbe,"?");
	if(httpCut) httpProbe = ..string.left(httpProbe,httpCut-1);
	httpCut = ..string.indexOf(httpProbe,"#");
	if(httpCut) httpProbe = ..string.left(httpProbe,httpCut-1);

	var httpProxyScheme,httpProxyUser,httpProxyHost,httpProxyPort;
// 【模式匹配】识别带认证的 http(s) 代理链接。\s*=开头可选空白；(https?)=捕获协议名；[^\s\@\/]+=用户名密码串（不含空白、@、/）；\@=字面 @；[^\s\@\/\:]+=主机名或 IP；\:(\d+)=冒号加端口号；\/?=可选尾斜杠；\s*$=结尾可选空白
	httpProxyScheme,httpProxyUser,httpProxyHost,httpProxyPort = ..string.match(httpProbe,`^\s*(https?)\:\/\/([^\s\@\/]+)\@([^\s\@\/\:]+)\:(\d+)\/?\s*$`);
	if(!httpProxyScheme){
// 【模式匹配】识别不带认证的 http(s) 代理链接（没有 用户名@ 段），其余规则同上
		httpProxyScheme,httpProxyHost,httpProxyPort = ..string.match(httpProbe,`^\s*(https?)\:\/\/([^\s\@\/\:]+)\:(\d+)\/?\s*$`);
		httpProxyUser = null;
	}
	if(httpProxyScheme){
		// 用原始字符串重建，保留 ?查询串 与 #备注
		// 内部 scheme 名称不能包含其它协议的子串（例如 httpproxy 会命中 proxy 分支）
// 【模式匹配】取 :// 之后的全部内容，即 [用户名@]主机:端口[?查询串][#备注]
		var httpProxyTail = ..string.match(str,`\:\/\/(.*)$`);
		str = "httppx://" ++ httpProxyScheme ++ "/" ++ httpProxyTail;
	}

//如果是网址的话
	//是网址就访问获取数据
	if( ..string.startWith(str,"http://") 
		|| ..string.startWith(str,"https://") 
		|| ..string.match(str,"^\s*/\N+\s*$")  ){ // 【模式匹配】续行条件：匹配以单斜杠开头的相对路径。^\s*=开头可选空白；/=字面斜杠；\N+=一个或多个非换行字符；\s*$=结尾可选空白。用于识别 github 相对路径形式的订阅源
		
	//	debug.log.print(str)
		
		import win.dlg.message;
		var msgDlg = win.dlg.message(..mainForm); 

		var title = '正在获取订阅源 ... ';
		var cfgSubscribeUrls = ..config.subscribe.subscribeUrls;
		for(i=#cfgSubscribeUrls;1;-1){
			var sub = cfgSubscribeUrls[i]  
			if( (sub.url === str) ){ 
				if(#sub.ps) title = '正在获取订阅源: ' + sub.ps;
				//..config.proxy.save(); 
			}
		} 

		var form = msgDlg.create(title,,true)
		form.progress.startProgress(50); 

		subscribeUrl = str;
		
		//debug.debug();
		//debug.log.print(str);
		
// 【模式匹配】同上：判断 subscribeUrl 是否为 /xxx 形式的相对路径
		if(..string.match(subscribeUrl,"^\s*/\N+\s*$") ){
// 【模式匹配】判断是否为 github 的 blob 或 raw 路径。\/ 中 <> 是 aardio 的非捕获分组，| 表示两边任选其一
			if(!..string.find(subscribeUrl,"/<blob>|<raw>")){
				subscribeUrl = ..inet.url.append("https://raw.githubusercontent.com",subscribeUrl);
			}
			else {
				subscribeUrl = ..inet.url.append("https://github.com",subscribeUrl);
			}
		}

		str = ..win.invoke(
			function(subscribeUrl){
				import inet.http; 
				import web.rest.github;
				import debug

				if( string.indexOf(subscribeUrl,"github.com")
					|| string.indexOf(subscribeUrl,"raw.githubusercontent.com") 
					){

					var ret  = web.rest.github.getContent(subscribeUrl)
					
					//debug.debug(); 
					
					if(ret) return ret; 
				}
				//var test = inet.http().get(subscribeUrl);
								 
				//debug.debug();
			
				return inet.http().get(subscribeUrl);
			},subscribeUrl 	)

		form.close();
		if(!str){
			return;
		}

/*
		//在订阅里面寻找是否存在当前网址的订阅
		var existIndex;
		var cfgSubscribeUrls = ..config.subscribe.subscribeUrls : ..table.array();
		for(i=#cfgSubscribeUrls;1;-1){
			var sub = cfgSubscribeUrls[i]  
			if(sub.url==subscribeUrl){ 
				sub.checked="启用";
				existIndex=i;
				break;
			}
		} 
*/
		
		//debug.debug();
		 
		 
		//如果是新链接，就添加到订阅
/*
		if(!existIndex){
			var tUrl = ..inet.url.split(subscribeUrl); 
			..table.push(cfgSubscribeUrls,{url=subscribeUrl;ps=tUrl ? tUrl.host : "";checked="启用"})
			..publish("uiCommand.subscriptionNew",cfgSubscribeUrls[#cfgSubscribeUrls]);
		}  
		else{
			..publish("uiCommand.subscriptionNew",cfgSubscribeUrls[existIndex],existIndex);
		}
		..config.subscribe.subscribeUrls = cfgSubscribeUrls;
		..config.subscribe.save();
*/
	}

	if(subscribeUrl){
		var crc32 = ..string.crc32(str);
		_subscriptionResponseCache[subscribeUrl] = crc32;
	}	
	
	//debug.debug() 
	
//Base64格式数据解码
// 【模式匹配】判断整串是否只由 base64 或 hex 字符与空白组成。^=串首；\w=字母数字下划线；=+/-_ 为额外允许字符；\s*$=结尾空白。用于识别 Base64 编码的订阅内容
	if(..string.match(str,"^\s*[\w=+/-_]+\s*$")){//所有的内容只包含 空白字符、字母和数字、以及下划线和=+/-_的话
				
		//debug.debug();
				
		str = ..crypt.decodeBin(str);//Base64或hex解码

		if(!str) return;
	}		
//从yaml格式导入proxy-providers订阅
// 【模式匹配】检测 YAML 中的 proxy-providers 段落。[\r\n]*=任意个回车换行；\s*=任意空白；\:=字面冒号
	if(..string.match(str,"[\r\n]*proxy-providers\s*\:")){
		
		//debug.debug();
		
		var urlmap = importFromClash(str,false);
		if(#urlmap){
			..mainForm.msgOk('发现了 '+#urlmap+' 个订阅\n正在导入中',1000);
			var outbounds = ..table.array();
			for(i=1;#urlmap;1){
				var impOutbounds = importFromString(urlmap[i]);
				if(impOutbounds){
					..table.append(outbounds,impOutbounds);
				}
			}
			return outbounds; 
		}
	}
	
	
//从yaml格式导入clash节点
// 【模式匹配】检测 YAML 中的 proxies 段落，规则同上
	if(..string.match(str,"[\r\n]*proxies\s*\:")){
				
		//debug.debug();
		
		var strTemp = importFromClash(str,true);
    	if(strTemp){
    		str = strTemp
    	}
    }
    
    
    //debug.debug()
    
//解析json格式
	//------------------------------------------------------------------
	// 整体 JSON 解析：只要首字符是 { 或 [ 就整体尝试解析一次
	// （web.json.tryParse 解析失败会返回 null，所以这样判定是安全的）
	//
	// 为什么不再用「含多个 {} 组就排除」的启发式判断：
	//   那种判断会把 sing-box 这类「天然含大量嵌套对象」的完整配置排除掉，
	//   导致它永远走不到下面的 JSON 分支。只看首字符既简单又不会漏。
	//------------------------------------------------------------------
	var jsonData;
	var jsonHead = ..string.trim(str);
	var jsonFirst = jsonHead[1];

	if( jsonFirst && (jsonFirst == 0x7B/*{*/ || jsonFirst == 0x5B/*[*/) ){
		//如果传参有subscribeUrl
		if(subscribeUrl){
			var crc32 = ..string.crc32(str);
			_subscriptionResponseCache[subscribeUrl] = crc32;
		}
		jsonData = ..web.json.tryParse(str);
	}
	
	
//检查传入参数是否是一个数组(表)
	if( ..table.isArray(jsonData) ){  //是一个数组的话就逐个解析
			
		//debug.debug();
		
		for(i=#jsonData;1;-1){
			if( !validOutbound(jsonData[i]) ) {//如果没有解析到节点信息就删除
				..table.remove(jsonData,i);
				continue;	// 已经删除，不能再访问 jsonData[i]（删的是最后一项时为 null，赋值会报错）
			} 

			if(subscribeUrl)jsonData[i].subscribeUrl = subscribeUrl;
				if(subps && type(subps)==type.string) jsonData[i].subps = subps;
				else jsonData[i].subps = "无订阅";
		}

		return jsonData;
	}
	elseif( type(jsonData) == type.table ){ //是表的话直接解析
			
		//debug.debug();
		
		//从 sing-box 配置导入（顶层含 outbounds 数组）
		if( ..table.isArrayLike(jsonData[["outbounds"]]) && #jsonData[["outbounds"]] ){
			var sbOutbounds = importFromSingbox(jsonData);
			if(#sbOutbounds){
				for(i=1;#sbOutbounds;1){
					if(subscribeUrl) sbOutbounds[i].subscribeUrl = subscribeUrl;
					if(subps && type(subps)==type.string) sbOutbounds[i].subps = subps;
					else sbOutbounds[i].subps = "无订阅";
				}
				return sbOutbounds;
			}
		}

		if( jsonData[["servers"]] ){//从ss-rust的配置文件添加节点

			var servers = jsonData[["servers"]];
			var outbounds = ..table.array();
			for i,v in ..table.eachIndex(servers){
				var outbound = ..table.assign(,v);
				if(outbound.protocol === null){
					outbound.protocol = (outbound.server_port&&outbound.password) ? "shadowsocks":"vless"
				}

				if(outbound.remarks){
					outbound.ps = outbound.remarks;
					outbound.remarks = null;
				}

				if(outbound.server){
					outbound.address = outbound.server;
					outbound.server = null;
				}

				if(outbound.server_port){
					outbound.port = outbound.server_port;
					outbound.server_port = null;
				}

				if(outbound.password){
					if(outbound.id){
						outbound.serverId = outbound.id;
					}
					outbound.id = outbound.password;
					outbound.password = null;
				}

				if(outbound.method){
					outbound.security = outbound.method;
					outbound.method = null;
				}

				if(subscribeUrl)outbound.subscribeUrl = subscribeUrl;
					if(subps && type(subps)==type.string) outbound.subps = subps;
					else outbound.subps = "无订阅";
				..table.push(outbounds,outbound);
			}

			return outbounds;
		}
		else {
			if( validOutbound(jsonData) ) {
				if(subscribeUrl)jsonData.subscribeUrl = subscribeUrl;
					if(subps && type(subps)==type.string) jsonData.subps = subps;
					else jsonData.subps = "无订阅";
				return {jsonData};
			}
		} 
	}



//从分享链接导入节点
	var outbounds = ..table.array();
	//按行拆分字符串并逐个解析
	
	//分析有效行是否成功解析
	//debug.debug()
/*
	var counttest = #outbounds	: 0
	var ddf = ..string.splitEx(str,);
	var fd = #ddf
	var i = 0;
	var j = 0; 
	debug.log.print(str)
*/
	
	for(line in ..string.lines(str) ){
		//console.dump(line)
				//debug.log.print()
		//debug.debug();
		
/*
		if(i==j ){ 
			if(counttest != #outbounds) debug.log.print("i=",i,ddf[i])
			else {
				counttest = #outbounds
			}
			
		}
		else {
			j= i;
		}		
		i++;
*/
		
		
		if(#outbounds>=10000){
			import win.dlg.message;
			var msgDlg = win.dlg.message(..mainForm); 
			var form = msgDlg.warn("导入的节点数目过多，已导入10000个节点并中止操作！")

			return outbounds;
		}

		if(line[1]=='/'# && line[2]=='/'#){//跳过注释行
			continue;
		}
		
		//j++;
		
		//Kitsunebi格式vmess链接(来自于v2rayN源码)
// 【模式匹配】匹配 Kitsunebi 格式的 vmess 链接。vmess\:\/\/=字面 vmess://；([\w=+/-_]+)?=可选的 base64 段；<\S*>=非捕获分组，匹配其后所有非空白字符
		var vmessKitsunebi,info = ..string.match(line,`vmess\:\/\/([\w=+/-_]+)?(\S*)`);
		if(vmessKitsunebi){
			var data = ..crypt.decodeBin(vmessKitsunebi);
// 【模式匹配】按 @ 把内容拆成两段（段1 含主机与端口，段2 含 id 与 aid）；'@' 为字面分隔符，不做模式匹配
			var data = ..string.split(data,'@');
			if(#data == 2){
// 【模式匹配】把段1 按冒号拆成 主机 与 端口
				var data1 = ..string.split(data[1],':');
// 【模式匹配】把段2 按冒号拆成 id 与 aid（额外 ID）
				var data2 = ..string.split(data[2],':');
				if(#data1 == 2 && #data2 == 2){
					var outbound={
						protocol = "vmess";
						address = data2[1];
						port = tonumber(data2[2]);
						security = data1[1];
						id = data1[2];
						network = "tcp";
					};
					if(info){
// 【模式匹配】把参数串按 & 拆成多段
						info = ..string.split(info,'&');
// 【模式匹配】从第一段提取 remarks= 之后的内容。\S*=一个或多个非空白字符
						remarks = ..string.match(info[1],"remarks=(\S*)");
						outbound.ps = ..inet.url.decode(remarks);
// 【模式匹配】从第二段提取 alterId= 之后的数字。\d*=零个或多个数字
						alterId = ..string.match(info[2],"alterId=(\d*)");
						outbound.alterId = tonumber(alterId);
					}

					outbound.type = "none";
					outbound.subscribeUrl = subscribeUrl;
					..table.push(outbounds,outbound);
					continue;
				}
			}
		}
// 【模式匹配】匹配标准 vmess 链接（uuid@主机:端口）。[^\@\s]+=不含 @ 与空白的 uuid；[^\?\#\s\:]+=不含 ? # 空白 冒号的主机；<\:\d+>* 中 <> 是非捕获分组，* 表示整个「冒号+数字」出现任意次（可有可无）；\S* 匹配剩余部分
		var vmess2 = ..string.match(line,`vmess\:\/\/[^\@\s]+\@[^\?\#\s\:]+<\:\d+>*\S*`);
		
		if( vmess2 ) {
			var vmessUrl = ..inet.url.split(vmess2) 
			if(vmessUrl && vmessUrl.user && vmessUrl.host && vmessUrl.port){
				var outbound = {
					address = vmessUrl.host;
					port = tonumber(vmessUrl.port) : 443; 
					id = vmessUrl.user;
					network = "tcp";
					protocol = "vmess";
					tls = "tls";
				};

				if(vmessUrl.extraInfo){
					var info = ..inet.url.splitParameters(vmessUrl.extraInfo);
					outbound.sni = info.sni;
					outbound.host = info.host;
					outbound.path = info.path;
					outbound.security = info.encryption;
					outbound.seed = info.seed; 
					outbound.key = info.key; 

					outbound.network = info.type;
					outbound.type = info.headertype; //kcp || quic

					if(info.security) outbound.tls = info.security;
					if(info.flow) outbound.flow = info.flow;
					var insecure = info.allowinsecure;
					if(insecure!==null) {
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="")
					}
					if(info.disablesessionresumption) outbound.disableSessionResumption = info.disablesessionresumption;
					if(info.alpn) outbound.alpn = info.alpn;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
				}

				if(vmessUrl.location){
					outbound.ps = ..inet.url.decode(vmessUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//v2rayN格式vmess链接
// 【模式匹配】匹配 v2rayN 格式的 vmess 链接（vmess:// 后为 base64 串）。[\w=+/-_]+=base64 字符集
		var vmess = ..string.match(line,`vmess\:\/\/([\w=+/-_]+)`);
		if( vmess ) { 
			var json = ..crypt.decodeBin(vmess);	
			var outbound = ..web.json.tryParse(json);	
			if(type(outbound)=="table"){
				..table.clear(outbound@._defined);
				outbound.protocol = "vmess";
				outbound.address = outbound.add;
			outbound.port = tonumber(outbound.port);
				outbound.alterId = tonumber(outbound.aid);
				// v2rayN 格式：scy 为加密方式，缺省 auto
				outbound.security = outbound.scy : "auto";
				outbound.network = outbound.net : "tcp";
				outbound.net = null;
				outbound.add = null;
				outbound.aid = null;
				outbound.v = null;
				outbound.subscribeUrl = subscribeUrl;

				if(outbound.ps){
// 【模式匹配】从备注中提取 user@host:port。(.+)=贪婪匹配用户名；\@=字面 @；(.+)=主机；\:(\d+)=冒号加端口号
					var u,h,p = ..string.match(outbound.ps,"(.+)\@(.+)\:(\d+)")
					if(u&&h&&p){
// 【模式匹配】判断是否为 justmysocks 订阅。justmysocks\d+\.net 中 \d+=一个以上数字，\.=字面点号
						if(h && ..string.endWith(h,"jamjams.net") && subscribeUrl && ..string.match(subscribeUrl,"justmysocks\d+\.net")){
// 【模式匹配】判断字符串是否为 IPv4 形式。^\d+=串首的数字段；\.=字面点号；$=串尾
							if(..string.match(outbound.address,"^\d+\.\d+\.\d+\.\d+$") ){
								outbound.address = h;
							}
						}
						outbound.ps = h;
					}	
				}
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//官方格式vless链接
// 【模式匹配】匹配 vless 链接。vless\:\/\/=字面 vless://；\S+=其后所有非空白字符
		var vless = ..string.match(line,`vless\:\/\/\S+`);
		if( vless ) {
			var vlessUrl = ..inet.url.split(vless) 
			if(vlessUrl && vlessUrl.user && vlessUrl.host && vlessUrl.port){
				var outbound = {
					address = vlessUrl.host;
					port = tonumber(vlessUrl.port) : 443; 
					id = decodeUser(vlessUrl.user);
					network = "tcp";
					protocol = "vless";
					tls = "tls";
				};

				if(vlessUrl.extraInfo){
					var info = ..inet.url.splitParameters(vlessUrl.extraInfo);
					outbound.sni = info.sni;
					outbound.host = info.host;
					outbound.path = info.path;
					outbound.security = info.encryption;
					outbound.seed = info.seed; 
					outbound.key = info.key; 

					outbound.network = info.type;
					outbound.type = info.headertype; //kcp || quic

					if(info.security) outbound.tls = info.security;
					if(info.flow) outbound.flow = info.flow;
					var insecure = info.allowinsecure;
					if(insecure!==null) {
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="")
					}
					if(info.disablesessionresumption) outbound.disableSessionResumption = info.disablesessionresumption;
					if(info.alpn) outbound.alpn = info.alpn;

					// —— VLESS 官方 URI 规范字段补全（REALITY / XHTTP / gRPC 等）——
					if(info.pbk) outbound["public-key"] = info.pbk;
					if(info.sid) outbound["short-id"] = info.sid;
					if(info.spx) outbound["spider-x"] = info.spx;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.servicename) outbound.grpcSni = info.servicename;
					if(info.mode) outbound.mode = info.mode;
					if(info.authority) outbound.authority = info.authority;
					if(info.packetencoding) outbound.packetEncoding = info.packetencoding;
				}

				if(vlessUrl.location){
					outbound.ps = ..inet.url.decode(vlessUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}

		//hysteria2 链接（兼容 hy2:// 简写）
// 【模式匹配】匹配 hysteria2 或 hy2 链接。\S+=全部非空白字符；: 是假值合并运算符，左边为 null 时取右边
		var hy = ..string.match(line,`hysteria2\:\/\/\S+`) : ..string.match(line,`hy2\:\/\/\S+`);
		if( hy ) {
			var hyUrl = ..inet.url.split(hy)
			if(hyUrl && hyUrl.host && hyUrl.port){
				var outbound = {
					address = hyUrl.host;
					port = tonumber(hyUrl.port) : 443;
					id = decodeUser(hyUrl.user);
					network = "hysteria";
					protocol = "hysteria2";
					tls = "tls";
				};

				if(hyUrl.extraInfo){
					var info = ..inet.url.splitParameters(hyUrl.extraInfo);
					outbound.sni = info.sni;
					outbound.obfs = info.obfs;
					if(info["obfs-password"]) outbound["obfs-password"] = info["obfs-password"];
					// 注意：inet.url.splitParameters 会把参数名转为小写
					var pin = info.pinsha256 : info.pinSHA256;
					if(pin) outbound.pinnedPeerCertSha256 = pin;
					var insecure = info.insecure : info.allowinsecure;
					if(insecure !== null) outbound.allowInsecure = (insecure !== "0" && insecure !== "false");
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.alpn) outbound.alpn = info.alpn;
				}

				if(hyUrl.location){
					outbound.ps = ..inet.url.decode(hyUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			}

			continue;
		}

		//ss链接
// 【模式匹配】匹配 ss 链接并分离备注。[^\s\#]+=不含空白与 # 的主体；<#\S+>? 中 <> 是非捕获分组，? 表示「#+非空白字符」这一段可有可无
		var ss,comment = ..string.match(line,`ss\:\/\/([^\s\#]+)(<#\S+>?)`);
		if( ss ) { 
// 【模式匹配】识别直接在链接中写明的 userinfo@主机:端口。^=串首；([^:]+)=不含冒号的 userinfo；(.+)=主机；\:(\d+)=端口
			var userinfo,address,port = ..string.match(ss,"^([^:]+)\@(.+)\:(\d+)")	
			if(!(userinfo&&address&&port)){
				var str = ..crypt.bin.decodeUrlBase64(ss); 
				if(str){ ss = str; } 

// 【模式匹配】识别未编码形式的 ss 内容 method:password@主机:端口。^(.+)\:=方法名直到最后一个冒号；(.+)\@=密码直到 @
				method,password,address,port = ..string.match(ss,"^(.+)\:(.+)\@(.+)\:(\d+)")
			}
			else {
				userinfo = ..crypt.bin.decodeUrlBase64(userinfo); 
				if(userinfo){
// 【模式匹配】把 userinfo 拆成 method 与 password。^(.+)\:=方法；(.+)$=其余全部作为密码
					method,password = ..string.match(userinfo,"^(.+)\:(.+)$")
				}	
			}

			if(address && password && port){
				var outbound = {
					address = address;
					port = tonumber(port);
					security = method;
					id = password;
					network = "tcp";
					protocol = "shadowsocks"
				};

				if(comment){
					comment = ..string.right(comment,-2);
					comment = ..inet.url.decode(comment);
// 【模式匹配】从备注中提取 user@host:port，规则同前
					var u,h,p = ..string.match(comment,"(.+)\@(.+)\:(\d+)")
					if(u&&h&&p){
// 【模式匹配】判断是否 justmysocks 订阅，规则同前
						if(h && ..string.endWith(h,"jamjams.net") && subscribeUrl && ..string.match(subscribeUrl,"justmysocks\d+\.net")){
// 【模式匹配】判断是否为 IPv4 格式，规则同前
							if(..string.match(outbound.address,"^\d+\.\d+\.\d+\.\d+$") ){
								outbound.address = h;
							}
						}

						comment = h;
					}

					outbound.ps = comment;
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//trojan链接
// 【模式匹配】匹配 trojan 链接。trojan\:\/\/=字面 trojan://；\S+=其后所有非空白字符
		var trojan = ..string.match(line,`trojan\:\/\/\S+`);
		if( trojan ) {
			var trojanUrl = ..inet.url.split(trojan) 
			if(trojanUrl && trojanUrl.user && trojanUrl.host){
				var outbound = {
					address = trojanUrl.host;
					port = tonumber(trojanUrl.port) : 443; 
					id = decodeUser(trojanUrl.user);
					network = "tcp";
					protocol = "trojan"
				};

				if(trojanUrl.extraInfo){
					var info = ..inet.url.splitParameters(trojanUrl.extraInfo);
					outbound.sni = info.sni || info.peer;

					outbound.host = info.host;
					outbound.path = info.path;

					if(info.type && info.type!=="original"){
						outbound.network = info.type;
						if(outbound.network=="h2"){
							outbound.network="http"
						}
					}

					// trojan 链接的 security 表示传输安全（tls/reality/xtls），encryption 才是加密方式。
					// 原写法在同时带 encryption 参数时会丢掉 TLS，导致往返后节点不可用。
					var tSec = info.security;
					if(tSec=="tls" || tSec=="reality" || tSec=="xtls") outbound.tls = tSec;
					if(info.encryption) outbound.security = info.encryption;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.alpn) outbound.alpn = info.alpn;
					var insecure = info.allowinsecure;
					if(insecure!==null) outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="");
				}

				if(trojanUrl.location){
					outbound.ps = ..inet.url.decode(trojanUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//trojan-go链接
// 【模式匹配】匹配 trojan-go 链接，规则同上
		var trojan = ..string.match(line,`trojan-go\:\/\/\S+`);
		if( trojan ) {
			var trojanUrl = ..inet.url.split(trojan) 
			if(trojanUrl && trojanUrl.user && trojanUrl.host){
				var outbound = {
					address = trojanUrl.host;
					port = tonumber(trojanUrl.port) : 443; 
					id = decodeUser(trojanUrl.user);
					network = "tcp";
					protocol = "trojan-go"
				};

				if(trojanUrl.extraInfo){
					var info = ..inet.url.splitParameters(trojanUrl.extraInfo);
					outbound.sni = info.sni || info.peer;
					outbound.host = info.host;
					outbound.path = info.path; 
					var insecure = info.allowinsecure;
					if(insecure!==null) {
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="") 
					}

					if(info.type && info.type!=="original"){
						outbound.network = info.type;
						if(outbound.network=="h2"){
							outbound.network="http"
						}
					}

					outbound.security = info.encryption; 
				}

				if(trojanUrl.location){
					outbound.ps = ..inet.url.decode(trojanUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//ssr链接
// 【模式匹配】匹配 ssr 链接（ssr:// 后为 base64）。[\w=+/-_]+=base64 允许的字符集
		var ssrBase64 = ..string.match(line,`ssr\:\/\/([\w=+/-_]+)`);
		if( ssrBase64 ) { 
			var ssrUrl = ..crypt.bin.decodeUrlBase64(ssrBase64);	
			if(ssrUrl){
// 【模式匹配】把 ssr 内容拆成主体与查询参数。(.+)\/\?=主体直到最后一个 斜杠+问号；(.+)=问号后的全部参数
				var ssrInfo,ssrParam = ..string.match(ssrUrl,"(.+)\/\?(.+)")
// 【模式匹配】把 ssr 主体按冒号拆成 6 个字段（冒号是字面分隔符，此处不做模式匹配）。依次为 地址、端口、协议、加密、混淆、密码
				var info = ..string.split(ssrInfo:ssrUrl,':');
				var outbound = {
					address = info[1];
					port = info[2];
					network = info[3];
					security = info[4];
					obfs = info[5]; 
					protocol = "ssr"; 
				}

				outbound.id = ..crypt.bin.decodeUrlBase64(info[6]:"");
				if(ssrParam){
					var params = ..inet.url.splitParameters(ssrParam);
					if(params){
						outbound.ps = ..crypt.bin.decodeUrlBase64(params.remarks);
						outbound.obfsParam = ..crypt.bin.decodeUrlBase64(params.obfsparam);
						outbound.networkParam = ..crypt.bin.decodeUrlBase64(params.protoparam);

						if(params.group){ 
							//outbound.subscribeGroup = ..crypt.bin.decodeUrlBase64(params.group);
						}

						if(params.ot_enable && (params.ot_enable!="0")){ outbound.tls = "tls"; } 
						outbound.path = ..crypt.bin.decodeUrlBase64(params.ot_path);
						outbound.sni = ..crypt.bin.decodeUrlBase64(params.ot_domain);
					}
				}

				outbound.subscribeUrl = subscribeUrl;

				if(outbound.address && outbound.port){
					..table.push(outbounds,outbound);
					continue;
				}
			}
		}
		//socks链接
// 【模式匹配】匹配 socks5 或 socks 链接。socks5?=socks 后可选的 5；\:=字面冒号；(\/\/\S+)=双斜杠及其后所有非空白字符
		var socks = ..string.match(line,`socks5?\:(\/\/\S+)`); 
		if( socks ) { 
			var socksUrl = ..inet.url.split("socks5:"+socks) 
			if( socksUrl && socksUrl.host && socksUrl.port){ 
				var outbound = {
					address = socksUrl.host;
					port = tonumber(socksUrl.port);
					network = "tcp";
					protocol = "socks"
				};

				if(socksUrl.user && socksUrl.password){
					outbound.id = decodeUser(socksUrl.user) ++ ":" ++ decodeUser(socksUrl.password)
				}  

				if(socksUrl.location){
					outbound.ps = ..inet.url.decode(socksUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//http或https链接
// 【模式匹配】匹配 proxy:// 链接（Clash 中 http(s) 代理的写法）。\S+=全部非空白字符
		var proxy = ..string.match(line,`proxy\:\/\/\S+`); 
		if( proxy ) { 
			var proxyUrl = ..inet.url.split(proxy) 
			if( proxyUrl && proxyUrl.host && proxyUrl.port){ 
				var outbound = {
					address = proxyUrl.host;
					port = tonumber(proxyUrl.port);
					network = "tcp";
					protocol = "https"
				};

				if(proxyUrl.user && proxyUrl.password){
					outbound.id = proxyUrl.user +":"+ proxyUrl.password
				} 

				if(proxyUrl.extraInfo){
					var info = ..inet.url.splitParameters(proxyUrl.extraInfo);
					if(info.tls==="none") {
						outbound.protocol = "http";
					}

					// 注意：splitParameters 会把参数名全部转为小写
					var insecure = info.allowinsecure;
					if(insecure!==null){
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="")
					}
				}

				if(proxyUrl.location){
					outbound.ps = ..inet.url.decode(proxyUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//http(s) 代理链接（带认证；已在入口转换为 httpproxy:// 内部 scheme，避免与订阅源冲突）
		// http(s) 代理链接（入口已统一转换为 httppx:// 内部 scheme，避免与订阅源冲突）
		// 先按「带认证」解析，失败再按「无认证」解析
// 【模式匹配】解析 httppx 内部的带认证形式。^httppx\:\/\/=字面前缀；(https?)=捕获协议名；([^\@\/]+)=不含 @ 与斜杠的认证串；\@=字面 @；([^\@\:]+)=不含 @ 与冒号的主机；\:(\d+)=冒号加端口
		var hpScheme,hpUserInfo,hpHost,hpPort = ..string.match(line,`^httppx\:\/\/(https?)\/([^\@\/]+)\@([^\@\:]+)\:(\d+)`);
		if(!hpHost){
// 【模式匹配】解析 httppx 内部的无认证形式（缺少 认证@ 段），其余规则同上
			hpScheme,hpHost,hpPort = ..string.match(line,`^httppx\:\/\/(https?)\/([^\@\:]+)\:(\d+)`);
			hpUserInfo = null;
		}
		if( hpHost ) {
			var outbound = {
				address = hpHost;
				port = tonumber(hpPort);
				network = "tcp";
				protocol = (..string.lower(hpScheme)=="https") ? "https" : "http";
			};
			if(hpUserInfo){
// 【模式匹配】把认证串拆成用户名与密码。^([^\:]+)=串首不含冒号的用户名；\:=字面冒号；(.+)$=其余全部作为密码
				var u,p = ..string.match(hpUserInfo,"^([^\:]+)\:(.+)$");
				if(u && p){ outbound.id = decodeUser(u) ++ ":" ++ decodeUser(p); }
				else { outbound.id = decodeUser(hpUserInfo); }
			}
// 【模式匹配】提取 # 之后的备注内容。(.*)$=直到行尾的任意字符（含空串）
			var hpTag = ..string.match(line,`#(.*)$`);
			if(hpTag) outbound.ps = ..inet.url.decode(hpTag);
			// 传输安全 / SNI / 允许不安全证书等附加参数
			var hpMain = line;
			var hpHash = ..string.indexOf(hpMain,"#");
			if(hpHash) hpMain = ..string.left(hpMain,hpHash-1);
// 【模式匹配】提取 ? 之后的查询串。\?=字面问号（模式里 ? 需转义才表示其本身）；(.*)$=直到行尾
			var hpQuery = ..string.match(hpMain,`\?(.*)$`);
			if(hpQuery){
				var hq = ..inet.url.splitParameters(hpQuery);
				if(hq.tls) outbound.tls = hq.tls;
				if(hq.sni) outbound.sni = hq.sni;
				if(hq.fp) outbound["client-fingerprint"] = hq.fp;
				if(hq.allowinsecure!==null) outbound.allowInsecure = (hq.allowinsecure!="0" && hq.allowinsecure!="false");
			}
			outbound.subscribeUrl = subscribeUrl;
			..table.push(outbounds,outbound);
			continue;
		}

		//naive链接
// 【模式匹配】匹配 naive 链接。(naive\+(\w+)\:\/\/\S+) 分成三部分：naive\+=字面前缀；\w+=协议名（如 http/https）；\S+=其余非空白字符
		var naive,naiveNetwork = ..string.match(line,`(naive\+(\w+)\:\/\/\S+)`);
		if( naive ) {
			var naiveUrl = ..inet.url.split(naive) 
			if( naiveUrl && naiveUrl.host ){
				var outbound = {
					address = naiveUrl.host;
					port = tonumber(naiveUrl.port) : 443; 
					id = decodeUser(naiveUrl.user);
					network = naiveNetwork;
					protocol = "naive"
				};

				if(naiveUrl.user && naiveUrl.password){
					outbound.id = naiveUrl.user +":"+ naiveUrl.password
				} 

				if(naiveUrl.extraInfo){
					var info = ..inet.url.splitParameters(naiveUrl.extraInfo);
					if(info["extra-headers"]){
						outbound.headers = info["extra-headers"];
					}
				} 
				if(naiveUrl.location){
					outbound.ps = ..inet.url.decode(naiveUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//WireGuard 链接（Xray 26.x 原生支持该出站协议）
		//格式：wireguard://私钥@服务器:端口?publicKey=..&address=..&reserved=1,2,3&mtu=1280#备注
// 【模式匹配】匹配带查询串的 wireguard 链接。(\S+?)\?=惰性匹配到第一个问号之前；\?=字面问号；(\S+)=问号后所有非空白字符
		var wg, wgQuery = ..string.match(line,`wireguard\:\/\/(\S+?)\?(\S+)`);
// 【模式匹配】兜底：匹配不带查询串的 wireguard 链接
		if(!wg) wg = ..string.match(line,`wireguard\:\/\/(\S+)`);
		if( wg ) {
			var wgQueryStr = wgQuery;
// 【模式匹配】从已捕获的内容里再单独提取查询串，规则同 1172 行
			if(!wgQueryStr) wgQueryStr = ..string.match(wg,`\?(\S+)`);
			// 去掉查询串与备注，得到 私钥@服务器:端口
			var wgMain = wg;
			var qs = ..string.indexOf(wgMain,"?");
			if(qs) wgMain = ..string.left(wgMain,qs-1);
			var hf = ..string.indexOf(wgMain,"#");
			if(hf) wgMain = ..string.left(wgMain,hf-1);

// 【模式匹配】把 wireguard 主体拆成 私钥@主机:端口。([^\@]+)=不含 @ 的私钥；([^\:\?\#]+)=不含冒号、问号、井号的主机；\:(\d+)=冒号加端口
			var wgPriv,wgHost,wgPort = ..string.match(wgMain,`^([^\@]+)\@([^\:\?\#]+)\:(\d+)`);
			if(!wgHost){
// 【模式匹配】wireguard 主体不含私钥时的形式：主机:端口
				wgHost,wgPort = ..string.match(wgMain,`^([^\:\?\#]+)\:(\d+)`);
			}
			if(wgHost){
				var outbound = {
					address = wgHost;
					port = tonumber(wgPort) : 51820;
					network = "tcp";
					protocol = "wireguard";
				};
				if(wgPriv) outbound["private-key"] = ..inet.url.decode(wgPriv);
				if(wgQueryStr){
					var info = ..inet.url.splitParameters(wgQueryStr);
					outbound["public-key"] = info.publickey : info["public-key"];
					outbound["pre-shared-key"] = info.presharedkey : info["pre-shared-key"];
					outbound["local-address"] = info.address : info.ip;
					if(info.ipv6) outbound.ipv6 = info.ipv6;
					if(info.mtu) outbound.mtu = tonumber(info.mtu);
					if(info.keepalive) outbound.keepAlive = tonumber(info.keepalive);
					if(info.domainstrategy) outbound.domainStrategy = info.domainstrategy;
					if(info.reserved){
						var arr = ..table.array();
// 【模式匹配】逐个提取 reserved 中的所有数字串。gmatch 会循环匹配，\d+=一个以上数字
						for(n in ..string.gmatch(info.reserved,`\d+`)) ..table.push(arr,tonumber(n));
						if(#arr) outbound.reserved = arr;
					}
					var aips = info.allowedips : info["allowed-ips"];
// 【模式匹配】按逗号拆分 allowed-ips（逗号是字面分隔符，不做模式匹配）
					if(aips) outbound["allowed-ips"] = ..string.split(aips,',');
				}
// 【模式匹配】提取 # 之后的备注。(\S*)$=行尾的非空白字符（可为空）
				var wgFrag = ..string.match(line,`\#(\S*)$`);
				if(wgFrag) outbound.ps = ..inet.url.decode(wgFrag);

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			}
			continue;
		}

		//其他协议：Xray 26.x 暂不支持这些协议名，但按协议规范完整导入并保留全部字段；
		//生成配置时 ensureSupportedOutbound 会自动降级为 blackhole，避免整份配置加载失败。
// 【模式匹配】匹配其他协议的通用链接。^\s*=开头空白；([a-zA-Z][a-zA-Z0-9\-\.\+]*)=协议名（首字母开头，后可含字母数字与 - . +）；\:\/\/=字面 ://；(\S+)$=其余非空白字符
		var otherScheme,otherBody = ..string.match(line,`^\s*([a-zA-Z][a-zA-Z0-9\-\.\+]*)\:\/\/(\S+)$`);
		if(otherScheme){
			otherScheme = ..string.lower(otherScheme);
			var importOnly = ["anytls";"tuic";"snell";"mieru";"shadowtls";"juicity";"hysteria";"naive";"hysteria-go"];
			if(..table.find(importOnly,otherScheme)){
				var oUrl = ..inet.url.split(otherScheme ++ "://" ++ otherBody);
				if(oUrl && oUrl.host){
					// Xray 的 hysteria 协议仅支持 version=2（即 hysteria2），
					// 单独的 hysteria:// 链接是 v1，标记为 hysteria1 以便明确降级（而不是按 v2 错误生成）
					var protocolName = otherScheme;
					if(otherScheme=="hysteria") protocolName = "hysteria1";
					var outbound = {
						address = oUrl.host;
						port = tonumber(oUrl.port) : 443;
						network = "tcp";
						protocol = protocolName;
					};
					if(oUrl.user) outbound.id = decodeUser(oUrl.user);
					if(oUrl.password) outbound.password = ..inet.url.decode(oUrl.password);
					if(oUrl.extraInfo){
						var info = ..inet.url.splitParameters(oUrl.extraInfo);
						for(k,v in info){ if(outbound[k]===null) outbound[k] = v; }
						if(info.fp) outbound["client-fingerprint"] = info.fp;
						if(info.allowinsecure!==null) outbound.allowInsecure = (info.allowinsecure!=="0" && info.allowinsecure!=="false");
					}
					if(oUrl.location) outbound.ps = ..inet.url.decode(oUrl.location);
					outbound.subscribeUrl = subscribeUrl;
					..table.push(outbounds,outbound);
				}
				continue;
			}
		}

		//clashJson格式
		//debug.debug();
// 【模式匹配】匹配 clash 的 JSON 行。^\s*-\s*=开头空白加减号再加空白；(%\{\})=% 转义后的字面 {}；\s*$=结尾空白
		var clashJson = ..string.match(line,`^\s*-\s*(%\{\})\s*$`);
		if( clashJson ) {
			//debug.debug();
			//var outbound = ..web.json.parse(line);
			var outbound  = ..web.json.tryParse(clashJson)
			if(type(outbound)=="table"){
				if(outbound.type){
					if(outbound.type=="ssr"){
						outbound.network = 	outbound.protocol;	
						outbound.protocol = "ssr";	

						outbound.networkParam = outbound.protocol_param;
						outbound.protocol_param =  null;

						outbound.sni = outbound.ot_domain;
						outbound.path = outbound.ot_path;
						outbound.tls = outbound.ot_enable ? "tls" : null;  
					}

					if(outbound.type=="ss"){
						outbound.type =	"shadowsocks";
						outbound.network = "tcp";			
					}
					outbound.protocol = outbound.type;
					outbound.type = null;
				}
			
			//debug.debug();
			//debug.log.print(outbound)
			//console.dump(outbound);
			
			
			//var test1  = validOutbound(outbound) ; 
			//console.dump(test1);
			 
				//if( validOutbound(outbound) ){
				validOutbound(outbound)
				if( outbound.address ){
					
					//console.dump(outbound);
					
					outbound.subscribeUrl = subscribeUrl; 
					..table.push(outbounds,outbound );
					
					//console.dump(outbounds); 
				}
				continue;
			}
		}
		//json格式
// 【模式匹配】匹配纯 JSON 对象行。^\s*=开头空白；(%\{\})=字面 {}；\s*$=结尾空白
		var json = ..string.match(line,`^\s*%\{\}\s*$`);
		if( json ) {
			var outbound  = ..web.json.tryParse(json)
			if(type(outbound)=="table"){
				if( validOutbound(outbound) ) ..table.push(outbounds,outbound );
				continue;
			}
		}
	}
	if(!#outbounds) {
		//console.dump(str);
		debug.log.print("从"+tempForDebugLog+"抓取到"+#outbounds+"个服务器");
	}
		
		//debug.log.print("抓取到"+#outbounds+"个服务器");
	return outbounds;
}

//从剪贴板导入节点或订阅,（订阅配置页面使用）
importFromClipboard  = function(refreshConfig){
    import win.clip;
	var str = ..win.clip.read();

    if( refreshConfig===false ){
		if(!str){return;}

		str = ..string.trim(str,'"\'\t\r\n ');//从字符串首尾清除指定的一个或多个单字节字符（"'制表符(横向跳格) 回车换行 ）

		if( ..string.startWith(str,"http://") || ..string.startWith(str,"https://") 
			|| ..string.match(str,"^\s*/\N+\s*$") ){// ^模式串必须从文本的开始处匹配：\s空白符、*任意字符、/、\N不是换行符1次或多次、\s空白字符、*任意字符、$模式串必须匹配至文本结束处）

			return importFormSubscription(str);
		}

		return importFromString(str);
    }
	elseif( refreshConfig===true ){
		if(str){
			str = ..string.trim(str,'"\'\t\r\n '); //（"'制表符(横向跳格) 回车换行 ）
			if( ..string.startWith(str,"http://") || ..string.startWith(str,"https://") 
				|| ..string.match(str,"^\s*/\N+\s*$") ){// ^模式串必须从文本的开始处匹配：\s空白符、*任意字符、/、\N不是换行符1次或多次、\s空白字符、*任意字符、$模式串必须匹配至文本结束处）

				//import UpdateSubscription;
				if( updateSubscription({[str]=true}) ){return true}
				else {return false}
			}

			var impoutbounds = importFromString(str);
			if(#impoutbounds){
				var count = #impoutbounds;
				..config.proxy.outbounds = ..table.append(impoutbounds,..config.proxy.outbounds);
				..config.proxy.save();
				..publish("uiCommand.restartxrayCore","obadd",#impoutbounds);
				..publish("uiCommand.restartxrayCore","change");
				..mainForm.msgOk("已成功导入" + count + "个节点",1200);
				return true; 
			}
		}
		..mainForm.msgFrown('未能导入节点或订阅！');
		//('\r\n请先复制以下格式文本（自动清除其中的无效内容）：\r\n\r\n1、一行或多行（忽略无效行）分享链接或服务器JSON配置。\r\n支持 vmess://，vless://，ss://，ssr://，trojan://， trojan-go:// 等通用分享链接。\r\n\r\n2、包含多个服务器配置的JSON数组,支持winXray格式以及通用格式JSON。\r\n\r\n3、单个 http:// 或 https:// 开头的通用订阅源地址。\r\n可直接使用浏览器地址栏的github文件地址（含blob或raw目录名）。\r\n也可以仅复制单斜杆开始的github文件路径。\r\n\r\n订阅源可用BASE64编码或明文返回以上1、2条规定的配置或分享链接。');
	}
}

validAll = function(outbounds){ 
	for(i=#outbounds;1;-1){
		if(!validOutbound(outbounds[i])){
			..table.remove(outbounds,i);
		} 
	} 

	return outbounds;
}

validOutbound = function(outbound){
	var validResult;	// 统一返回结果（try 块里的 return 退不出本函数）  
try{	
	//var outbound = outbound1 
	if(type(outbound)!="table"){ return;  }

	if(outbound.obfs_param){
		outbound.obfsParam = outbound.obfs_param;
		outbound.obfs_param = null;
	}
	
	if(outbound["obfs-param"]){
		outbound.obfsParam=outbound["obfs-param"];
		outbound["obfs-param"]=null;
	}
	
	if(outbound.aid){
		outbound.alterId = outbound.aid;
		outbound.aid = null;
	}

	if(outbound.add){
		outbound.address = outbound.add;
		outbound.add = null;
		..table.define(outbound);//清空预定义键名
	}

	if(outbound.net){
		outbound.network = outbound.net;
		outbound.net = null;
		..table.define(outbound);
	}

	if(outbound.peer ){
		if(#outbound.peer) outbound.sni = outbound.peer;
		outbound.peer = null;
		..table.define(outbound);
	}

	if(!outbound.security){
		if(outbound.method && outbound.method!="none"){
			outbound.security = outbound.method;
		}
		if(outbound.cipher && outbound.cipher!="none" && outbound.cipher!="auto"){
			outbound.security = outbound.cipher;
		}
		outbound.cipher = null;
		outbound.method = null; 
	}

	if(!outbound.address){
		if(outbound.server){
			outbound.address = outbound.server;
			outbound.server = null;
		}
	}

	if(!outbound.ps){
		if(outbound.remarks){
			outbound.ps = outbound.remarks;
			outbound.remarks = null;
		}
		elseif(outbound.name){
			outbound.ps = outbound.name;
			outbound.name = null;
		}
	} 

	if(!outbound.port){
		if(outbound.server_port){
			outbound.port = outbound.server_port;
			outbound.server_port = null; 

			if(!outbound.protocol && outbound.password){
				outbound.protocol = "shadowsocks";
			}
		}
		else {
			outbound.port=443;
		} 
	}

	if(!outbound.protocol){
		outbound.protocol = "vmess";
// 【模式匹配】查找备注中是否含 @@vless 或 @@xtls 标记。string.find 此处按字面查找，@@ 无模式含义
		if(outbound.ps && (..string.find(outbound.ps,"@@vless") || ..string.find(outbound.ps,"@@xtls"))){
			outbound.protocol = "vless";
		}
	}

	if(!outbound.id){
		if(outbound.password){
			outbound.id = outbound.password;
			outbound.password = null; 
		} 

		if(outbound.uuid){
			outbound.id = outbound.uuid;
			outbound.uuid = null; 
		} 
	}  

	if(outbound["skip-cert-verify"]){
		outbound.allowInsecure = outbound["skip-cert-verify"];
		outbound["skip-cert-verify"] = null;
	}

	if(outbound["ws-path"]){
		outbound.path = outbound["ws-path"];
		outbound["ws-path"] = null;
	}

	if(outbound["ws-headers"]){
		outbound.headers = outbound["ws-headers"];
		outbound["ws-headers"] = null; 
	}

	var grpcOpts = outbound[["grpc-opts"]];
	if( grpcOpts ){
		if(grpcOpts[["grpc-service-name"]]){
			outbound.grpcSni = grpcOpts[["grpc-service-name"]];
		}
	}

	if(type(outbound.tls)!="string"){
		if(outbound.tls) outbound.tls = "tls";
		else outbound.tls = "";
	}

	if(outbound.servername){
		outbound.host = outbound.servername;
		outbound.servername = null;
	}

/*
	import debug.log
	import console
	debug.log.print(outbound);
	console.dump(outbound)
*/

	var httpOpts = outbound["http-opts"]: outbound["h2-opts"];   

	if(httpOpts){
		if(!..table.count(httpOpts)){
			httpOpts = outbound["h2-opts"] : httpOpts; 
		}


		if(httpOpts.method){
			outbound.httpMethod = httpOpts.method;
		}		

		if(httpOpts.path){
			outbound.path = httpOpts.path;
		}

		if(httpOpts.headers){
			outbound.headers = httpOpts.headers; 
		}

		if(httpOpts.host){
			outbound.host = httpOpts.host; 
		}
	} 

	// clash 源里 ws 的自定义 Host 有时以大写键直接挂在顶层，需要归一化到 host
	if(outbound.Host){
		if(!outbound.host) outbound.host = outbound.Host;
		outbound.Host = null;
	}

	if(outbound.headers){
		var headers = {};
		for k,v in ..table.eachName(outbound.headers){ 
// 【模式匹配】把 header 键名规范化为首字母大写（例如 HOST 变为 Host）。^(\a)=串首第一个字母；(\a+)$=其余字母直到串尾
			k = ..string.replace(k,"^(\a)(\a+)$",lambda(a,b) ..string.upper(a) + ..string.lower(b) );
			headers[k] = v;	
		}
		outbound.headers = headers;

		if(outbound.headers.Host){
			if(outbound.headers.Host==outbound.host){
				outbound.headers.Host = null;
			}
			elseif(!outbound.host){
				outbound.host = outbound.headers.Host;
				outbound.headers.Host = null;
			}
		}

		if(!..table.count(outbound.headers)){
			outbound.headers = null;	
		}
	}

	outbound["http-opts"] = null;
	outbound["h2-opts"] = null;
	outbound.country = null;
	outbound.v = null;
	
	var pluginOpts = outbound["plugin-opts"];
	if(pluginOpts){
		var optsTemp = "";
		if(pluginOpts["mode"] && pluginOpts["mode"]=="websocket"){
			optsTemp += "tls;";
		}
		if(pluginOpts["host"]){
			optsTemp += pluginOpts["host"]+";";
		}
		if(pluginOpts["path"]){
			optsTemp += pluginOpts["path"]+";";
		}
		outbound.pluginOptions = optsTemp;
	}
	outbound["plugin-opts"] = null;
	
	
	// ==== 网络类型校验与归一化 ====
	// 订阅源常出现脏数据（network 写成乱码），会导致 Xray 整份配置加载失败。
	// 注意：SSR 的 network 是混淆算法名（origin/auth_aes128_md5 等），必须跳过校验。
	if(outbound.network && type(outbound.network)=="string"){
		var net = ..string.lower(outbound.network);
		if(net == "splithttp") net = "xhttp"; // 旧名归一化（Xray 26 已移除 HTTP 传输）
		if(outbound.protocol != "ssr"){
			if(!..table.find(["raw";"tcp";"ws";"websocket";"grpc";"xhttp";"httpupgrade";"mkcp";"kcp";"quic";"hysteria";"http";"h2"],net)){
				net = null; // 非法值清空，生成配置时自动使用默认传输
			}
		}
		outbound.network = net;
	}
	
	..table.define(outbound);
		
		//debug.log.print(outbound)
		//console.dump(outbound) 
		//debug.debug();
		
	if(outbound.address){
		// 注意：aardio 的 try...catch 本质是「立即执行的匿名函数」，
		// 在 try 里 return 只能退出 try 块自身，退不出 validOutbound 函数，
		// 所以这里必须把结果赋值给 validResult，最后由函数末尾统一 return。
		validResult = true;
	}
}
catch () {
	import debug.log
	import console
	//debug.log.print(outbound);
	//console.dump(outbound)
	validResult = false;
	} 
	return validResult;
}



// ==========================================================================
// 从网页提取订阅链接（两级抓取 + 去重）
//
// 第 0 级：访问传入的 url，提取出其中「全部」链接并先去重，避免同一个地址被重复访问。
// 第 1 级：逐个检查这些链接：
//         · 末尾命中「后缀白名单」的      → 直接作为结果返回（不再访问）；
//         · 末尾命中「无关后缀」的        → 直接丢弃（图片/样式/脚本/字体/音视频/压缩包等）；
//         · 域名命中「二次访问域名名单」的 → 再访问一次该链接，
//                                          从中提取命中后缀白名单的链接作为结果；
//         · 其余                          → 丢弃（不访问，避免白白浪费时间）。
// 最后把两级结果合并、去重后返回。
//
// 两个名单都保存在 config.subscribe 里（也就是 config/subscribe.table）：
//   config.subscribe.linkAllowedExts  —— 订阅地址后缀白名单
//   config.subscribe.linkVisitDomains —— 需要二次访问的域名名单
// 可在软件「订阅配置」页面点「链接提取规则」按钮编辑。
//
// 参数 @url      起始网址（通常是「列出订阅链接」的网页，也可以是订阅源本身）
// 参数 @maxFetch 可选，第二级最多访问多少个页面，默认 20（防止链接太多时耗时失控）
//
// 返回：去重后的链接数组（都是绝对地址，且末尾命中后缀白名单）
// ==========================================================================
var extractLinksFromUrl = function(url,maxFetch){
	import inet.http;
	import inet.url;
	import zlib;	// 导入 zlib 后 inet.http 才能自动解压 gzip 应答

	if(type(url)!="string") return [];
	url = ..string.trim(url);
	if(!#url) return [];

	maxFetch = ..tonumber(maxFetch);
	// 上限：同一批最多「二次访问」多少个页面。
	// 实测大站（例如 GitHub 仓库页 240KB）每次访问约 2~3 秒，默认取 20 以控制总耗时。
	if(!maxFetch || maxFetch<1) maxFetch = 20;
	maxFetch = ..math.floor(maxFetch);

	//------------------------------------------------------------------
	// 两个名单：从 config.subscribe 读取
	// 用直接下标 [[ ]] 取值，config 或其成员不存在时只会返回 null，不会报错
	//------------------------------------------------------------------
	var allowedExts = ..config[["subscribe"]][["linkAllowedExts"]];
	if(type(allowedExts)!="table") allowedExts = [];

	var visitDomains = ..config[["subscribe"]][["linkVisitDomains"]];
	if(type(visitDomains)!="table") visitDomains = [];

	// 明显无关的后缀（图片/样式/脚本/字体/音视频/压缩包/文档），命中就直接跳过、不访问
	var skipExts = [
		".png";".jpg";".jpeg";".gif";".bmp";".webp";".svg";".ico";".tif";".tiff";".avif";".heic";
		".css";".js";".mjs";".cjs";".map";
		".woff";".woff2";".ttf";".otf";".eot";
		".mp3";".wav";".ogg";".mp4";".avi";".mkv";".mov";".webm";".flv";".m4a";".flac";".wma";
		".zip";".rar";".7z";".gz";".bz2";".xz";".tar";".exe";".msi";".dmg";".apk";".deb";".rpm";".iso";".jar";".bin";
		".pdf";".doc";".docx";".xls";".xlsx";".ppt";".pptx";".psd"
	];

	//------------------------------------------------------------------
	// 内部工具函数
	//------------------------------------------------------------------

	// 取「去掉 ?查询串 与 #锚点 之后」的部分并转小写，用于后缀比较
	var getPathKey = function(u){
		var p = u;
		var pos = ..string.indexOf(p,"?");
		if(pos) p = ..string.left(p,pos-1);
		pos = ..string.indexOf(p,"#");
		if(pos) p = ..string.left(p,pos-1);
		return ..string.lower(p);
	};

	// 链接是否命中指定后缀表（忽略大小写）
	var hitExt = function(exts,u){
		var p = getPathKey(u);
		for(i=1;#exts;1){
			var ext = exts[i];
			if(type(ext)!="string") continue;
			ext = ..string.lower(..string.trim(ext));
			if(#ext && ..string.endWith(p,ext)) return true;
		}
		return false;
	};

	// 规范化名单里写的域名：允许写 github.com、*.github.io、https://github.com/xxx 等写法
	var normalizeDomain = function(d){
		if(type(d)!="string") return null;
		d = ..string.lower(..string.trim(d));
		if(!#d) return null;
// 【模式匹配】^https?\:// 表示行首的 http:// 或 https://，冒号必须转义成 \: 才是字面冒号
		d = ..string.replace(d,"^https?\://","");	// 去掉协议头
		var pos = ..string.indexOf(d,"/");			// 只保留主机部分
		if(pos) d = ..string.left(d,pos-1);
		pos = ..string.indexOf(d,"?");
		if(pos) d = ..string.left(d,pos-1);
		pos = ..string.indexOf(d,":");
		if(pos) d = ..string.left(d,pos-1);
		if(..string.startWith(d,"*.")) d = ..string.right(d,-3);	// 去掉通配前缀 *.
		d = ..string.trim(d,". ");
		return #d ? d : null;
	};

	// 链接的域名是否命中「二次访问域名名单」（子域名也算命中）
	var hitDomain = function(u){
		if(!#visitDomains) return false;
		var info = ..inet.url.split(u);
		if(type(info)!="table") return false;
		var host = ..string.lower(info.host : "");
		if(!#host) return false;
		for(i=1;#visitDomains;1){
			var d = normalizeDomain(visitDomains[i]);
			if(!d) continue;
			if(host==d) return true;
			if(..string.endWith(host,"." ++ d)) return true;
		}
		return false;
	};

	// 把链接规范成绝对地址；无效链接返回 null
	var normalizeLink = function(raw,baseUrl){
		if(type(raw)!="string") return null;
		raw = ..string.trim(raw);
		if(!#raw) return null;

		// ① 过滤不能抓取的协议与无效链接
		var lower = ..string.lower(raw);
		if( ..string.startWith(lower,"#")
			|| ..string.startWith(lower,"javascript:")
			|| ..string.startWith(lower,"mailto:")
			|| ..string.startWith(lower,"tel:")
			|| ..string.startWith(lower,"data:")
			|| ..string.startWith(lower,"file:")
			|| ..string.startWith(lower,"about:")
			|| ..string.startWith(lower,"blob:")
			|| ..string.startWith(lower,"ftp:") ){
			return null;
		}

		// ② 还原链接里最常见的 HTML 实体（&amp; → &）
		raw = ..string.replaceLiteral(raw,"&amp;","&");
		raw = ..string.replaceLiteral(raw,"&#38;","&");

		// ③ 拼成绝对地址：
		//    joinpath 对「相对路径 / 绝对路径 / 协议相对地址 //主机/路径 / 完整 URL」都适用
		var abs = ..inet.url.joinpath(baseUrl,raw);
		if(type(abs)!="string" || !#abs) return null;

		// ④ 去掉 #锚点（同一个文件的不同锚点没有意义）
		var pos = ..string.indexOf(abs,"#");
		if(pos) abs = ..string.left(abs,pos-1);

		// ⑤ 只保留 http/https
		lower = ..string.lower(abs);
		if(!..string.startWith(lower,"http://") && !..string.startWith(lower,"https://")) return null;

		return abs;
	};

	// 从网页内容里提取「全部」原始链接（不做后缀过滤）
	var collectRawLinks = function(content,list){
		// ① href="..." 与 href='...'
// 【模式匹配】href\s*=\s* 是 href 加可选空白、等号、可选空白；["'] 表示半角双引号或单引号；([^"']+) 捕获引号之间不含引号的内容
		for link in ..string.gmatch(content,`href\s*=\s*["']([^"']+)["']`) {
			..table.push(list,link);
		}

		// ② 正文里裸露的网址（纯文本列表、Markdown 链接都靠这条）
// 【模式匹配】\: 与 \/ 转义成字面冒号与斜杠（冒号在模式里表示任意多字节字符，必须转义）；[^\s<>"']+ 是一串不含空白、尖括号、引号的字符
		for link in ..string.gmatch(content,`<https?\:\/\/[^\s<>"']+>`) {
			// 截掉网址后面粘上的非 ASCII 字符（汉字、中文标点等）
			var cut;
			for(i=1;#link;1){
				var b = link[i];
				if(b<0x21 || b>0x7E){ cut = i; break; }
			}
			if(cut) link = ..string.left(link,cut-1);
			// 有些网页会把多个网址挤成一串（例如 JSON 里把 \n 写成了 /n），
			// 这时只保留第一个完整网址：从第 6 个字节之后再遇到 http:// 或 https:// 就截断
			var cutPos;
			var hp1 = ..string.indexOf(link,"http://",6);
			var hp2 = ..string.indexOf(link,"https://",6);
			if(hp1 && hp2) cutPos = (hp1<hp2) ? hp1 : hp2;
			elseif(hp1) cutPos = hp1;
			elseif(hp2) cutPos = hp2;
			if(cutPos) link = ..string.left(link,cutPos-1);
			// 去掉末尾粘上的标点
			link = ..string.trim(link,`.,;:!?)]}"'`);
			if(#link>8) ..table.push(list,link);
		}
	};

	// 结果集（自动去重）
	var resultLinks = [];
	var resultMap = {};
	var addResult = function(link){
		if(resultMap[link]) return;
		resultMap[link] = true;
		..table.push(resultLinks,link);
	};

	// 把一批原始链接规范化并去重，返回绝对地址数组
	var collectLinks = function(content,baseUrl){
		var rawList = [];
		collectRawLinks(content,rawList);

		var list = [];
		var seen = {};
		for(i=1;#rawList;1){
			var callOk,abs = ..call(normalizeLink,null,rawList[i],baseUrl);
			if(!callOk || !abs) continue;
			if(seen[abs]) continue;	// 先在本轮内去重，避免后面重复访问
			seen[abs] = true;
			..table.push(list,abs);
		}
		return list;
	};

	// 共用一个 HTTP 客户端（自动使用系统代理），并设置超时，避免个别死链把整体拖住
	var http = ..inet.http();
	http.setTimeouts(4000,6000,6000);

	var fetchPage = function(u){
		var callOk,content = ..call(
			function(){
				return http.get(u);
			},null
		);
		if(!callOk) return null;
		if(type(content)!="string") return null;
		return content;
	};

	//------------------------------------------------------------------
	// 第 0 级：抓取起始网址，提取全部链接（已去重）
	//------------------------------------------------------------------
	var visitedMap = {};
	visitedMap[url] = true;

	var pageContent = fetchPage(url);
	if(!pageContent){
		..debug.log.print("[提取链接] 抓取失败：",url);
		return [];
	}

	var firstLevel = collectLinks(pageContent,url);
	..debug.log.print("[提取链接]",url,"共提取到唯一链接",#firstLevel,"个");

	//------------------------------------------------------------------
	// 第 1 级：分类处理
	//------------------------------------------------------------------
	var fetchCount = 0;
	var capWarned;	// 只在首次达到上限时提示一次
	for(i=1;#firstLevel;1){
		var link = firstLevel[i];

		// ① 末尾命中后缀白名单 → 直接作为结果，不再访问
		if( hitExt(allowedExts,link) ){
			addResult(link);
			continue;
		}

		// ② 末尾是明显无关的后缀 → 直接丢弃
		if( hitExt(skipExts,link) ) continue;

		// ③ 域名不在「二次访问域名名单」里 → 直接丢弃，不访问
		if( !hitDomain(link) ) continue;

		// ④ 命中域名名单 → 再访问一次，从里面提取后缀白名单链接
		if(visitedMap[link]) continue;
		if(fetchCount >= maxFetch){
			// 注意：达到上限只是不再「二次访问」，
			// 仍然要继续扫描后面的链接 —— 它们可能直接就命中后缀白名单（那些不需要访问）。
			if(!capWarned){
				capWarned = true;
				..debug.log.print("[提取链接] 第二级访问数量达到上限",maxFetch,"个，后续链接不再二次访问");
			}
			continue;
		}
		visitedMap[link] = true;
		fetchCount++;

		var subContent = fetchPage(link);
		if(!subContent) continue;

		var subLinks = collectLinks(subContent,link);
		for(j=1;#subLinks;1){
			if( hitExt(allowedExts,subLinks[j]) ) addResult(subLinks[j]);
		}
	}

	..debug.log.print("[提取链接] 处理完成：第二级访问",fetchCount,"个，最终结果",#resultLinks,"个");
	return resultLinks;
}







//从订阅更新数据函数

updateSubscription = function(outbondSubscribeUrlMap){
	import debug
	//console.print(outbondSubscribeUrlMap)

	var cfgOutbounds = ..config.proxy.outbounds : ..table.array(); 
	if(!outbondSubscribeUrlMap) {//传过来的为空，就从服务器列表中读取订阅信息（实际上没有传参）
		outbondSubscribeUrlMap = {}

		for(i=#cfgOutbounds;1;-1){
			var outbound = cfgOutbounds[i] 
			if(outbound.subscribeUrl){
				outbondSubscribeUrlMap[outbound.subscribeUrl] = true;	
			}
		}

		var cfgSubscribeUrls = ..config.subscribe.subscribeUrls;
		for(i=#cfgSubscribeUrls;1;-1){
			var sub = cfgSubscribeUrls[i]  
			if(sub.checked ===  "启用") {
				outbondSubscribeUrlMap[sub.url] = true; 
			}
			else {
				outbondSubscribeUrlMap[sub.url] = null; 
			}
		}

		if(!..table.count(outbondSubscribeUrlMap)){ 
			..mainForm.msgWarn('当前未启用任何订阅源,\n请先复制订阅源网址到剪贴板然后点击「批量导入链接」!', 1500);
			//winform.btnUpdate.disabledText = null;
			return;
		}
	}
	//debug.debug()
	var count = 0; 
	for(url,data in outbondSubscribeUrlMap){
		debug.log.print("开始从",url,"获取服务器")	;
		var impOutbounds = ..xray.outbounds.importFromString(url);
			
        var links = extractLinksFromUrl(url);
        
        
     //   debug.debug();
     	
        for k,link in links {
          //  var servers = ..xray.outbounds.importFromString(link);
          debug.log.print(link);
        	..table.append(impOutbounds, ..xray.outbounds.importFromString(link));
        //标记重复节点
		for(i=1;#impOutbounds;1){
			if(impOutbounds[i].repeat) continue;
			for(j=i+1;#impOutbounds;1){
			//if( j<=i ){ continue }
				if( impOutbounds[j].address==impOutbounds[i].address 
					&& impOutbounds[j].port==impOutbounds[i].port ){
					impOutbounds[j].repeat=true;
				}
			}
		}
		//删除重复节点
		var removecount=0;
		for(i=#impOutbounds;1;-1){
			if(impOutbounds[i].repeat){
				..table.remove(impOutbounds,i);
				removecount++;
			}
		}
        	if (#impOutbounds > 5000) break;//太多了内存不够
        }
        

	//	debug.log.print("删除重复服务器",removecount,"个","                            获取",#impOutbounds,"个")	;
		
		
		
		if(#impOutbounds){
/*
			for(i=#cfgOutbounds;1;-1){
				var outbound = cfgOutbounds[i] 
				if(outbound.subscribeUrl==url && outbound.ps != "已测通"){
					..table.remove(	cfgOutbounds,i );//先删除当前订阅网址下的原节点
				}
			}
*/
			debug.log.print("从",url,"获得",#impOutbounds,"个服务器");
			..mainForm.msgOk("从"+url+"已刷新" + #impOutbounds + "个订阅服务器。",1500);
			count = count + #impOutbounds;
			..table.append(cfgOutbounds,impOutbounds);
			
		}
		else{
			debug.log.print("未从",url,"获取服务器");
		}
	//	if(#..config.proxy.outbounds >15000) ..frmXray.removeRepeat();
	}
	
	//import xray
	//..frmXray.removeRepeat();
	..config.proxy.save();
	..mainForm.msgOk("已刷新" + count + "个订阅服务器。",1500);
	debug.log.print("已找到" + count + "个订阅服务器。")
	..publish("uiCommand.print","已找到" + count + "个订阅服务器。"); 
//	..publish("outbounds.updateConfigJson");
//	..publish("uiCommand.restartxrayCore",cfgOutbounds) 

	return count;
}

autoUpdateSubscription = function(){
	var outbondSubscribeUrlMap = {} 
	var cfgSubscribeUrls = ..config.subscribe.subscribeUrls;
	for(i=#cfgSubscribeUrls;1;-1){
		var sub = cfgSubscribeUrls[i]  
		if(!#sub.url){
			continue;
		}

		if(sub.checked ===  "启用") {
			outbondSubscribeUrlMap[sub.url] = true; 
		}
	}

	if(!..table.count(outbondSubscribeUrlMap)){
		return;
	}

	..thread.invoke( 
		function(winform,outbondSubscribeUrlMap,responseCache){
			import inet.http;
			import web.rest.github;

			var http = inet.http();
			for(url,v in outbondSubscribeUrlMap){ 

				if( string.indexOf(url,"github.com")
					|| string.indexOf(url,"raw.githubusercontent.com") 
					){
					outbondSubscribeUrlMap[url] = web.rest.github.getContent(url)
				}
				else{
					outbondSubscribeUrlMap[url] = http.get(url);
				}

				if(!outbondSubscribeUrlMap[url]){
					continue;
				}

				if(responseCache){
					if(responseCache[url] && responseCache[url]===..string.crc32(outbondSubscribeUrlMap[url])){
						outbondSubscribeUrlMap[url] = null;
					} 
				} 
			}

			winform.publish("thread.subscriptionUpdated",outbondSubscribeUrlMap)
		},..mainForm,outbondSubscribeUrlMap,_subscriptionResponseCache
	)
}



var currentActiveOutbound = ..globalActiveOutbound;
..subscribe("activeOutbound",function(address){
	currentActiveOutbound = address;
} )

..subscribe("thread.subscriptionUpdated",function(outbondSubscribeUrlMap){
    if(currentActiveOutbound){
    	return;
    }

	var cfgOutbounds = ..config.proxy.outbounds : ..table.array();

	var count = 0; 
	for(url,data in outbondSubscribeUrlMap){ 

		var impOutbounds = ..xray.outbounds.importFromString(data,url);
		if(#impOutbounds){
			for(i=#cfgOutbounds;1;-1){
				var outbound = cfgOutbounds[i] 
				if(outbound.subscribeUrl==url && outbound.ps != "已测通"){
					..table.remove(	cfgOutbounds,i );
				}
			}

			..table.append(cfgOutbounds,impOutbounds);
			count = count + #impOutbounds;
		}
	}

	if(!count){
		return;
	}

	..config.proxy.outbounds = cfgOutbounds;
	..config.proxy.save();

	..publish("outbounds.updateConfigJson");
	..publish("uiCommand.restartxrayCore")
	..publish("uiCommand.print","已自动刷新" + count + "个订阅服务器。")		 
} )

importFromClash = function(str,node){
	

	
    if(node){//如果包含结点
    	var start = false;var strTemp="";
    	var levelTable = ..table.array();
    	var levelATable = ..table.array();
    	var levelLast = 0;
    	var levelALast = 0;
    	
    //	debug.debug()
    	//如果是非table形式的格式转为table格式的
// 【模式匹配】判断内容中是否含 {}，%\{\} 中的 % 把花括号转义为字面值
    	if( !..string.match(str,"%\{\}") ){
    	    //console.dump(str)
    	    //debug.log.print()
// 【模式匹配】把换行统一替换为逗号。[<\r\n><\n\r>\r\n]=三个替换项任选其一（尖括号是分组，表示或）
    	    var temp1 = ..string.replace(str,"[<\r\n><\n\r>\r\n]",",");
// 【模式匹配】把连续的两个逗号替换为 空格逗号空格
    	    temp1 = ..string.replace(temp1,"\,\,"," , "); 
    	    //temp1 = ..string.replace(temp1,"\ ",""); 
    	    //console.dump(temp1) 
    	    //debug.log.print()
    	    
    		//debug.debug()	    
// 【模式匹配】把 YAML 的短横线列表转成 aardio 表写法。<-\s+>=减号加一个以上空白
    		temp1 = ..string.replace(temp1,"<\-\s+>",'\ \}\n\ \-\ \{');    		
    		//console.dump(temp1)
			//debug.log.print()
			
    			
    		//console.dump(temp1)
    		//debug.log.print()
			
    		return temp1;  
    	}
    	
    	for(line in ..string.lines(str) ){
        	//删除注释字段和空白行
        	line = ..string.splitEx(line,'\#')[1];
// 【模式匹配】匹配空行。^\s*$=整行只有空白（或为空）
        	if( line===null || ..string.match(line,"^\s*$") ){continue;}
        	//确定proxies范围
// 【模式匹配】匹配以字母开头的行。^\a=串首为一个字母
        	if(..string.match(line,"^\a")){
				if(..string.startWith(line,"proxies")){start = true;continue;}
				else {if(start){break;}continue;}
			}
			//开始解析数据
			if(start){
				
				//debug.debug()
				
// 【模式匹配】匹配「- {}」形式的行。^\s*\-\s*=开头空白加减号加空白；(%\{\})=字面 {}；\s*$=结尾空白
				if( ..string.match(line,"^\s*\-\s*%\{\}\s*$") ){strTemp += line+'\n';}//匹配到-｛｝
// 【模式匹配】条件取反，即该行不是「- {}」形式
    			elseif( !..string.match(line,"^\s*\-\s*%\{\}\s*$") ){
// 【模式匹配】取键的缩进量。^(\s*)\a=串首的任意空白加一个字母，外层 # 取捕获组长度
    				var numNow = #(..string.match(line,"^(\s*)\a"));//键缩进量
// 【模式匹配】取数组项的缩进量。^(\s*)\-=串首的任意空白加一个减号
    				var numANow = #(..string.match(line,"^(\s*)\-"));//数组缩进量
    				//确定数组缩进等级
    				var levelA;
    				for(index,num in levelATable){if(num == numANow){levelA=index;break;}}
    				if(!levelA && numANow){
    					..table.push(levelATable,numANow);
    					levelA=..table.count(levelATable);
    				}
    				elseif(!levelA && !numANow){levelA=0}

    				if( levelA>1 ){
// 【模式匹配】去掉行首的减号。^\s*(-)=串首空白加一个减号
    					line = ..string.replace(line,"^\s*(-)",'');
// 【模式匹配】重新计算去掉减号后的缩进量，规则同 2002 行
    					numNow = #(..string.match(line,"^(\s*)\a"));
    				}
    				elseif( levelA==1 ){
    					var temp = '\n-{';
    					if(levelLast){for(i=1;levelLast;1){temp = '}'+temp;}}
// 【模式匹配】把行首的 减号加空白 替换为指定前缀。^\s*-\s*=串首空白、减号、空白
    					line = ..string.replace(line,"^\s*-\s*",temp);
    				}

// 【模式匹配】匹配「- name:」形式的数组项起始。^\}*\n\-\{\s*\a=可选的右花括号、换行、减号、左花括号、空白、字母
    				if( ..string.match(line,"^\}*\n\-\{\s*\a") ){strTemp += line+","}//-name:1
// 【模式匹配】匹配单独的「}-」行。^\}\n\-\{\s*$=右花括号、换行、减号、左花括号、结尾空白
    				elseif( ..string.match(line,"^\}\n\-\{\s*$") ){strTemp += line}//-

    				levelALast = levelA;
    				//确定键缩进等级
    				var level;
    				for(index,num in levelTable){if(num=numNow){level=index;break;}}
    				if(!level && numNow){..table.push(levelTable,numNow);level=..table.count(levelTable);}
    				elseif(!level && !numNow){level=0}

// 【模式匹配】匹配「name:」形式的键（值为空）。^\s*\a[^\s\:]*(\:)\s*$=开头空白、字母、非空白非冒号字符、冒号、结尾空白
    				if( ..string.match(line,"^\s*\a[^\s\:]*(\:)\s*$") ){//name:
    					line = ..string.trim(line);
    					if( levelLast>0 && level>levelLast ){strTemp += line+"{"}
    					elseif( level==levelLast ){strTemp += ","+line+"{"}
    					elseif( level<levelLast ){strTemp += "}"+line+"{"}
    				}
// 【模式匹配】匹配「name:值」形式。^\s*\a[^\:]*\:?\s*[^\s]*\s*$=开头空白、字母、非冒号字符、可选冒号、可选空白、值、结尾空白
    				elseif( ..string.match(line,"^\s*\a[^\:]*\:?\s*[^\s]*\s*$") ){//name:1
    					line = ..string.trim(line);
    					if( levelLast==0 || level>levelLast ){strTemp += line}
    					elseif( levelLast>0 && level<levelLast){strTemp += "},"+line}
    					elseif( level==levelLast ){strTemp += ","+line}
    				}

    				levelLast = level;
    			}
    		}
    	}
    	var match1 = ..table.count(..string.matches(strTemp,"\{"));
		var match2 = ..table.count(..string.matches(strTemp,"\}"));
		for(i=1;match1-match2;1){
			strTemp += "}";
		}

    	if( #(..string.trim(strTemp)) ){
    		str = ..string.trim(strTemp);
    		//debug.debug()
    		return strTemp; 
    	}	
    }

	else {//包含的是"proxy-providers"
		var urlmap = ..table.array();
		var start = false;var levelTable = ..table.array();
		for(line in ..string.lines(str) ){
			//删除注释字段和空白行
        	line = ..string.splitEx(line,'\#')[1];
// 【模式匹配】匹配空行，规则同 1989 行
        	if( line===null || ..string.match(line,"^\s*$") ){continue;}
        	//确定proxies范围
// 【模式匹配】匹配以字母开头的行，规则同 1991 行
        	if(..string.match(line,"^\a")){
				if(..string.startWith(line,"proxy-providers")){start = true;continue;}
				else {if(start){break;}continue;}
			}

			if(start){
// 【模式匹配】取缩进量。^(\s*)[^\s]=串首任意空白加第一个非空白字符
				var numNow = #(..string.match(line,"^(\s*)[^\s]"));//键缩进量
				var level;
    			for(index,num in levelTable){if(num=numNow){level=index;break;}}
    			if(!level && numNow){..table.push(levelTable,numNow);level=..table.count(levelTable);}
    			elseif(!level && !numNow){level=0}

    			if(level==2){
// 【模式匹配】提取「url: http...」中的网址。^\s*url\:\s*=开头空白、url、冒号、空白；(http.*)=以 http 开头直到行尾的内容
    				var url = ..string.match(line,"^\s*url\:\s*(http.*)");
					url = url ? ..string.trim(url,'"\'\s\t\r\n ');
					if(..inet.url.is(url)){..table.push(urlmap,url)}
    			}
			}
		}

		if(#urlmap){
			return urlmap; 
		}
	}	
}

/**intellisense(xray.outbounds) 
exportSharedLinks(.(outbounds) = 导出分享链接
importFromString(.(str,subscribeUrl) = 导入分享链接
importFromClipboard() = 自剪贴板导入分享链接
autoUpdateSubscription() = 自动并静默更新订阅源
updateSubscription() = 更新或自剪贴板导入订阅源\n可选在参数中用一个表自定义要更新的订阅地址,\n参数表中键为url，值为true
importFromClash(.(str,node) = 从clash文件导入节点或订阅
importFromSingbox(.(cfg) = 从sing-box配置导入节点\n参数可以是已解析的配置表，也可以是单个出站对象表
end intellisense**/
