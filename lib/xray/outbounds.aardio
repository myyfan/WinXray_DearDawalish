//outbounds 出站代理
import web.json;
import inet.url;
import win.clip;
import crypt;
import crypt.bin;
import console
import debug
import inet.http;
import string.regex;



namespace xray.outbounds;
// 分享链接里的用户名/密码解码。
// inet.url.split 不会自动解码 user，而导出端会 inet.url.encode，
// 因此导入端必须解码，否则密码含 + % @ : 等字符时往返即损坏。
// inet.url.decode 遇到非法转义（例如密码本身含裸 %）会返回 null，此时保留原值。
var decodeUser = function(v){
	if(type(v)!="string" || !v) return v;
	if(!..string.indexOf(v,"%")) return v;
	var d = ..inet.url.decode(v);
	return d ? d : v;
};
//分享链接
exportSharedLinks = function(outbounds){
	var outString = {};
	for i,outbound in ..table.eachIndex(outbounds){
		// 空字符串在 aardio 中是真值，会让 if(outbound.id) 判定通过，生成非法的 http://@host:port 形式链接；
		// 这里把空串按「无认证」处理（该值本身就是无效数据）。
		if(type(outbound.id)=="string" && !#outbound.id) outbound.id = null;
		// clash 源里 ws 的自定义 Host 可能以大写键残留在顶层，导出前归一化
		if(outbound.Host && !outbound.host) outbound.host = outbound.Host;
		if(outbound.protocol == "vmess"){
			var info = {
				v = 2;
				add = outbound.address;
				aid = outbound.alterId;
				id = outbound.id; 
				port = outbound.port;
				net = outbound.network;
				type = outbound.type;
				path = outbound.path;
				host = outbound.host;
				tls = outbound.tls;
				ps = outbound.ps;
				sni = outbound.sni;
				alpn = outbound.alpn;
				fp = outbound["client-fingerprint"];
				allowInsecure = outbound.allowInsecure;
			}
			if(outbound.security) info.scy = outbound.security;

			if(outbound.network=="quic"){
				info.host = outbound.quicSecutity;
				info.path = outbound.key;
			}
			elseif(outbound.network=="kcp"){
				info.path = outbound.seed;
			}
			elseif(outbound.network=="grpc"){
				info.path = outbound.grpcSni;
			}

			var json = ..web.json.stringify(info);
			var vmess = "vmess://" + ..crypt.encodeBin(json);
			..table.push(outString,vmess);
		}
		elseif(outbound.protocol == "shadowsocks"){
			if(outbound.plugin){
				var pluginInfo;
				if(outbound.pluginOptions){
					pluginInfo = ..inet.url.encode(outbound.plugin+";"+outbound.pluginOptions);
				}
				else {
					pluginInfo = ..inet.url.encode(outbound.plugin);
				}
				var ss = "ss://" + ..crypt.encodeBin( outbound.security + ":" + outbound.id ) + "@" + outbound.address + ":" + outbound.port + "/?plugin=" + pluginInfo + "#" + ..inet.url.encode(outbound.ps);
				..table.push(outString,ss);
			}
			else {
				var ss = "ss://" + ..crypt.encodeBin( outbound.security + ":" + outbound.id ) + "@" + outbound.address + ":" + outbound.port + "#" + ..inet.url.encode(outbound.ps);
				..table.push(outString,ss);
			}
		} 
		elseif(outbound.protocol == "socks"){
			var ss;
			if(outbound.id) ss = outbound.protocol + "://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else ss = outbound.protocol + "://" + outbound.address + ":" + outbound.port;
			..table.push(outString,ss);
		} 
		elseif(outbound.protocol == "ssr" ){
			var ssrUrl =  outbound.address + ":" + outbound.port 
				+ ":" + (outbound.network:"origin")+ ":" + (outbound.security:"")+ ":" + (outbound.obfs:"plain") 
				+ ":" + ..crypt.bin.encodeUrlBase64(outbound.id:"");

			var info = {};

			if(#outbound.ps)info.remarks = ..crypt.bin.encodeUrlBase64(outbound.ps);
			if(#outbound.obfsParam)info.obfsparam = ..crypt.bin.encodeUrlBase64(outbound.obfsParam);
			if(#outbound.networkParam)info.protoparam = ..crypt.bin.encodeUrlBase64(outbound.networkParam);

			if(#outbound.path)info.ot_path = ..crypt.bin.encodeUrlBase64(outbound.path);
			if(#outbound.sni)info.ot_domain = ..crypt.bin.encodeUrlBase64(outbound.sni);
			if(outbound.tls=="tls"){ info.ot_enable = "1"; }

			if(..table.count(info)){
				ssrUrl = ssrUrl +"/?"+ ..inet.url.stringifyParameters(info) 
			}

			..table.push(outString,outbound.protocol + "://" + ..crypt.encodeBin(ssrUrl) );
		}  
		elseif(outbound.protocol == "trojan"  || outbound.protocol == "trojan-go"){
			var trojan;
			if(outbound.id) trojan = outbound.protocol + "://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else trojan = outbound.protocol + "://" + outbound.address + ":" + outbound.port;

			var info = {};
			if(outbound.network!="tcp") info.type = outbound.network;
			if(outbound.sni){ info.sni = outbound.sni;}
			if(outbound.host) info.host = outbound.host;
			if(outbound.path) info.path = outbound.path;
			// trojan 必须带上传输安全信息，否则往返后 TLS 丢失、节点不可用
			if(outbound.tls) info.security = outbound.tls;
			if(outbound.allowInsecure) info.allowInsecure = outbound.allowInsecure;
			if(outbound.alpn) info.alpn = outbound.alpn;
			if(outbound["client-fingerprint"]) info.fp = outbound["client-fingerprint"];

			if(..table.count(info)){
				trojan = ..inet.url.appendExtraInfo(trojan,info) 
			}

			if(outbound.ps){
				trojan = trojan + "#" + ..inet.url.encode(outbound.ps);
			} 
			..table.push(outString,trojan);
		} 
		elseif(outbound.protocol == "vless"){
			var vless;
			if(outbound.id) vless = "vless://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else vless = "vless://" + outbound.address + ":" + outbound.port;

			var info = {};
			if(outbound.network && outbound.network!="tcp") info.type = outbound.network;
			// 注意：security 在部分订阅源里表示「传输安全」（tls/reality/xtls），
			// 不能直接当成 VLESS 的 encryption 导出，否则分享链接会带上非法 encryption，
			// 被别的客户端导入后同样会导致内核拒绝加载整份配置。
			// 用与生成配置一致的解析逻辑，导出即顺带修正脏数据（导出后再导入可自愈）。
			import xray.core.configJson;
			var vlessEnc = ..xray.core.configJson.resolveVlessEncryption(outbound);
			if(vlessEnc != "none") info.encryption = vlessEnc;
			if(outbound.tls) info.security = outbound.tls;
			if(outbound.flow) info.flow = outbound.flow;
			if(outbound.allowInsecure) info.allowInsecure = outbound.allowInsecure;
			if(outbound.alpn) info.alpn = outbound.alpn;
			if(outbound.disableSessionResumption) info.disableSessionResumption = outbound.disableSessionResumption;
			if(outbound.sni){ info.sni = outbound.sni;}
			if(outbound.host) info.host = outbound.host;
			if(outbound.path) info.path = outbound.path;
			if(outbound.seed) info.seed = outbound.seed;
			if(outbound.key) info.key = outbound.key;
			// headerType 是 tcp 传输的伪装类型（http/none），与上面的 type（传输名）不是一回事
			if(outbound.type) info.headerType = outbound.type;
			// REALITY / uTLS 指纹 / gRPC / XHTTP（缺这些会导致导出再导入时丢配置）
			if(outbound["public-key"]) info.pbk = outbound["public-key"];
			if(outbound["short-id"]) info.sid = outbound["short-id"];
			if(outbound["spider-x"]) info.spx = outbound["spider-x"];
			if(outbound["client-fingerprint"]) info.fp = outbound["client-fingerprint"];
			if(outbound.grpcSni) info.serviceName = outbound.grpcSni;
			if(outbound.mode) info.mode = outbound.mode;
			if(outbound.authority) info.authority = outbound.authority;
			if(outbound.packetEncoding) info.packetEncoding = outbound.packetEncoding;

			if(..table.count(info)){
				vless = ..inet.url.appendExtraInfo(vless,info) 
			}

			if(outbound.ps){
				vless = vless + "#" + ..inet.url.encode(outbound.ps);
			} 
			..table.push(outString,vless);
		} 
		elseif(outbound.protocol == "naive"){
			var urlInfo = {
				host = outbound.address;
				port = outbound.port;
				scheme = "naive+"+outbound.network;
				location = outbound.ps;
			}

			if(outbound.headers){
				urlInfo.extraInfo ={
					["extra-headers"] = outbound.headers
				}
			}

			if(outbound.id){
// 【模式匹配】从节点 id 拆出「用户名:密码」。([^\:]+)=不含冒号的用户名，\:=字面冒号，([^\:]+)=不含冒号的密码。用于 naive 导出
				var u,p = ..string.match(outbound.id,"([^\:]+)\:([^\:]+)")
				if(u && p){
					urlInfo.user = u;
					urlInfo.password = p;
				}
				else {
					urlInfo.user = outbound.id;
				} 
			} 

			..table.push(outString,..inet.url.stringify(urlInfo));
		} 
		elseif(outbound.protocol == "hysteria2"){
			var hy;
			if(outbound.id) hy = "hysteria2://" + ..inet.url.encode(outbound.id) + "@" + outbound.address + ":" + outbound.port;
			else hy = "hysteria2://" + outbound.address + ":" + outbound.port;

			var info = {};
			if(outbound.sni) info.sni = outbound.sni;
			if(outbound.obfs) info.obfs = outbound.obfs;
			if(outbound["obfs-password"]) info["obfs-password"] = outbound["obfs-password"];
			if(outbound.pinnedPeerCertSha256) info.pinSHA256 = outbound.pinnedPeerCertSha256;
			if(outbound.allowInsecure) info.insecure = 1;
			if(outbound["client-fingerprint"]) info.fp = outbound["client-fingerprint"];
			if(outbound.alpn) info.alpn = outbound.alpn;

			if(..table.count(info)){
				hy = ..inet.url.appendExtraInfo(hy,info)
			}

			if(outbound.ps){
				hy = hy + "#" + ..inet.url.encode(outbound.ps);
			}
			..table.push(outString,hy);
		}
		elseif((outbound.protocol == "https") || (outbound.protocol == "http")){
			var urlInfo = {
				host = outbound.address;
				port = outbound.port;
				scheme = outbound.protocol;//"proxy"
				location = outbound.ps;
			}

			// http(s) 代理节点常带 tls / sni / allowInsecure，必须一并导出，否则往返即丢
			var httpExtra = {};
			if(outbound.tls) httpExtra.tls = outbound.tls;
			if(outbound.sni) httpExtra.sni = outbound.sni;
			if(outbound.allowInsecure) httpExtra.allowInsecure = 1;
			if(outbound["client-fingerprint"]) httpExtra.fp = outbound["client-fingerprint"];
			if(..table.count(httpExtra)){ urlInfo.extraInfo = httpExtra; }

			if(outbound.id){
// 【模式匹配】同上：从 id 拆出「用户名:密码」，用于 http(s) 代理导出
				var u,p = ..string.match(outbound.id,"([^\:]+)\:([^\:]+)")
				if(u && p){
					urlInfo.user = u;
					urlInfo.password = p;
				}
				else {
					urlInfo.user = outbound.id;
				} 
			} 

			..table.push(outString,..inet.url.stringify(urlInfo));
		} 
	}	

	return ..string.join(outString,'\r\n');
}
//设置元表，弱引用键、值，弱引用不会增加引用计数、不会阻止垃圾回收器删除对象
var _subscriptionResponseCache = {
	@{_weak="kv"}
}

// ==========================================================================
// 从 sing-box 配置导入节点
//
// 参数 @cfg 可以是「已解析好的 sing-box 配置表」（顶层含 outbounds 数组），
//            也可以是单个出站对象表。
//
// 只导入真实节点；下面这些不是节点的类型会被跳过：
//   direct / block / dns / selector / urltest
//
// 字段对应关系（sing-box → 本项目）：
//   type → protocol    server → address    server_port → port    tag → ps
//   uuid/password/auth_str → id            method → security      alter_id → alterId
//   tls.enabled → tls=\"tls\"              tls.server_name → sni  tls.insecure → allowInsecure
//   tls.alpn → alpn                        tls.utls.fingerprint → client-fingerprint
//   tls.reality.* → tls=\"reality\" + public-key / short-id
//   transport.type → network               transport.path → path  transport.headers.Host → host
//   transport.service_name → grpcSni
//
// 返回：本项目的出站数组
// ==========================================================================
importFromSingbox = function(cfg){

	if(type(cfg)!=type.table) return ..table.array();

	// 顶层有 outbounds 数组就按配置处理，否则当成单个出站对象
	var list = cfg[["outbounds"]];
	if( !(..table.isArrayLike(list) && #list) ){
		list = ..table.array(cfg);
	}

	// sing-box 的协议名与本项目基本一致，只有 hysteria(v1) 需要改名
	var protocolMap = {
		["hysteria"] = "hysteria1";
	};

	// 这些不是节点，直接跳过
	var skipTypes = {
		["direct"] = true;
		["block"] = true;
		["dns"] = true;
		["selector"] = true;
		["urltest"] = true;
	};

	var outbounds = ..table.array();

	for(i=1;#list;1){
		var ob = list[i];
		if(type(ob)!=type.table) continue;

		var typ = ob.type;
		if(type(typ)!=type.string) continue;
		typ = ..string.lower(typ);
		if(!#typ || skipTypes[typ]) continue;

		var o = {
			protocol = protocolMap[typ] : typ;
			address = ob.server;
			port = ..tonumber(ob.server_port);
			network = "tcp";
		};
		if(ob.tag) o.ps = ob.tag;

		//---- 各协议的账号/密码 ----
		if(o.protocol=="vless" || o.protocol=="vmess"){
			if(ob.uuid) o.id = ob.uuid;
		}
		elseif(o.protocol=="trojan"){
			if(ob.password) o.id = ob.password;
		}
		elseif(o.protocol=="shadowsocks"){
			if(ob.method) o.security = ob.method;
			if(ob.password) o.id = ob.password;
		}
		elseif(o.protocol=="hysteria2" || o.protocol=="hysteria1" || o.protocol=="tuic"){
			if(ob.password) o.id = ob.password;
			if(ob.auth_str) o.id = ob.auth_str;
		}

		//---- 其它协议也尽量把账号取出来（取不到就留空，交给生成端降级处理）----
		if(!o.id){
			if(ob.password) o.id = ob.password;
			elseif(ob.uuid) o.id = ob.uuid;
			elseif(ob.auth_str) o.id = ob.auth_str;
		}

		//---- http / socks 代理用「用户名:密码」形式 ----
		if(o.protocol=="http" || o.protocol=="socks"){
			if(ob.username && ob.password) o.id = ob.username ++ ":" ++ ob.password;
			elseif(ob.username) o.id = ob.username;
			elseif(ob.password) o.id = ob.password;
		}

		//---- vmess 专有 ----
		if(o.protocol=="vmess"){
			if(ob.alter_id) o.alterId = ..tonumber(ob.alter_id);
			if(ob.security) o.security = ob.security;
		}

		//---- vless 专有 ----
		if(o.protocol=="vless"){
			if(ob.flow) o.flow = ob.flow;
		}

		//---- hysteria2 的 salamander 混淆 ----
		if(o.protocol=="hysteria2"){
			var obfs = ob[["obfs"]];
			if(type(obfs)==type.table){
				if(obfs.type) o.obfs = obfs.type;
				if(obfs.password) o["obfs-password"] = obfs.password;
			}
		}

		//---- wireguard ----
		if(o.protocol=="wireguard"){
			if(ob.private_key) o["private-key"] = ob.private_key;
			if(ob.peer_public_key) o["public-key"] = ob.peer_public_key;
			if(ob.pre_shared_key) o["pre-shared-key"] = ob.pre_shared_key;
			if(ob.local_address) o["local-address"] = ob.local_address;
			if(ob.reserved) o.reserved = ob.reserved;
			if(ob.mtu) o.mtu = ..tonumber(ob.mtu);
			if(ob.peers) o.peers = ob.peers;
		}

		//---- 其它通用字段 ----
		if(ob.packet_encoding) o.packetEncoding = ob.packet_encoding;

		//---- TLS / REALITY / uTLS 指纹 ----
		var tls = ob[["tls"]];
		if(type(tls)==type.table && tls.enabled){
			o.tls = "tls";
			if(tls.server_name) o.sni = tls.server_name;
			if(tls.insecure) o.allowInsecure = true;
			if(tls.alpn) o.alpn = tls.alpn;

			var utls = tls[["utls"]];
			if(type(utls)==type.table && utls.fingerprint) o["client-fingerprint"] = utls.fingerprint;

			var reality = tls[["reality"]];
			if(type(reality)==type.table && reality.enabled){
				o.tls = "reality";
				if(reality.public_key) o["public-key"] = reality.public_key;
				if(reality.short_id) o["short-id"] = reality.short_id;
			}
		}

		//---- 传输层 ----
		var tr = ob[["transport"]];
		if(type(tr)==type.table){
			if(tr.type) o.network = tr.type;
			if(tr.path) o.path = tr.path;
			if(tr.host) o.host = tr.host;
			if(tr.service_name) o.grpcSni = tr.service_name;
			var hd = tr[["headers"]];
			if(type(hd)==type.table){
				var host = hd[["Host"]] : hd[["host"]];
				if(host) o.host = host;
			}
		}

		// 交给统一的规范化/校验逻辑（同时会补全/过滤无效节点）
		validOutbound(o);
		if( o.address ) ..table.push(outbounds,o);
	}

	return outbounds;
}

// ==========================================================================
// 把「http(s) 代理链接」直接转换成节点对象。
//
// 设计要点：
//   · 这里只做「格式解析」，不做「是不是网址」的判定 —— 网址判定由 isSubscribeUrl
//     在入口统一负责（importFromString 只解析节点数据）。
//   · 代理链接的 authority 部分不含路径，所以「域名之后出现 /」即视为格式非法
//     （例如 https://github.com/ssrsub/ssr 的 authority 是 github.com/ssrsub/ssr），
//     直接丢弃，避免生成垃圾地址。
//   · 协议名大小写不敏感：HTTP:// / Http:// 与 http:// 等价。
//   · 剥掉 ?查询 与 #备注 后必须对主体再做一次 trim，否则
//     「http://host:8080 # 备注」的尾随空格会让端口解析失败（端口被错补成 80）。
//
// 参数 @line 为单行文本；不是 http(s) 代理链接时返回 null。
// 返回节点对象：{ protocol; address; port; network; id?; tls?; sni?;
//                 client-fingerprint?; allowInsecure?; ps? }
// ==========================================================================
var toHttpProxyNode = function(line){
	if(type(line)!=type.string) return null;
	line = ..string.trim(line);
	if(!line) return null;

// 【模式匹配】取协议名与 :// 之后的全部内容（不跨行）。^\s*=开头可选空白；([hH][tT][tT][pP][sS]?)=捕获协议名（大小写不敏感）；\:\/\/=字面 ://；[^\r\n]+=本行其余所有字符。
// 这里刻意用「除换行外的全部字符」而不是 \S+：备注里经常带空格（例如 "#🇺🇸 机场推荐:xxx"），
// 用 \S+ 会因为遇到空格而整体匹配失败，白白丢掉这些节点。
	var scheme, body = ..string.match(line, `^\s*([hH][tT][tT][pP][sS]?)\:\/\/([^\r\n]+)`);
	if(!scheme) return null;
	scheme = ..string.lower(scheme);

	// 把 ?查询串 与 #备注 原样截下来（后面分别解析），只解析中间的主体
	var suffix = "";
	var qPos = ..string.indexOf(body,"?");
	var hPos = ..string.indexOf(body,"#");
	var cutPos;
	if(qPos && hPos) cutPos = (qPos < hPos) ? qPos : hPos;
	elseif(qPos) cutPos = qPos;
	elseif(hPos) cutPos = hPos;
	if(cutPos){
		suffix = ..string.right(body, #body - cutPos + 1);
		body = ..string.left(body, cutPos - 1);
	}

	// ★ 剥掉查询串/备注后必须 trim：否则「host:8080 # 备注」的主体会残留尾随空格，
	//   下面的端口解析 ^([^\:\?]+)\:(\d+)$ 会失配 → 端口被错补成 80。
	body = ..string.trim(body);

	// 域名之后只要出现 "/" 就说明 authority 里混入了路径，不是合法的代理链接 → 丢弃。
	// （scheme 里的 // 已在上面被 :// 切掉；?查询串 与 #备注 也已提前剥离，
	//   所以备注里的 "1.8MB/s" 这类斜杠不会造成误杀）
	if(!body || ..string.indexOf(body,"/")) return null;

	// 拆分 [用户名:密码@]主机[:端口]。
// 【模式匹配】^\s*=开头空白（此处 body 已 trim）；([^\@]+)=@ 之前的认证串；\@=字面 @；(.+)$=其余全部主体
	var userinfo, hostpart = ..string.match(body, `^([^\@]+)\@(.+)$`);
	if(!hostpart){ hostpart = body; userinfo = null; }

// 【模式匹配】从主机段拆出端口。^([^\:\?]+)=不含冒号问号的主机名或 IP；\:(\d+)$=冒号加纯数字端口
	var host, port = ..string.match(hostpart, `^([^\:\?]+)\:(\d+)$`);
	if(!host){ host = hostpart; port = null; }
	if(!host) return null;

	// 端口可以省略：按协议默认端口补齐。
	// http(s) 代理链接常见写法是 http://主机?sni=xxx（不带端口），此时端口就是默认的 80/443。
	var defaultPort = (scheme=="https") ? 443 : 80;
	if(!port) port = defaultPort;

	var outbound = {
		address = host;
		port = tonumber(port) : defaultPort;
		network = "tcp";
		protocol = scheme;
	};

	if(userinfo){
// 【模式匹配】把认证串拆成用户名与密码。^([^\:]+)=串首不含冒号的用户名；\:=字面冒号；(.+)$=其余全部作为密码
		var u,p = ..string.match(userinfo,"^([^\:]+)\:(.+)$");
		if(u && p){ outbound.id = decodeUser(u) ++ ":" ++ decodeUser(p); }
		else { outbound.id = decodeUser(userinfo); }
	}

	// 解析 ?查询串 与 #备注（suffix 一定以 ? 或 # 开头）
	if(suffix){
		if(suffix[[1]]=="?"){
			var qs = ..string.right(suffix,#suffix-1);
			var tag;
			var hh = ..string.indexOf(qs,"#");
			if(hh){
				tag = ..string.right(qs,#qs-hh);
				qs = ..string.left(qs,hh-1);
			}
			if(qs){
				var hq = ..inet.url.splitParameters(qs);
				if(hq.tls) outbound.tls = hq.tls;
				if(hq.sni) outbound.sni = hq.sni;
				if(hq.fp) outbound["client-fingerprint"] = hq.fp;
				if(hq.allowinsecure!==null) outbound.allowInsecure = (hq.allowinsecure!="0" && hq.allowinsecure!="false");
			}
			if(tag) outbound.ps = ..inet.url.decode(tag);
		}
		else {
			var tag = ..string.right(suffix,#suffix-1);
			if(tag) outbound.ps = ..inet.url.decode(tag);
		}
	}

	return outbound;
};

// ==========================================================================
// 判定「整串数据」是否为订阅源网址。
//
// 规则：只有「单行」且形如 http(s)://主机[:端口] 之后「紧跟 /」才算网址。
//   https://github.com/ssrsub/ssr      → 网址（直接返回，不再解析）
//   https://sub.445569.xyz             → 不是网址（当节点解析）
//   https://sub.445569.xyz:8443        → 不是网址
//   https://sub.445569.xyz/            → 网址
//   http://1.2.3.4:8080?sni=x          → 不是网址（当节点解析）
//
// ★ 多行数据一律返回 false：批量粘贴/订阅内容必然是节点数据，全部送进解析流程。
// 本函数是纯判定，不发起任何网络请求。
// ==========================================================================
isSubscribeUrl = function(str){
	if(type(str)!=type.string) return false;
	str = ..string.trim(str);
	if(!str) return false;
	if(..string.indexOf(str,'\n') || ..string.indexOf(str,'\r')) return false;  // 多行 → 一律送解析
	if(..string.match(str,"^\s*/\N+\s*$")) return true;   // 单斜杠 github 文件路径
// 【模式匹配】^[hH][tT][tT][pP][sS]?\:\/\/=开头 http:// 或 https://（大小写不敏感）；[^\s\/]+=主机与可选端口（不含空白与斜杠）；\/=紧跟其后的斜杠
	return ..string.match(str, `^[hH][tT][tT][pP][sS]?\:\/\/[^\s\/]+\/`);
};

// ==========================================================================
// 【获取层】从订阅源网址抓取原始数据。
//
// 为什么要把「获取」从 importFromString 里拆出来：
//   过去 importFromString 同时承担「判断输入是网址还是数据」+「网络下载」+「解析」三件事。
//   而订阅源网址与代理节点链接的语法高度重叠
//   （例如 http://sub.example.com:8443 与 http://proxy.example.com:8443 完全同形），
//   在解析函数里判断「这是网址还是节点」必然产生误判。
//   现在职责彻底拆开：
//     · fetchUrlRaw(url)        纯抓取（无 UI、无线程逻辑，可在任意线程调用）
//     · fetchSubscription(url)  抓取 + 进度提示 + 响应指纹缓存（界面线程用）
//     · importFromString(data)  只解析数据，永不联网
//     · importFromUrl(url)      抓取 + 解析（便捷组合，供只拿到网址的调用点使用）
// ==========================================================================

// 纯抓取函数：只做网络请求，不含任何 UI 或线程逻辑，可从任意线程直接调用。
var fetchUrlRaw = function(url){
	import inet.http;
	import web.rest.github;

	// GitHub 用专用接口（可读取网页形式的 blob 链接）
	if( string.indexOf(url,"github.com")
		|| string.indexOf(url,"raw.githubusercontent.com") 
		){
		var ret = web.rest.github.getContent(url);
		if(ret) return ret; 
	}

	var http = inet.http();
	http.setTimeouts(8000,15000,15000);
	return http.get(url);
};

// ==========================================================================
// 订阅进度提示框（界面线程用）
//
// 原设计：每个订阅源开始处理时显示一个「正在获取订阅源」进度框，
//   等这个订阅源「获取 + 提取下级链接 + 解析 + 合并去重」全部结束后才关闭，
//   然后由调用方用 msgOk 汇报本次获取到多少个节点。
//   所以这里把「打开 / 关闭」拆成两个函数，由调用方控制整个生命期。
// ==========================================================================
var subscribeProgressTitle = function(url){
	var title = '正在获取订阅源 ... ';
	var cfgSubscribeUrls = ..config.subscribe.subscribeUrls;
	if(cfgSubscribeUrls){
		for(i=#cfgSubscribeUrls;1;-1){
			var sub = cfgSubscribeUrls[i];
			if( sub && (sub.url === url) ){
				if(sub.url && #sub.url) title = '正在获取订阅源: ' + sub.url;
			}
		}
	}
	return title;
};

// 打开进度提示框；..mainForm 不存在（例如在后台线程里调用）时返回 null
var openSubscribeProgressDlg = function(url){
	if(!..mainForm) return null;
	import win.dlg.message;
	var msgDlg = win.dlg.message(..mainForm);
	var form = msgDlg.create(subscribeProgressTitle(url),,true);
	if(form) form.progress.startProgress(50);
	return form;
};

// 关闭进度提示框。用户可能已经手动关掉了，所以要判 valid 再关
var closeSubscribeProgressDlg = function(form){
	if(form && form.valid) form.close();
};

// ==========================================================================
// 并行抓取一组网址（分批并发 + 轮询收割）
//
// 为什么要并行：订阅源页面里往往有几十个「需要进去看看」的链接，
//   串行抓取每个约 2~3 秒，30 个就要 60~90 秒 —— 界面线程会被彻底卡住。
//   改成「分批并发」后总耗时降到最慢那一批，而界面线程只负责
//   「轮询 + thread.delay 泵消息」，所以界面始终不卡、进度框照常动画。
//
// 参数 @urlList 网址数组；@concurrency 每批并发数（默认 8）
// 返回：表 { [url] = 内容字符串 }；抓取失败的不出现在结果里
// ==========================================================================
var fetchUrlsParallel = function(urlList,concurrency,retry){
	var result = {};
	if(type(urlList)!=type.table || !#urlList) return result;

	concurrency = ..tonumber(concurrency);
	if(!concurrency || concurrency<1) concurrency = 8;
	concurrency = ..math.floor(concurrency);

	// 内部：跑一轮抓取，成功的写进 out
	var runPass = function(list,conc,cTimeout,sTimeout,rTimeout,out){
		// 共享键前缀：用 tick 保证不同轮次、不同批次、不同订阅之间不会撞键
		var keyPrefix = 'exf_' ++ tostring(..time.tick()) ++ '_' ++ tostring(conc) ++ '_';

		for(start=1;#list;conc){
			var stop = ..math.min(start + conc - 1,#list);

			// 启动这一批：每个网址一个独立线程（线程内只抓取，不碰界面）
			var keys = {};
			for(k=start;stop;1){
				var key = keyPrefix ++ tostring(k);
				keys[k] = key;
				..thread.invoke(
					function(u,key,c,s,r){
						import inet.http;
						import zlib;	// 导入 zlib 后 inet.http 才能自动解压 gzip 应答
						import web.rest.github;

						var text;
						var callOk,ret = ..call(
							function(){
								// GitHub 用专用接口（可读取网页形式的 blob 链接）
								if( string.indexOf(u,'github.com')
									|| string.indexOf(u,'raw.githubusercontent.com') ){
									var gh = web.rest.github.getContent(u);
									if(gh) return gh;
								}
								var http = inet.http();
								http.setTimeouts(c,s,r);
								return http.get(u);
							},null
						);
						if(callOk && type(ret)==type.string && #ret) text = ret;

						// 失败也写一个非 null 值（空串），表示「已完成」，
						// 否则收割端无法区分「还没完成」与「完成了但失败」。
						..thread.set(key, text ? text : '');
					}, list[k], key, cTimeout, sTimeout, rTimeout
				);
			}

			// 收割这一批：谁先完成谁先取走（thread.get 是非阻塞读取）
			var pending = [];
			for(k=start;stop;1) ..table.push(pending,k);

			while(#pending){
				var stillPending = [];
				for(i=1;#pending;1){
					var k = pending[i];
					var text = ..thread.get(keys[k]);
					if(text === null){	// 尚未完成
						..table.push(stillPending,k);
						continue;
					}
					..thread.set(keys[k],null);	// 立即释放跨线程共享区内存
					if(type(text)==type.string && #text) out[list[k]] = text;
				}
				if(#stillPending == #pending){
					// 本批尚无任何结果：稍等片刻。
					// thread.delay 会泵界面消息，所以等待期间界面不卡、进度框照常动画。
					..thread.delay(20);
				}
				pending = stillPending;
			}
		}
	};

	// 第一轮：并发抓取。
	// 超时必须放宽：串行时每个请求独占带宽，4 秒连接 / 6 秒接收就够；
	// 但并发时分摊带宽（实测 8 并发下 43KB 的页面在 6 秒接收超时内下不完，
	// 8 个里有 2 个超时失败），放宽后实测 8/8 成功，而且总耗时反而更短。
	runPass(urlList,concurrency,8000,15000,15000,result);

	// 第二轮：只重试失败的（更宽松的超时、更低的并发）。
	// 遵循「宁导错，不错过」—— 个别死链重试一次仍失败才放弃。
	if(retry !== false){
		var failed = [];
		for(i=1;#urlList;1){
			if(!result[urlList[i]]) ..table.push(failed,urlList[i]);
		}
		if(#failed){
			..debug.log.print('[并行抓取] 第一轮失败',#failed,'个，正在重试 ...');
			var retried = {};
			runPass(failed,..math.min(concurrency,4),10000,20000,20000,retried);
			for(u,text in retried){ result[u] = text }
		}
	}

	return result;
};
// 抓取订阅源（界面线程用）：相对路径补全 + 可选进度提示 + 记录响应指纹
// 参数 @url 订阅源网址（支持 http:// https:// 以及单斜杠开头的 GitHub 相对路径）
// 参数 @showProgress 为真时显示进度对话框（需要 ..mainForm，仅界面线程可用）
// 返回：抓取到的字符串；失败返回 null
fetchSubscription = function(url,showProgress){
	if(type(url)!=type.string) return null;
	url = ..string.trim(url);
	if(!#url) return null;

	// 单斜杠开头的相对路径：按 GitHub 规则补全域名
	if( ..string.match(url,"^\s*/\N+\s*$") ){
		if(!..string.find(url,"/<blob>|<raw>")){
			url = ..inet.url.append("https://raw.githubusercontent.com",url);
		}
		else {
			url = ..inet.url.append("https://github.com",url);
		}
	}

	// 进度提示框的生命期由调用方决定：
	//   updateSubscription 会让它覆盖「整个订阅源的处理过程」，所以那里传 showProgress=false，
	//   由它自己开关进度框；这里只在「单独调用本函数」时才自己开一个。
	var form;
	if(showProgress) form = openSubscribeProgressDlg(url);

	// 放到独立线程执行，避免抓取期间冻结界面（win.invoke 等待时会泵消息）
	var content = ..win.invoke( fetchUrlRaw, url );

	closeSubscribeProgressDlg(form);
	// 记录响应指纹，供自动更新时判断内容是否变化
	if(content){
		_subscriptionResponseCache[url] = ..string.crc32(content);
	}

	return content;
};

// ==========================================================================
// 【获取+解析】从订阅源网址导入节点（= fetchSubscription + importFromString）。
// 供所有「手上只有网址」的调用点使用。
// 参数 @url 订阅源网址；@subps 可选订阅备注名
// 返回：节点数组；失败返回 null
// ==========================================================================
importFromUrl = function(url,subps){
	var data = fetchSubscription(url,true);
	if(!data) return null;
	return importFromString(data,url,subps);
};

//导入节点
importFromString = function(str,subscribeUrl,subps){
	import debug
	import debug.log
	import console
	//debug.debug();
//	debug.log.print("从"+str);
	var tempForDebugLog = str;
	
	if(!str){ return; }
	str = ..string.trim(str);//从字符串首尾清除所有空白字符

	// ======================================================================
	// 【重要】本函数只解析节点数据，永不发起网络请求。
	//
	// 唯一的例外是「整串就是一条订阅源网址」：
	//   单行 + 形如 http(s)://主机[:端口]/...  → 发日志后直接返回（不解析）
	// 其余情况（单行但不是网址形态、以及所有多行数据）一律送进下面的解析流程，
	// 每一行都按节点协议解析 —— 原则是「宁导错，不错过」。
	//
	// 需要「从网址获取数据」时请改用：
	//     fetchSubscription(url)   → 只获取
	//     importFromUrl(url)       → 获取 + 解析
	//     updateSubscription(...)  → 批量更新订阅
	// ======================================================================
	if( isSubscribeUrl(str) ){
		debug.log.print("importFromString 收到订阅源网址，本函数只解析节点数据，已跳过:",str);
		return;
	}
	
	//debug.debug() 
	
//Base64格式数据解码
// 【模式匹配】判断整串是否只由 base64 或 hex 字符与空白组成。^=串首；\w=字母数字下划线；=+/-_ 为额外允许字符；\s*$=结尾空白。用于识别 Base64 编码的订阅内容
	if(..string.match(str,"^\s*[\w=+/-_]+\s*$")){//所有的内容只包含 空白字符、字母和数字、以及下划线和=+/-_的话
				
		//debug.debug();
				
		str = ..crypt.decodeBin(str);//Base64或hex解码

		if(!str) return;
	}		
//从 yaml 格式导入 clash 配置（proxy-providers 远程订阅 + proxies 本地节点）
// 【模式匹配】检测 YAML 中的 proxy-providers / proxies 段落。[\r\n]*=任意个回车换行；\s*=任意空白；\:=字面冒号
//
// ★ 性能：先用 string.indexOf 做字面预筛，再跑模式匹配。
//   这个模式本身只是「整串是否含 xxx:」，但模式引擎会逐字节扫描整串，
//   实测 188KB 的订阅文件要 375 毫秒（纯浪费）。indexOf 是原生实现，几乎零成本。
//
// ★★ 两段可能同时存在（很多订阅 = 远程 provider + 本地节点）。
//    旧实现只要 provider 里提取到网址就直接 return，会把本地节点整段丢掉
//    （实测：两段都有的配置返回 0 个节点）。现在两段都处理并合并。
	var hasProvider = ..string.indexOf(str,"proxy-providers") && ..string.match(str,"[\r\n]*proxy-providers\s*\:");
	var hasProxies = ..string.indexOf(str,"proxies") && ..string.match(str,"[\r\n]*proxies\s*\:");

	if( hasProvider || hasProxies ){
		var clashMerged = ..table.array();
		var clashHandled = false;

		//① proxy-providers：其中的 url 是「订阅源网址」，需要联网抓取
		if( hasProvider ){
			var urlmap = importFromClash(str,false);
			if(#urlmap){
				// 注意：解析可能在后台线程执行，此时 ..mainForm 为 null，
				// 因此这里只写日志，不做任何界面提示。
				debug.log.print('发现了 '+#urlmap+' 个订阅，正在导入中');
				clashHandled = true;
				for(i=1;#urlmap;1){
					var impOutbounds = importFromUrl(urlmap[i]);
					if(impOutbounds){
						..table.append(clashMerged,impOutbounds);
					}
				}
			}
		}

		//② proxies：本文件内的节点
		if( hasProxies ){
			var localNodes = clashNodesToOutbounds(str,subscribeUrl);
			if( localNodes ){
				clashHandled = true;
				..table.append(clashMerged,localNodes);
			}
		}

		if( clashHandled ){
			return clashMerged;
		}
	}

    
    
    //debug.debug()
    
//解析json格式
	//------------------------------------------------------------------
	// 整体 JSON 解析：只要首字符是 { 或 [ 就整体尝试解析一次
	// （web.json.tryParse 解析失败会返回 null，所以这样判定是安全的）
	//
	// 为什么不再用「含多个 {} 组就排除」的启发式判断：
	//   那种判断会把 sing-box 这类「天然含大量嵌套对象」的完整配置排除掉，
	//   导致它永远走不到下面的 JSON 分支。只看首字符既简单又不会漏。
	//------------------------------------------------------------------
	var jsonData;
	var jsonHead = ..string.trim(str);
	var jsonFirst = jsonHead[1];

	if( jsonFirst && (jsonFirst == 0x7B/*{*/ || jsonFirst == 0x5B/*[*/) ){
		//如果传参有subscribeUrl
		if(subscribeUrl){
			var crc32 = ..string.crc32(str);
			_subscriptionResponseCache[subscribeUrl] = crc32;
		}
		jsonData = ..web.json.tryParse(str);
	}
	
	
//检查传入参数是否是一个数组(表)
	if( ..table.isArray(jsonData) ){  //是一个数组的话就逐个解析
			
		//debug.debug();
		
		for(i=#jsonData;1;-1){
			if( !validOutbound(jsonData[i]) ) {//如果没有解析到节点信息就删除
				..table.remove(jsonData,i);
				continue;	// 已经删除，不能再访问 jsonData[i]（删的是最后一项时为 null，赋值会报错）
			} 

			if(subscribeUrl)jsonData[i].subscribeUrl = subscribeUrl;
				if(subps && type(subps)==type.string) jsonData[i].subps = subps;
				else jsonData[i].subps = "无订阅";
		}

		return jsonData;
	}
	elseif( type(jsonData) == type.table ){ //是表的话直接解析
			
		//debug.debug();
		
		//从 Clash 的 JSON 配置导入（顶层含 proxies 数组）
		//（有些订阅源/转换器输出的是「Clash JSON」而不是 YAML，必须也能吃下）
		if( type(jsonData[["proxies"]])=="table" && #jsonData[["proxies"]] ){
			var cjOutbounds = clashProxiesToOutbounds(jsonData[["proxies"]],subscribeUrl);
			if(#cjOutbounds) return cjOutbounds;
		}

		//从 sing-box 配置导入（顶层含 outbounds 数组）
		if( ..table.isArrayLike(jsonData[["outbounds"]]) && #jsonData[["outbounds"]] ){
			var sbOutbounds = importFromSingbox(jsonData);
			if(#sbOutbounds){
				for(i=1;#sbOutbounds;1){
					if(subscribeUrl) sbOutbounds[i].subscribeUrl = subscribeUrl;
					if(subps && type(subps)==type.string) sbOutbounds[i].subps = subps;
					else sbOutbounds[i].subps = "无订阅";
				}
				return sbOutbounds;
			}
		}

		if( jsonData[["servers"]] ){//从ss-rust的配置文件添加节点

			var servers = jsonData[["servers"]];
			var outbounds = ..table.array();
			for i,v in ..table.eachIndex(servers){
				var outbound = ..table.assign(,v);
				if(outbound.protocol === null){
					outbound.protocol = (outbound.server_port&&outbound.password) ? "shadowsocks":"vless"
				}

				if(outbound.remarks){
					outbound.ps = outbound.remarks;
					outbound.remarks = null;
				}

				if(outbound.server){
					outbound.address = outbound.server;
					outbound.server = null;
				}

				if(outbound.server_port){
					outbound.port = outbound.server_port;
					outbound.server_port = null;
				}

				if(outbound.password){
					if(outbound.id){
						outbound.serverId = outbound.id;
					}
					outbound.id = outbound.password;
					outbound.password = null;
				}

				if(outbound.method){
					outbound.security = outbound.method;
					outbound.method = null;
				}

				if(subscribeUrl)outbound.subscribeUrl = subscribeUrl;
					if(subps && type(subps)==type.string) outbound.subps = subps;
					else outbound.subps = "无订阅";
				..table.push(outbounds,outbound);
			}

			return outbounds;
		}
		else {
			if( validOutbound(jsonData) ) {
				if(subscribeUrl)jsonData.subscribeUrl = subscribeUrl;
					if(subps && type(subps)==type.string) jsonData.subps = subps;
					else jsonData.subps = "无订阅";
				return {jsonData};
			}
		} 
	}



//从分享链接导入节点
	var outbounds = ..table.array();
	//按行拆分字符串并逐个解析
	
	//分析有效行是否成功解析
	//debug.debug()
/*
	var counttest = #outbounds	: 0
	var ddf = ..string.splitEx(str,);
	var fd = #ddf
	var i = 0;
	var j = 0; 
	debug.log.print(str)
*/
	
	for(line in ..string.lines(str) ){
		// http(s) 代理链接：直接产出节点对象并入库，不再经过 httppx:// 中间表示。
		// 多行数据里的 http://host:port 行若不在这里处理，会一路穿到循环末尾被丢弃。
		var httpProxyNode = toHttpProxyNode(line);
		if(httpProxyNode){
			httpProxyNode.subscribeUrl = subscribeUrl;
			..table.push(outbounds,httpProxyNode);
			continue;
		}
		//console.dump(line)
				//debug.log.print()
		//debug.debug();
		
/*
		if(i==j ){ 
			if(counttest != #outbounds) debug.log.print("i=",i,ddf[i])
			else {
				counttest = #outbounds
			}
			
		}
		else {
			j= i;
		}		
		i++;
*/
		
		
		/*
		if(#outbounds>=10000){
			// 注意：解析可能在后台线程执行，不能依赖 ..mainForm，这里只写日志。
			debug.log.print("导入的节点数目过多，已导入10000个节点并中止操作！");
			return outbounds;
		}
		*/

		if(line[1]=='/'# && line[2]=='/'#){//跳过注释行
			continue;
		}
		
		//j++;
		
		//Kitsunebi格式vmess链接(来自于v2rayN源码)
// 【模式匹配】匹配 Kitsunebi 格式的 vmess 链接。vmess\:\/\/=字面 vmess://；([\w=+/-_]+)?=可选的 base64 段；<\S*>=非捕获分组，匹配其后所有非空白字符
		var vmessKitsunebi,info = ..string.match(line,`vmess\:\/\/([\w=+/-_]+)?(\S*)`);
		if(vmessKitsunebi){
			var data = ..crypt.decodeBin(vmessKitsunebi);
// 【模式匹配】按 @ 把内容拆成两段（段1 含主机与端口，段2 含 id 与 aid）；'@' 为字面分隔符，不做模式匹配
			var data = ..string.split(data,'@');
			if(#data == 2){
// 【模式匹配】把段1 按冒号拆成 主机 与 端口
				var data1 = ..string.split(data[1],':');
// 【模式匹配】把段2 按冒号拆成 id 与 aid（额外 ID）
				var data2 = ..string.split(data[2],':');
				if(#data1 == 2 && #data2 == 2){
					var outbound={
						protocol = "vmess";
						address = data2[1];
						port = tonumber(data2[2]);
						security = data1[1];
						id = data1[2];
						network = "tcp";
					};
					if(info){
// 【模式匹配】把参数串按 & 拆成多段
						info = ..string.split(info,'&');
// 【模式匹配】从第一段提取 remarks= 之后的内容。\S*=一个或多个非空白字符
						remarks = ..string.match(info[1],"remarks=(\S*)");
						outbound.ps = ..inet.url.decode(remarks);
// 【模式匹配】从第二段提取 alterId= 之后的数字。\d*=零个或多个数字
						alterId = ..string.match(info[2],"alterId=(\d*)");
						outbound.alterId = tonumber(alterId);
					}

					outbound.type = "none";
					outbound.subscribeUrl = subscribeUrl;
					..table.push(outbounds,outbound);
					continue;
				}
			}
		}
// 【模式匹配】匹配标准 vmess 链接（uuid@主机:端口）。[^\@\s]+=不含 @ 与空白的 uuid；[^\?\#\s\:]+=不含 ? # 空白 冒号的主机；<\:\d+>* 中 <> 是非捕获分组，* 表示整个「冒号+数字」出现任意次（可有可无）；\S* 匹配剩余部分
		var vmess2 = ..string.match(line,`vmess\:\/\/[^\@\s]+\@[^\?\#\s\:]+<\:\d+>*\S*`);
		
		if( vmess2 ) {
			var vmessUrl = ..inet.url.split(vmess2) 
			if(vmessUrl && vmessUrl.user && vmessUrl.host && vmessUrl.port){
				var outbound = {
					address = vmessUrl.host;
					port = tonumber(vmessUrl.port) : 443; 
					id = vmessUrl.user;
					network = "tcp";
					protocol = "vmess";
					tls = "tls";
				};

				if(vmessUrl.extraInfo){
					var info = ..inet.url.splitParameters(vmessUrl.extraInfo);
					outbound.sni = info.sni;
					outbound.host = info.host;
					outbound.path = info.path;
					outbound.security = info.encryption;
					outbound.seed = info.seed; 
					outbound.key = info.key; 

					outbound.network = info.type;
					outbound.type = info.headertype; //kcp || quic

					if(info.security) outbound.tls = info.security;
					if(info.flow) outbound.flow = info.flow;
					var insecure = info.allowinsecure;
					if(insecure!==null) {
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="")
					}
					if(info.disablesessionresumption) outbound.disableSessionResumption = info.disablesessionresumption;
					if(info.alpn) outbound.alpn = info.alpn;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
				}

				if(vmessUrl.location){
					outbound.ps = ..inet.url.decode(vmessUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//v2rayN格式vmess链接
// 【模式匹配】匹配 v2rayN 格式的 vmess 链接（vmess:// 后为 base64 串）。[\w=+/-_]+=base64 字符集
		var vmess = ..string.match(line,`vmess\:\/\/([\w=+/-_]+)`);
		if( vmess ) { 
			var json = ..crypt.decodeBin(vmess);	
			var outbound = ..web.json.tryParse(json);	
			if(type(outbound)=="table"){
				..table.clear(outbound@._defined);
				outbound.protocol = "vmess";
				outbound.address = outbound.add;
			outbound.port = tonumber(outbound.port);
				outbound.alterId = tonumber(outbound.aid);
				// v2rayN 格式：scy 为加密方式，缺省 auto
				outbound.security = outbound.scy : "auto";
				outbound.network = outbound.net : "tcp";
				outbound.net = null;
				outbound.add = null;
				outbound.aid = null;
				outbound.v = null;
				outbound.subscribeUrl = subscribeUrl;

				if(outbound.ps){
// 【模式匹配】从备注中提取 user@host:port。(.+)=贪婪匹配用户名；\@=字面 @；(.+)=主机；\:(\d+)=冒号加端口号
					var u,h,p = ..string.match(outbound.ps,"(.+)\@(.+)\:(\d+)")
					if(u&&h&&p){
// 【模式匹配】判断是否为 justmysocks 订阅。justmysocks\d+\.net 中 \d+=一个以上数字，\.=字面点号
						if(h && ..string.endWith(h,"jamjams.net") && subscribeUrl && ..string.match(subscribeUrl,"justmysocks\d+\.net")){
// 【模式匹配】判断字符串是否为 IPv4 形式。^\d+=串首的数字段；\.=字面点号；$=串尾
							if(..string.match(outbound.address,"^\d+\.\d+\.\d+\.\d+$") ){
								outbound.address = h;
							}
						}
						outbound.ps = h;
					}	
				}
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//官方格式vless链接
// 【模式匹配】匹配 vless 链接。vless\:\/\/=字面 vless://；\S+=其后所有非空白字符
		var vless = ..string.match(line,`vless\:\/\/\S+`);
		if( vless ) {
			var vlessUrl = ..inet.url.split(vless) 
			// 按 VLESS URI 规范 uuid 段是必填的，但部分订阅源里的链接省略了它
			// （形如 vless://主机:端口?type=ws&security=tls）。
			// 为了让这类节点也能导入而不是被静默丢弃，这里只要求主机与端口，uuid 取不到时留空。
			if(vlessUrl && vlessUrl.host && vlessUrl.port){
				var outbound = {
					address = vlessUrl.host;
					port = tonumber(vlessUrl.port) : 443; 
					id = decodeUser(vlessUrl.user);
					network = "tcp";
					protocol = "vless";
					tls = "tls";
				};

				if(vlessUrl.extraInfo){
					var info = ..inet.url.splitParameters(vlessUrl.extraInfo);
					outbound.sni = info.sni;
					outbound.host = info.host;
					outbound.path = info.path;
					outbound.security = info.encryption;
					outbound.seed = info.seed; 
					outbound.key = info.key; 

					outbound.network = info.type;
					outbound.type = info.headertype; //kcp || quic

					if(info.security) outbound.tls = info.security;
					if(info.flow) outbound.flow = info.flow;
					var insecure = info.allowinsecure;
					if(insecure!==null) {
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="")
					}
					if(info.disablesessionresumption) outbound.disableSessionResumption = info.disablesessionresumption;
					if(info.alpn) outbound.alpn = info.alpn;

					// —— VLESS 官方 URI 规范字段补全（REALITY / XHTTP / gRPC 等）——
					if(info.pbk) outbound["public-key"] = info.pbk;
					if(info.sid) outbound["short-id"] = info.sid;
					if(info.spx) outbound["spider-x"] = info.spx;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.servicename) outbound.grpcSni = info.servicename;
					if(info.mode) outbound.mode = info.mode;
					if(info.authority) outbound.authority = info.authority;
					if(info.packetencoding) outbound.packetEncoding = info.packetencoding;
				}

				if(vlessUrl.location){
					outbound.ps = ..inet.url.decode(vlessUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}

		//hysteria2 链接（兼容 hy2:// 简写）
// 【模式匹配】匹配 hysteria2 或 hy2 链接。\S+=全部非空白字符；: 是假值合并运算符，左边为 null 时取右边
		var hy = ..string.match(line,`hysteria2\:\/\/\S+`) : ..string.match(line,`hy2\:\/\/\S+`);
		if( hy ) {
			var hyUrl = ..inet.url.split(hy)
			if(hyUrl && hyUrl.host && hyUrl.port){
				var outbound = {
					address = hyUrl.host;
					port = tonumber(hyUrl.port) : 443;
					id = decodeUser(hyUrl.user);
					network = "hysteria";
					protocol = "hysteria2";
					tls = "tls";
				};

				if(hyUrl.extraInfo){
					var info = ..inet.url.splitParameters(hyUrl.extraInfo);
					outbound.sni = info.sni;
					outbound.obfs = info.obfs;
					if(info["obfs-password"]) outbound["obfs-password"] = info["obfs-password"];
					// 注意：inet.url.splitParameters 会把参数名转为小写
					var pin = info.pinsha256 : info.pinSHA256;
					if(pin) outbound.pinnedPeerCertSha256 = pin;
					var insecure = info.insecure : info.allowinsecure;
					if(insecure !== null) outbound.allowInsecure = (insecure !== "0" && insecure !== "false");
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.alpn) outbound.alpn = info.alpn;
				}

				if(hyUrl.location){
					outbound.ps = ..inet.url.decode(hyUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			}

			continue;
		}

		//ss链接
// 【模式匹配】匹配 ss 链接并分离备注。[^\s\#]+=不含空白与 # 的主体；<#\S+>? 中 <> 是非捕获分组，? 表示「#+非空白字符」这一段可有可无
		var ss,comment = ..string.match(line,`ss\:\/\/([^\s\#]+)(<#\S+>?)`);
		if( ss ) { 
			// SIP002 允许在链接尾部带查询串（?plugin=...&sni=...）。
			// 必须先剥离，否则「主机:端口」的匹配会把参数当成地址的一部分而解析出错。
			var ssParam = ..string.match(ss, `\?(.*)$`);
			if(ssParam) ss = ..string.left(ss, #ss - #ssParam - 1);
// 【模式匹配】识别直接在链接中写明的 userinfo@主机:端口。^=串首；([^:]+)=不含冒号的 userinfo；(.+)=主机；\:(\d+)=端口
			var userinfo,address,port = ..string.match(ss,"^([^:]+)\@(.+)\:(\d+)")	
			if(!(userinfo&&address&&port)){
				var str = ..crypt.bin.decodeUrlBase64(ss); 
				if(str){ ss = str; } 

// 【模式匹配】识别未编码形式的 ss 内容 method:password@主机:端口。^(.+)\:=方法名直到最后一个冒号；(.+)\@=密码直到 @
				method,password,address,port = ..string.match(ss,"^(.+)\:(.+)\@(.+)\:(\d+)")
			}
			else {
				userinfo = ..crypt.bin.decodeUrlBase64(userinfo); 
				if(userinfo){
// 【模式匹配】把 userinfo 拆成 method 与 password。^(.+)\:=方法；(.+)$=其余全部作为密码
					method,password = ..string.match(userinfo,"^(.+)\:(.+)$")
				}	
			}

			if(address && password && port){
				var outbound = {
					address = address;
					port = tonumber(port);
					security = method;
					id = password;
					network = "tcp";
					protocol = "shadowsocks"
				};
				// —— SIP002 查询参数 ——
				// plugin 是 SIP002 的标准参数，格式为「插件名;选项1=值1;选项2=值2」；
				// sni / tls / fp / allowInsecure / group 等属于各客户端的常用扩展字段。
				// 数据源里给出的字段一律导入，避免漏字段导致节点信息不完整。
				if(ssParam){
					var sp = ..inet.url.splitParameters(ssParam);
					if(sp){
						if(sp.plugin){
							var pn,po = ..string.match(sp.plugin, "^([^;]+);?(.*)$");
							if(pn) outbound.plugin = pn;
							if(po && #po) outbound.pluginOptions = po;
						}
						if(sp.sni) outbound.sni = sp.sni;
						if(sp.tls) outbound.tls = sp.tls;
						if(sp.fp) outbound["client-fingerprint"] = sp.fp;
						var insec = sp.allowinsecure;
						if(insec !== null) outbound.allowInsecure = (insec != "0" && insec != "false");
						// 其余未识别的参数原样保留，确保不漏字段
						for(k,v in sp){
							if(k != "plugin" && outbound[k] === null) outbound[k] = v;
						}
					}
				}

				if(comment){
					comment = ..string.right(comment,-2);
					comment = ..inet.url.decode(comment);
// 【模式匹配】从备注中提取 user@host:port，规则同前
					var u,h,p = ..string.match(comment,"(.+)\@(.+)\:(\d+)")
					if(u&&h&&p){
// 【模式匹配】判断是否 justmysocks 订阅，规则同前
						if(h && ..string.endWith(h,"jamjams.net") && subscribeUrl && ..string.match(subscribeUrl,"justmysocks\d+\.net")){
// 【模式匹配】判断是否为 IPv4 格式，规则同前
							if(..string.match(outbound.address,"^\d+\.\d+\.\d+\.\d+$") ){
								outbound.address = h;
							}
						}

						comment = h;
					}

					outbound.ps = comment;
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//trojan链接
// 【模式匹配】匹配 trojan 链接。trojan\:\/\/=字面 trojan://；\S+=其后所有非空白字符
		var trojan = ..string.match(line,`trojan\:\/\/\S+`);
		if( trojan ) {
			var trojanUrl = ..inet.url.split(trojan) 
			if(trojanUrl && trojanUrl.user && trojanUrl.host){
				var outbound = {
					address = trojanUrl.host;
					port = tonumber(trojanUrl.port) : 443; 
					id = decodeUser(trojanUrl.user);
					network = "tcp";
					protocol = "trojan"
				};

				if(trojanUrl.extraInfo){
					var info = ..inet.url.splitParameters(trojanUrl.extraInfo);
					outbound.sni = info.sni || info.peer;

					outbound.host = info.host;
					outbound.path = info.path;

					if(info.type && info.type!=="original"){
						outbound.network = info.type;
						if(outbound.network=="h2"){
							outbound.network="http"
						}
					}

					// trojan 链接的 security 表示传输安全（tls/reality/xtls），encryption 才是加密方式。
					// 原写法在同时带 encryption 参数时会丢掉 TLS，导致往返后节点不可用。
					var tSec = info.security;
					if(tSec=="tls" || tSec=="reality" || tSec=="xtls") outbound.tls = tSec;
					if(info.encryption) outbound.security = info.encryption;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.alpn) outbound.alpn = info.alpn;
					var insecure = info.allowinsecure;
					if(insecure!==null) outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="");
				}

				if(trojanUrl.location){
					outbound.ps = ..inet.url.decode(trojanUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//trojan-go链接
// 【模式匹配】匹配 trojan-go 链接，规则同上
		var trojan = ..string.match(line,`trojan-go\:\/\/\S+`);
		if( trojan ) {
			var trojanUrl = ..inet.url.split(trojan) 
			if(trojanUrl && trojanUrl.user && trojanUrl.host){
				var outbound = {
					address = trojanUrl.host;
					port = tonumber(trojanUrl.port) : 443; 
					id = decodeUser(trojanUrl.user);
					network = "tcp";
					protocol = "trojan-go"
				};

				if(trojanUrl.extraInfo){
					var info = ..inet.url.splitParameters(trojanUrl.extraInfo);
					outbound.sni = info.sni || info.peer;
					outbound.host = info.host;
					outbound.path = info.path; 
					var insecure = info.allowinsecure;
					if(insecure!==null) {
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="") 
					}

					if(info.type && info.type!=="original"){
						outbound.network = info.type;
						if(outbound.network=="h2"){
							outbound.network="http"
						}
					}

					outbound.security = info.encryption; 
					// 补齐传输安全与指纹字段（与 trojan 分支保持一致，避免漏字段）
					var tgSec = info.security;
					if(tgSec=="tls" || tgSec=="reality" || tgSec=="xtls") outbound.tls = tgSec;
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.alpn) outbound.alpn = info.alpn;
				}

				if(trojanUrl.location){
					outbound.ps = ..inet.url.decode(trojanUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//ssr链接
// 【模式匹配】匹配 ssr 链接（ssr:// 后为 base64）。[\w=+/-_]+=base64 允许的字符集
		var ssrBase64 = ..string.match(line,`ssr\:\/\/([\w=+/-_]+)`);
		if( ssrBase64 ) { 
			var ssrUrl = ..crypt.bin.decodeUrlBase64(ssrBase64);	
			if(ssrUrl){
// 【模式匹配】把 ssr 内容拆成主体与查询参数。(.+)\/\?=主体直到最后一个 斜杠+问号；(.+)=问号后的全部参数
				var ssrInfo,ssrParam = ..string.match(ssrUrl,"(.+)\/\?(.+)")
// 【模式匹配】把 ssr 主体按冒号拆成 6 个字段（冒号是字面分隔符，此处不做模式匹配）。依次为 地址、端口、协议、加密、混淆、密码
				var info = ..string.split(ssrInfo:ssrUrl,':');
				var outbound = {
					address = info[1];
					port = info[2];
					network = info[3];
					security = info[4];
					obfs = info[5]; 
					protocol = "ssr"; 
				}

				outbound.id = ..crypt.bin.decodeUrlBase64(info[6]:"");
				if(ssrParam){
					var params = ..inet.url.splitParameters(ssrParam);
					if(params){
						outbound.ps = ..crypt.bin.decodeUrlBase64(params.remarks);
						outbound.obfsParam = ..crypt.bin.decodeUrlBase64(params.obfsparam);
						outbound.networkParam = ..crypt.bin.decodeUrlBase64(params.protoparam);

						if(params.group){ 
							//outbound.subscribeGroup = ..crypt.bin.decodeUrlBase64(params.group);
						}

						if(params.ot_enable && (params.ot_enable!="0")){ outbound.tls = "tls"; } 
						outbound.path = ..crypt.bin.decodeUrlBase64(params.ot_path);
						outbound.sni = ..crypt.bin.decodeUrlBase64(params.ot_domain);
					}
				}

				outbound.subscribeUrl = subscribeUrl;

				if(outbound.address && outbound.port){
					..table.push(outbounds,outbound);
					continue;
				}
			}
		}
		//socks链接
// 【模式匹配】匹配 socks5 或 socks 链接。socks5?=socks 后可选的 5；\:=字面冒号；(\/\/\S+)=双斜杠及其后所有非空白字符
		var socks = ..string.match(line,`socks5?\:(\/\/\S+)`); 
		if( socks ) { 
			var socksUrl = ..inet.url.split("socks5:"+socks) 
			if( socksUrl && socksUrl.host && socksUrl.port){ 
				var outbound = {
					address = socksUrl.host;
					port = tonumber(socksUrl.port);
					network = "tcp";
					protocol = "socks"
				};

				if(socksUrl.user && socksUrl.password){
					outbound.id = decodeUser(socksUrl.user) ++ ":" ++ decodeUser(socksUrl.password)
				}  

				if(socksUrl.location){
					outbound.ps = ..inet.url.decode(socksUrl.location);
				}

				// socks 链接也可能带附加参数（sni / tls / fp 等扩展字段），统一导入，避免漏字段
				if(socksUrl.extraInfo){
					var sp = ..inet.url.splitParameters(socksUrl.extraInfo);
					if(sp){
						for(k,v in sp){
							if(outbound[k] === null) outbound[k] = v;
						}
					}
				}
				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//http或https链接
// 【模式匹配】匹配 proxy:// 链接（Clash 中 http(s) 代理的写法）。\S+=全部非空白字符
		var proxy = ..string.match(line,`proxy\:\/\/\S+`); 
		if( proxy ) { 
			var proxyUrl = ..inet.url.split(proxy) 
			if( proxyUrl && proxyUrl.host && proxyUrl.port){ 
				var outbound = {
					address = proxyUrl.host;
					port = tonumber(proxyUrl.port);
					network = "tcp";
					protocol = "https"
				};

				if(proxyUrl.user && proxyUrl.password){
					outbound.id = proxyUrl.user +":"+ proxyUrl.password
				} 

				if(proxyUrl.extraInfo){
					var info = ..inet.url.splitParameters(proxyUrl.extraInfo);
					if(info.tls==="none") {
						outbound.protocol = "http";
					}

					// 注意：splitParameters 会把参数名全部转为小写
					var insecure = info.allowinsecure;
					if(insecure!==null){
						outbound.allowInsecure = (insecure!=="0" && insecure!=="false" && insecure!="")
					}
				}

				if(proxyUrl.location){
					outbound.ps = ..inet.url.decode(proxyUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}

		//naive链接
// 【模式匹配】匹配 naive 链接。(naive\+(\w+)\:\/\/\S+) 分成三部分：naive\+=字面前缀；\w+=协议名（如 http/https）；\S+=其余非空白字符
		var naive,naiveNetwork = ..string.match(line,`(naive\+(\w+)\:\/\/\S+)`);
		if( naive ) {
			var naiveUrl = ..inet.url.split(naive) 
			if( naiveUrl && naiveUrl.host ){
				var outbound = {
					address = naiveUrl.host;
					port = tonumber(naiveUrl.port) : 443; 
					id = decodeUser(naiveUrl.user);
					network = naiveNetwork;
					protocol = "naive"
				};

				if(naiveUrl.user && naiveUrl.password){
					outbound.id = naiveUrl.user +":"+ naiveUrl.password
				} 

				if(naiveUrl.extraInfo){
					var info = ..inet.url.splitParameters(naiveUrl.extraInfo);
					if(info["extra-headers"]){
						outbound.headers = info["extra-headers"];
					}
				} 
				if(naiveUrl.location){
					outbound.ps = ..inet.url.decode(naiveUrl.location);
				}

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			} 

			continue;
		}
		//WireGuard 链接（Xray 26.x 原生支持该出站协议）
		//格式：wireguard://私钥@服务器:端口?publicKey=..&address=..&reserved=1,2,3&mtu=1280#备注
// 【模式匹配】匹配带查询串的 wireguard 链接。(\S+?)\?=惰性匹配到第一个问号之前；\?=字面问号；(\S+)=问号后所有非空白字符
		var wg, wgQuery = ..string.match(line,`wireguard\:\/\/(\S+?)\?(\S+)`);
// 【模式匹配】兜底：匹配不带查询串的 wireguard 链接
		if(!wg) wg = ..string.match(line,`wireguard\:\/\/(\S+)`);
		if( wg ) {
			var wgQueryStr = wgQuery;
// 【模式匹配】从已捕获的内容里再单独提取查询串，规则同 1172 行
			if(!wgQueryStr) wgQueryStr = ..string.match(wg,`\?(\S+)`);
			// 去掉查询串与备注，得到 私钥@服务器:端口
			var wgMain = wg;
			var qs = ..string.indexOf(wgMain,"?");
			if(qs) wgMain = ..string.left(wgMain,qs-1);
			var hf = ..string.indexOf(wgMain,"#");
			if(hf) wgMain = ..string.left(wgMain,hf-1);

// 【模式匹配】把 wireguard 主体拆成 私钥@主机:端口。([^\@]+)=不含 @ 的私钥；([^\:\?\#]+)=不含冒号、问号、井号的主机；\:(\d+)=冒号加端口
			var wgPriv,wgHost,wgPort = ..string.match(wgMain,`^([^\@]+)\@([^\:\?\#]+)\:(\d+)`);
			if(!wgHost){
// 【模式匹配】wireguard 主体不含私钥时的形式：主机:端口
				wgHost,wgPort = ..string.match(wgMain,`^([^\:\?\#]+)\:(\d+)`);
			}
			if(wgHost){
				var outbound = {
					address = wgHost;
					port = tonumber(wgPort) : 51820;
					network = "tcp";
					protocol = "wireguard";
				};
				if(wgPriv) outbound["private-key"] = ..inet.url.decode(wgPriv);
				if(wgQueryStr){
					var info = ..inet.url.splitParameters(wgQueryStr);
					outbound["public-key"] = info.publickey : info["public-key"];
					outbound["pre-shared-key"] = info.presharedkey : info["pre-shared-key"];
					outbound["local-address"] = info.address : info.ip;
					if(info.ipv6) outbound.ipv6 = info.ipv6;
					if(info.mtu) outbound.mtu = tonumber(info.mtu);
					if(info.keepalive) outbound.keepAlive = tonumber(info.keepalive);
					if(info.domainstrategy) outbound.domainStrategy = info.domainstrategy;
					if(info.reserved){
						var arr = ..table.array();
// 【模式匹配】逐个提取 reserved 中的所有数字串。gmatch 会循环匹配，\d+=一个以上数字
						for(n in ..string.gmatch(info.reserved,`\d+`)) ..table.push(arr,tonumber(n));
						if(#arr) outbound.reserved = arr;
					}
					var aips = info.allowedips : info["allowed-ips"];
// 【模式匹配】按逗号拆分 allowed-ips（逗号是字面分隔符，不做模式匹配）
					if(aips) outbound["allowed-ips"] = ..string.split(aips,',');
				}
// 【模式匹配】提取 # 之后的备注。(\S*)$=行尾的非空白字符（可为空）
				var wgFrag = ..string.match(line,`\#(\S*)$`);
				if(wgFrag) outbound.ps = ..inet.url.decode(wgFrag);

				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			}
			continue;
		}

		//其他协议（真兜底）：只要形如 scheme:// 就按协议规范完整导入并保留全部字段。
		//注意：这里「认识」不等于「内核支持」——生成配置时 ensureSupportedOutbound
		//会按 xray.protocols.xrayNative 统一降级为 blackhole，避免整份配置加载失败。
		//这样将来新增协议（anytls / tuic / ...）无需改动本文件即可导入。
		//
		//★ 这里刻意不排除 http/https：专用 http 分支要求「域名后不带路径」，
		//  大小写变体（HTTP:// Http://）与带路径写法不会命中它，只能由这里兜住，
		//  排除它们会导致节点丢失（原则：宁导错，不错过）。
// 【模式匹配】匹配其他协议的通用链接。^\s*=开头空白；([a-zA-Z][a-zA-Z0-9\-\.\+]*)=协议名（首字母开头，后可含字母数字与 - . +）；\:\/\/=字面 ://；(\S+)$=其余非空白字符
		var otherScheme,otherBody = ..string.match(line,`^\s*([a-zA-Z][a-zA-Z0-9\-\.\+]*)\:\/\/(\S+)$`);
		if(otherScheme){
			otherScheme = ..string.lower(otherScheme);
			var oUrl = ..inet.url.split(otherScheme ++ "://" ++ otherBody);
			if(oUrl && oUrl.host){
				// Xray 的 hysteria 协议仅支持 version=2（即 hysteria2），
				// 单独的 hysteria:// 链接是 v1，标记为 hysteria1 以便明确降级（而不是按 v2 错误生成）
				var protocolName = otherScheme;
				if(otherScheme=="hysteria") protocolName = "hysteria1";
				var outbound = {
					address = oUrl.host;
					port = tonumber(oUrl.port) : 443;
					network = "tcp";
					protocol = protocolName;
				};
				if(oUrl.user) outbound.id = decodeUser(oUrl.user);
				if(oUrl.password) outbound.password = ..inet.url.decode(oUrl.password);
				if(oUrl.extraInfo){
					var info = ..inet.url.splitParameters(oUrl.extraInfo);
					for(k,v in info){ if(outbound[k]===null) outbound[k] = v; }
					if(info.fp) outbound["client-fingerprint"] = info.fp;
					if(info.allowinsecure!==null) outbound.allowInsecure = (info.allowinsecure!=="0" && info.allowinsecure!=="false");
				}
				if(oUrl.location) outbound.ps = ..inet.url.decode(oUrl.location);
				outbound.subscribeUrl = subscribeUrl;
				..table.push(outbounds,outbound);
			}
			continue;
		}

		//clashJson格式
		//debug.debug();
// 【模式匹配】匹配 clash 的 JSON 行。^\s*-\s*=开头空白加减号再加空白；(%\{\})=% 转义后的字面 {}；\s*$=结尾空白
		var clashJson = ..string.match(line,`^\s*-\s*(%\{\})\s*$`);
		if( clashJson ) {
			//debug.debug();
			//var outbound = ..web.json.parse(line);
			var outbound  = ..web.json.tryParse(clashJson)
			if(type(outbound)=="table"){
				if(outbound.type){
					if(outbound.type=="ssr"){
						outbound.network = 	outbound.protocol;	
						outbound.protocol = "ssr";	

						outbound.networkParam = outbound.protocol_param;
						outbound.protocol_param =  null;

						outbound.sni = outbound.ot_domain;
						outbound.path = outbound.ot_path;
						outbound.tls = outbound.ot_enable ? "tls" : null;  
					}

					if(outbound.type=="ss"){
						outbound.type =	"shadowsocks";
						outbound.network = "tcp";			
					}
					outbound.protocol = outbound.type;
					outbound.type = null;
				}
			
			//debug.debug();
			//debug.log.print(outbound)
			//console.dump(outbound);
			
			
			//var test1  = validOutbound(outbound) ; 
			//console.dump(test1);
			 
				//if( validOutbound(outbound) ){
				validOutbound(outbound)
				if( outbound.address ){
					
					//console.dump(outbound);
					
					outbound.subscribeUrl = subscribeUrl; 
					..table.push(outbounds,outbound );
					
					//console.dump(outbounds); 
				}
				continue;
			}
		}
		//json格式
// 【模式匹配】匹配纯 JSON 对象行。^\s*=开头空白；(%\{\})=字面 {}；\s*$=结尾空白
		var json = ..string.match(line,`^\s*%\{\}\s*$`);
		if( json ) {
			var outbound  = ..web.json.tryParse(json)
			if(type(outbound)=="table"){
				if( validOutbound(outbound) ) ..table.push(outbounds,outbound );
				continue;
			}
		}
	}
/*
	if(!#outbounds) {
		//console.dump(str);
		debug.log.print("从"+tempForDebugLog+"抓取到"+#outbounds+"个服务器");
	}
*/
		
		//debug.log.print("抓取到"+#outbounds+"个服务器");
	return outbounds;
}

//从剪贴板导入节点或订阅,（订阅配置页面使用）
importFromClipboard  = function(refreshConfig){
    import win.clip;
	var str = ..win.clip.read();

    if( refreshConfig===false ){
		if(!str){return;}

		str = ..string.trim(str,'"\'\t\r\n ');//从字符串首尾清除指定的一个或多个单字节字符（"'制表符(横向跳格) 回车换行 ）

		// 订阅源网址 → 抓取 + 解析；其余一律当节点数据解析。
		if( isSubscribeUrl(str) ){
			return importFromUrl(str);
		}

		return importFromString(str);
    }
	else{
		if(str){
			str = ..string.trim(str,'"\'\t\r\n '); //（"'制表符(横向跳格) 回车换行 ）
			if( isSubscribeUrl(str) ){
				if( updateSubscription({[str]=true}) ){return true}
				else {return false}
			}

			var impoutbounds = importFromString(str);
			if(#impoutbounds){
				var count = #impoutbounds;
				..config.proxy.outbounds = ..table.append(impoutbounds,..config.proxy.outbounds);
				..config.proxy.save();
				..publish("uiCommand.restartxrayCore","obadd",#impoutbounds);
				..publish("uiCommand.restartxrayCore","change");
				..mainForm.msgOk("已成功导入" + count + "个节点",1200);
				return true; 
			}
		}
		..mainForm.msgFrown('未能导入节点或订阅！');
		//('\r\n请先复制以下格式文本（自动清除其中的无效内容）：\r\n\r\n1、一行或多行（忽略无效行）分享链接或服务器JSON配置。\r\n支持 vmess://，vless://，ss://，ssr://，trojan://， trojan-go:// 等通用分享链接。\r\n\r\n2、包含多个服务器配置的JSON数组,支持winXray格式以及通用格式JSON。\r\n\r\n3、单个 http:// 或 https:// 开头的通用订阅源地址。\r\n可直接使用浏览器地址栏的github文件地址（含blob或raw目录名）。\r\n也可以仅复制单斜杆开始的github文件路径。\r\n\r\n订阅源可用BASE64编码或明文返回以上1、2条规定的配置或分享链接。');
	}
}

validAll = function(outbounds){ 
	for(i=#outbounds;1;-1){
		if(!validOutbound(outbounds[i])){
			..table.remove(outbounds,i);
		} 
	} 

	return outbounds;
}

validOutbound = function(outbound){
	var validResult;	// 统一返回结果（try 块里的 return 退不出本函数）  
try{	
	//var outbound = outbound1 
	if(type(outbound)!="table"){ return;  }

	if(outbound.obfs_param){
		outbound.obfsParam = outbound.obfs_param;
		outbound.obfs_param = null;
	}
	
	if(outbound["obfs-param"]){
		outbound.obfsParam=outbound["obfs-param"];
		outbound["obfs-param"]=null;
	}
	
	if(outbound.aid){
		outbound.alterId = outbound.aid;
		outbound.aid = null;
	}

	if(outbound.add){
		outbound.address = outbound.add;
		outbound.add = null;
		..table.define(outbound);//清空预定义键名
	}

	if(outbound.net){
		outbound.network = outbound.net;
		outbound.net = null;
		..table.define(outbound);
	}

	if(outbound.peer ){
		if(#outbound.peer) outbound.sni = outbound.peer;
		outbound.peer = null;
		..table.define(outbound);
	}

	if(!outbound.security){
		if(outbound.method && outbound.method!="none"){
			outbound.security = outbound.method;
		}
		if(outbound.cipher && outbound.cipher!="none" && outbound.cipher!="auto"){
			outbound.security = outbound.cipher;
		}
		outbound.cipher = null;
		outbound.method = null; 
	}

	if(!outbound.address){
		if(outbound.server){
			outbound.address = outbound.server;
			outbound.server = null;
		}
	}

	if(!outbound.ps){
		if(outbound.remarks){
			outbound.ps = outbound.remarks;
			outbound.remarks = null;
		}
		elseif(outbound.name){
			outbound.ps = outbound.name;
			outbound.name = null;
		}
	} 

	if(!outbound.port){
		if(outbound.server_port){
			outbound.port = outbound.server_port;
			outbound.server_port = null; 

			if(!outbound.protocol && outbound.password){
				outbound.protocol = "shadowsocks";
			}
		}
		else {
			outbound.port=443;
		} 
	}

	if(!outbound.protocol){
		outbound.protocol = "vmess";
// 【模式匹配】查找备注中是否含 @@vless 或 @@xtls 标记。string.find 此处按字面查找，@@ 无模式含义
		if(outbound.ps && (..string.find(outbound.ps,"@@vless") || ..string.find(outbound.ps,"@@xtls"))){
			outbound.protocol = "vless";
		}
	}

	if(!outbound.id){
		if(outbound.password){
			outbound.id = outbound.password;
			outbound.password = null; 
		} 

		if(outbound.uuid){
			outbound.id = outbound.uuid;
			outbound.uuid = null; 
		} 
	}  

	if(outbound["skip-cert-verify"]){
		outbound.allowInsecure = outbound["skip-cert-verify"];
		outbound["skip-cert-verify"] = null;
	}

	if(outbound["ws-path"]){
		outbound.path = outbound["ws-path"];
		outbound["ws-path"] = null;
	}

	if(outbound["ws-headers"]){
		outbound.headers = outbound["ws-headers"];
		outbound["ws-headers"] = null; 
	}

	var grpcOpts = outbound[["grpc-opts"]];
	if( grpcOpts ){
		if(grpcOpts[["grpc-service-name"]]){
			outbound.grpcSni = grpcOpts[["grpc-service-name"]];
		}
	}

	if(type(outbound.tls)!="string"){
		if(outbound.tls) outbound.tls = "tls";
		else outbound.tls = "";
	}

	if(outbound.servername){
		outbound.host = outbound.servername;
		outbound.servername = null;
	}

/*
	import debug.log
	import console
	debug.log.print(outbound);
	console.dump(outbound)
*/

	var httpOpts = outbound["http-opts"]: outbound["h2-opts"];   

	if(httpOpts){
		if(!..table.count(httpOpts)){
			httpOpts = outbound["h2-opts"] : httpOpts; 
		}


		if(httpOpts.method){
			outbound.httpMethod = httpOpts.method;
		}		

		if(httpOpts.path){
			outbound.path = httpOpts.path;
		}

		if(httpOpts.headers){
			outbound.headers = httpOpts.headers; 
		}

		if(httpOpts.host){
			outbound.host = httpOpts.host; 
		}
	} 

	// clash 源里 ws 的自定义 Host 有时以大写键直接挂在顶层，需要归一化到 host
	if(outbound.Host){
		if(!outbound.host) outbound.host = outbound.Host;
		outbound.Host = null;
	}

	if(outbound.headers){
		var headers = {};
		for k,v in ..table.eachName(outbound.headers){ 
// 【模式匹配】把 header 键名规范化为首字母大写（例如 HOST 变为 Host）。^(\a)=串首第一个字母；(\a+)$=其余字母直到串尾
			k = ..string.replace(k,"^(\a)(\a+)$",lambda(a,b) ..string.upper(a) + ..string.lower(b) );
			headers[k] = v;	
		}
		outbound.headers = headers;

		if(outbound.headers.Host){
			if(outbound.headers.Host==outbound.host){
				outbound.headers.Host = null;
			}
			elseif(!outbound.host){
				outbound.host = outbound.headers.Host;
				outbound.headers.Host = null;
			}
		}

		if(!..table.count(outbound.headers)){
			outbound.headers = null;	
		}
	}

	outbound["http-opts"] = null;
	outbound["h2-opts"] = null;
	outbound.country = null;
	outbound.v = null;
	
	var pluginOpts = outbound["plugin-opts"];
	if(pluginOpts){
		var optsTemp = "";
		if(pluginOpts["mode"] && pluginOpts["mode"]=="websocket"){
			optsTemp += "tls;";
		}
		if(pluginOpts["host"]){
			optsTemp += pluginOpts["host"]+";";
		}
		if(pluginOpts["path"]){
			optsTemp += pluginOpts["path"]+";";
		}
		outbound.pluginOptions = optsTemp;
	}
	outbound["plugin-opts"] = null;
	
	
	// ==== 网络类型校验与归一化 ====
	// 订阅源常出现脏数据（network 写成乱码），会导致 Xray 整份配置加载失败。
	// 注意：SSR 的 network 是混淆算法名（origin/auth_aes128_md5 等），必须跳过校验。
	if(outbound.network && type(outbound.network)=="string"){
		var net = ..string.lower(outbound.network);
		if(net == "splithttp") net = "xhttp"; // 旧名归一化（Xray 26 已移除 HTTP 传输）
		if(outbound.protocol != "ssr"){
			if(!..table.find(["raw";"tcp";"ws";"websocket";"grpc";"xhttp";"httpupgrade";"mkcp";"kcp";"quic";"hysteria";"http";"h2"],net)){
				net = null; // 非法值清空，生成配置时自动使用默认传输
			}
		}
		outbound.network = net;
	}
	
	..table.define(outbound);
		
		//debug.log.print(outbound)
		//console.dump(outbound) 
		//debug.debug();
		
	if(outbound.address){
		// 注意：aardio 的 try...catch 本质是「立即执行的匿名函数」，
		// 在 try 里 return 只能退出 try 块自身，退不出 validOutbound 函数，
		// 所以这里必须把结果赋值给 validResult，最后由函数末尾统一 return。
		validResult = true;
	}
}
catch () {
	import debug.log
	import console
	//debug.log.print(outbound);
	//console.dump(outbound)
	validResult = false;
	} 
	return validResult;
}



// ==========================================================================
// 从网页提取订阅链接（两级抓取 + 去重）
//
// 第 0 级：访问传入的 url，提取出其中「全部」链接并先去重，避免同一个地址被重复访问。
// 第 1 级：逐个检查这些链接：
//         · 末尾命中「后缀白名单」的      → 直接作为结果返回（不再访问）；
//         · 末尾命中「无关后缀」的        → 直接丢弃（图片/样式/脚本/字体/音视频/压缩包等）；
//         · 域名命中「二次访问域名名单」的 → 再访问一次该链接，
//                                          从中提取命中后缀白名单的链接作为结果；
//         · 其余                          → 丢弃（不访问，避免白白浪费时间）。
// 最后把两级结果合并、去重后返回。
//
// 两个名单都保存在 config.subscribe 里（也就是 config/subscribe.table）：
//   config.subscribe.linkAllowedExts  —— 订阅地址后缀白名单
//   config.subscribe.linkVisitDomains —— 需要二次访问的域名名单
// 可在软件「订阅配置」页面点「链接提取规则」按钮编辑。
//
// 参数 @url      起始网址（通常是「列出订阅链接」的网页，也可以是订阅源本身）
// 参数 @maxFetch 可选，最多访问多少个页面，默认 20（防止链接太多时耗时失控）
//
// 返回：去重后的任务数组，元素形如 { url=绝对地址; content=内容或null }
//       · content 非 null → 内容已经获取，调用方直接拿去解析，不要再访问一次
//       · content 为 null → 内容还没获取，由调用方去获取
//
// ★ 同一个链接只会被访问一次：一次链接与二次链接之间可能互相重复，
//   重复的由 visitedMap / resultMap 挡掉；已经访问过的内容存在 contentCache，
//   既用于提取下级链接，也随结果返回给调用方送去解析（同一份数据不重复下载）。
// ==========================================================================
// 参数 @pageContent 允许调用方传入已经抓取到的页面内容，避免重复下载（可选）
extractLinksFromUrl = function(url,maxFetch,pageContent){
	import inet.http;
	import inet.url;
	import zlib;	// 导入 zlib 后 inet.http 才能自动解压 gzip 应答

	if(type(url)!="string") return [];
	url = ..string.trim(url);
	if(!#url) return [];

	maxFetch = ..tonumber(maxFetch);
	// 上限：同一批最多「二次访问」多少个页面。
	// 实测大站（例如 GitHub 仓库页 240KB）每次访问约 2~3 秒，默认取 30 以控制总耗时。
	if(!maxFetch || maxFetch<1) maxFetch = 20;
	maxFetch = ..math.floor(maxFetch);

	//------------------------------------------------------------------
	// 两个名单：从 config.subscribe 读取
	// 用直接下标 [[ ]] 取值，config 或其成员不存在时只会返回 null，不会报错
	//------------------------------------------------------------------
	var allowedExts = ..config[["subscribe"]][["linkAllowedExts"]];
	if(type(allowedExts)!="table") allowedExts = [];

	var visitDomains = ..config[["subscribe"]][["linkVisitDomains"]];
	if(type(visitDomains)!="table") visitDomains = [];

	// 明显无关的后缀（图片/样式/脚本/字体/音视频/压缩包/文档），命中就直接跳过、不访问
	var skipExts = [
		".png";".jpg";".jpeg";".gif";".bmp";".webp";".svg";".ico";".tif";".tiff";".avif";".heic";
		".css";".js";".mjs";".cjs";".map";
		".woff";".woff2";".ttf";".otf";".eot";
		".mp3";".wav";".ogg";".mp4";".avi";".mkv";".mov";".webm";".flv";".m4a";".flac";".wma";
		".zip";".rar";".7z";".gz";".bz2";".xz";".tar";".exe";".msi";".dmg";".apk";".deb";".rpm";".iso";".jar";".bin";
		".pdf";".doc";".docx";".xls";".xlsx";".ppt";".pptx";".psd"
	];

	//------------------------------------------------------------------
	// 内部工具函数
	//------------------------------------------------------------------

	// 取「去掉 ?查询串 与 #锚点 之后」的部分并转小写，用于后缀比较
	var getPathKey = function(u){
		var p = u;
		var pos = ..string.indexOf(p,"?");
		if(pos) p = ..string.left(p,pos-1);
		pos = ..string.indexOf(p,"#");
		if(pos) p = ..string.left(p,pos-1);
		return ..string.lower(p);
	};

	// 链接是否命中指定后缀表（忽略大小写）
	var hitExt = function(exts,u){
		var p = getPathKey(u);
		for(i=1;#exts;1){
			var ext = exts[i];
			if(type(ext)!="string") continue;
			ext = ..string.lower(..string.trim(ext));
			if(#ext && ..string.endWith(p,ext)) return true;
		}
		return false;
	};

	// 规范化名单里写的域名：允许写 github.com、*.github.io、https://github.com/xxx 等写法
	var normalizeDomain = function(d){
		if(type(d)!="string") return null;
		d = ..string.lower(..string.trim(d));
		if(!#d) return null;
// 【模式匹配】^https?\:// 表示行首的 http:// 或 https://，冒号必须转义成 \: 才是字面冒号
		d = ..string.replace(d,"^https?\://","");	// 去掉协议头
		var pos = ..string.indexOf(d,"/");			// 只保留主机部分
		if(pos) d = ..string.left(d,pos-1);
		pos = ..string.indexOf(d,"?");
		if(pos) d = ..string.left(d,pos-1);
		pos = ..string.indexOf(d,":");
		if(pos) d = ..string.left(d,pos-1);
		if(..string.startWith(d,"*.")) d = ..string.right(d,-3);	// 去掉通配前缀 *.
		d = ..string.trim(d,". ");
		return #d ? d : null;
	};

	// 链接的域名是否命中「二次访问域名名单」（子域名也算命中）
	var hitDomain = function(u){
		if(!#visitDomains) return false;
		var info = ..inet.url.split(u);
		if(type(info)!="table") return false;
		var host = ..string.lower(info.host : "");
		if(!#host) return false;
		for(i=1;#visitDomains;1){
			var d = normalizeDomain(visitDomains[i]);
			if(!d) continue;
			if(host==d) return true;
			if(..string.endWith(host,"." ++ d)) return true;
		}
		return false;
	};

	// 把链接规范成绝对地址；无效链接返回 null
	var normalizeLink = function(raw,baseUrl){
		if(type(raw)!="string") return null;
		raw = ..string.trim(raw);
		if(!#raw) return null;

		// ① 过滤不能抓取的协议与无效链接
		var lower = ..string.lower(raw);
		if( ..string.startWith(lower,"#")
			|| ..string.startWith(lower,"javascript:")
			|| ..string.startWith(lower,"mailto:")
			|| ..string.startWith(lower,"tel:")
			|| ..string.startWith(lower,"data:")
			|| ..string.startWith(lower,"file:")
			|| ..string.startWith(lower,"about:")
			|| ..string.startWith(lower,"blob:")
			|| ..string.startWith(lower,"ftp:") ){
			return null;
		}

		// ② 还原链接里最常见的 HTML 实体（&amp; → &）
		raw = ..string.replaceLiteral(raw,"&amp;","&");
		raw = ..string.replaceLiteral(raw,"&#38;","&");

		// ③ 拼成绝对地址：
		//    joinpath 对「相对路径 / 绝对路径 / 协议相对地址 //主机/路径 / 完整 URL」都适用
		var abs = ..inet.url.joinpath(baseUrl,raw);
		if(type(abs)!="string" || !#abs) return null;

		// ④ 去掉 #锚点（同一个文件的不同锚点没有意义）
		var pos = ..string.indexOf(abs,"#");
		if(pos) abs = ..string.left(abs,pos-1);

		// ⑤ 只保留 http/https
		lower = ..string.lower(abs);
		if(!..string.startWith(lower,"http://") && !..string.startWith(lower,"https://")) return null;

		return abs;
	};

	// 从网页内容里提取「全部」原始链接（不做后缀过滤）
	var collectRawLinks = function(content,list){
		// ① href="..." 与 href='...'
// 【模式匹配】href\s*=\s* 是 href 加可选空白、等号、可选空白；["'] 表示半角双引号或单引号；([^"']+) 捕获引号之间不含引号的内容
		for link in ..string.gmatch(content,`href\s*=\s*["']([^"']+)["']`) {
			..table.push(list,link);
		}

		// ② 正文里裸露的网址（纯文本列表、Markdown 链接都靠这条）
// 【模式匹配】\: 与 \/ 转义成字面冒号与斜杠（冒号在模式里表示任意多字节字符，必须转义）；[^\s<>"']+ 是一串不含空白、尖括号、引号的字符
		for link in ..string.gmatch(content,`<https?\:\/\/[^\s<>"']+>`) {
			// 截掉网址后面粘上的非 ASCII 字符（汉字、中文标点等）
			var cut;
			for(i=1;#link;1){
				var b = link[i];
				if(b<0x21 || b>0x7E){ cut = i; break; }
			}
			if(cut) link = ..string.left(link,cut-1);
			// 有些网页会把多个网址挤成一串（例如 JSON 里把 \n 写成了 /n），
			// 这时只保留第一个完整网址：从第 6 个字节之后再遇到 http:// 或 https:// 就截断
			var cutPos;
			var hp1 = ..string.indexOf(link,"http://",6);
			var hp2 = ..string.indexOf(link,"https://",6);
			if(hp1 && hp2) cutPos = (hp1<hp2) ? hp1 : hp2;
			elseif(hp1) cutPos = hp1;
			elseif(hp2) cutPos = hp2;
			if(cutPos) link = ..string.left(link,cutPos-1);
			// 去掉末尾粘上的标点
			link = ..string.trim(link,`.,;:!?)]}"'`);
			if(#link>8) ..table.push(list,link);
		}
	};

	// 结果集（自动去重）：数组元素为 { url=..., content=... }
	//   content 非 null → 内容已经获取，调用方直接用它解析，不要再访问一次；
	//   content 为 null → 内容还没获取，由调用方去获取。
	// 同一份内容既用于「提取下级链接」，也随结果返回给调用方「送去解析」。
	var resultLinks = [];
	var resultMap = {};	// url → 在 resultLinks 里的下标
	var addResult = function(link,content){
		var idx = resultMap[link];
		if(idx){
			// 已经收录过：若这次带了内容、而旧条目还没有内容，就把内容补上。
			// 同一个链接可能先被「提取下级链接」以无内容的形式收录，
			// 随后它自己又被访问到 —— 此时必须把内容补进去，
			// 否则调用方会为它再访问一次（违背「同一个链接只访问一次」）。
			if(type(content)==type.string && #content){
				var old = resultLinks[idx].content;
				if(type(old)!=type.string || !#old) resultLinks[idx].content = content;
			}
			return;
		}
		resultMap[link] = #resultLinks + 1;
		..table.push(resultLinks,{url=link; content=content});
	};

	// 把一批原始链接规范化并去重，返回绝对地址数组
	var collectLinks = function(content,baseUrl){
		var rawList = [];
		collectRawLinks(content,rawList);

		var list = [];
		var seen = {};
		for(i=1;#rawList;1){
			var callOk,abs = ..call(normalizeLink,null,rawList[i],baseUrl);
			if(!callOk || !abs) continue;
			if(seen[abs]) continue;	// 先在本轮内去重，避免后面重复访问
			seen[abs] = true;
			..table.push(list,abs);
		}
		return list;
	};

	// 共用一个 HTTP 客户端（自动使用系统代理），并设置超时，避免个别死链把整体拖住
	var http = ..inet.http();
	http.setTimeouts(8000,15000,15000);

	var fetchPage = function(u){
		var callOk,content = ..call(
			function(){
				return http.get(u);
			},null
		);
		if(!callOk) return null;
		if(type(content)!="string") return null;
		return content;
	};

	//------------------------------------------------------------------
	// 第 0 级：抓取起始网址，提取全部链接（已去重）
	//------------------------------------------------------------------
	var visitedMap = {};		// 已经处理过的链接（保证同一个链接只访问一次）
	var contentCache = {};	// 已经获取到的内容（同一份数据既用于提取、也送去解析）
	visitedMap[url] = true;

	if(!pageContent) pageContent = fetchPage(url);
	if(!pageContent){
		..debug.log.print("[提取链接] 抓取失败：",url);
		return [];
	}
	contentCache[url] = pageContent;

	var firstLevel = collectLinks(pageContent,url);
	..debug.log.print("[提取链接]",url,"共提取到唯一链接",#firstLevel,"个");

	//------------------------------------------------------------------
	// 第 1 级：分类处理
	//
	// ★ 关键：「作为解析对象」（命中后缀白名单）与「访问并提取下级链接」
	//   （域名命中访问名单）不再互斥，两者可以同时成立。
	//   例如 https://某站/p/5063.html 既命中后缀白名单（.html 本身要送解析），
	//   域名又在访问名单里（要进去把真正的订阅文件 *.txt / *.yaml 挖出来）。
	//   过去命中白名单就 continue，这类「文章页」会被当成订阅文件直接送去解析，
	//   页面里的真实订阅链接永远发现不了。
	//
	// ★ 同一个链接只访问一次：内容存进 contentCache，
	//   既用来提取下级链接，也随结果返回给调用方送去解析。
	//   一次链接与二次链接之间也可能重复，重复的由 resultMap / visitedMap 挡掉。
	//------------------------------------------------------------------
	var fetchCount = 0;
	var capWarned;	// 只在首次达到上限时提示一次

	// ---- 预扫描：先分类，把「需要进去看看」的链接收集起来 ----
	//     刻意不在这里访问：集中起来并行访问（见下面的 fetchUrlsParallel）。
	//     串行访问几十个链接会把界面线程卡住 60~90 秒，这正是「界面不能卡」要解决的问题。
	var plan = [];		// { link=; needParse=; needVisit=; content= }
	var toFetch = [];	// 需要访问的链接（保持页面里的出现顺序）
	for(i=1;#firstLevel;1){
		var link = firstLevel[i];

		// ① 末尾是明显无关的后缀 → 直接丢弃
		if( hitExt(skipExts,link) ) continue;

		// ② 该链接本身是否要送去解析（命中后缀白名单）
		var needParse = hitExt(allowedExts,link);

		// ③ 是否需要进去提取下级链接（域名命中访问名单）
		var needVisit = hitDomain(link);

		// 两者都不满足 → 丢弃
		if( !needParse && !needVisit ) continue;

		// ④ 取内容：已缓存的直接复用
		var content = contentCache[link];
		if( type(content)!=type.string || !#content ) content = null;

		if(content){
			..table.push(plan,{link=link; needParse=needParse; needVisit=needVisit; content=content});
			continue;
		}

		// ⑤ 「只需解析、不需要提取下级链接」的链接不在这里访问：
		//    直接作为结果返回（content 为 null），由调用方在后台线程获取并解析，
		//    避免把下载耗时压在界面线程上（本函数运行在界面线程）。
		if(needParse && !needVisit){
			addResult(link,null);
			continue;
		}

		// ⑥ 需要访问 → 检查上限后收集起来，稍后并行访问
		if(fetchCount >= maxFetch){
			// 达到上限：不再访问。
			// 「只需解析」的链接上面已经作为结果返回；
			// 「需要访问提取」的链接只能放弃。
			if(!capWarned){
				capWarned = true;
				..debug.log.print("[提取链接] 访问数量达到上限",maxFetch,"个，后续链接不再访问");
			}
			continue;
		}
		visitedMap[link] = true;
		fetchCount++;
		..table.push(toFetch,link);
		..table.push(plan,{link=link; needParse=needParse; needVisit=needVisit});
	}

	// ---- 并行访问这些链接（界面线程只做轮询 + 泵消息，所以界面不卡）----
	if(#toFetch){
		var fetchedMap = fetchUrlsParallel(toFetch,8);
		for(i=1;#plan;1){
			var it = plan[i];
			if(it.content) continue;	// 已有内容
			var text = fetchedMap[it.link];
			if(type(text)==type.string && #text){
				it.content = text;
				contentCache[it.link] = text;
			}
		}
	}

	// ---- 处理：送去解析 + 提取下级链接 ----
	for(i=1;#plan;1){
		var it = plan[i];
		var content = it.content;
		if(type(content)!=type.string || !#content) continue;

		// ⑦ 送去解析（用同一份内容，调用方不会再访问一次）
		if(it.needParse) addResult(it.link,content);

		// ⑧ 进去提取下级链接（只保留命中后缀白名单的，不再继续递归）
		if(it.needVisit){
			var subLinks = collectLinks(content,it.link);
			for(j=1;#subLinks;1){
				var sub = subLinks[j];
				if( hitExt(skipExts,sub) ) continue;
				if( hitExt(allowedExts,sub) ) addResult(sub,null);
			}
		}
	}

	..debug.log.print("[提取链接] 处理完成：访问",fetchCount,"个，最终结果",#resultLinks,"个");
	return resultLinks;
}




//从订阅更新数据函数

updateSubscription = function(outbondSubscribeUrlMap){
	import debug
	//console.print(outbondSubscribeUrlMap)

	var cfgOutbounds = ..config.proxy.outbounds : ..table.array(); 
	if(!outbondSubscribeUrlMap) {//传过来的为空，就从服务器列表中读取订阅信息（实际上没有传参）
		outbondSubscribeUrlMap = {}

		for(i=#cfgOutbounds;1;-1){
			var outbound = cfgOutbounds[i] 
			if(outbound.subscribeUrl){
				outbondSubscribeUrlMap[outbound.subscribeUrl] = true;	
			}
		}

		var cfgSubscribeUrls = ..config.subscribe.subscribeUrls;
		for(i=#cfgSubscribeUrls;1;-1){
			var sub = cfgSubscribeUrls[i]  
			if(sub.checked ===  "启用") {
				outbondSubscribeUrlMap[sub.url] = true; 
			}
			else {
				outbondSubscribeUrlMap[sub.url] = null; 
			}
		}

		if(!..table.count(outbondSubscribeUrlMap)){ 
			if(..mainForm) ..mainForm.msgWarn('当前未启用任何订阅源,\n请先复制订阅源网址到剪贴板然后点击「批量导入链接」!', 1500);
			//winform.btnUpdate.disabledText = null;
			return;
		}
	}
	//debug.debug()
	var count = 0; 
	// ==================================================================
	// 【跨源去重 + 预填充】seenKeys 必须放在订阅源循环之外：
	//   1) 放在循环内 → 每个订阅源各建一份索引，源与源之间完全不去重，
	//      同一个节点会被反复导入（实测一次更新解析出 2 万+ 个，其中 9914 个是重复的）。
	//   2) 预填充库里已有的节点 → 重复节点在 addNodes 里就被直接丢弃，
	//      连 impOutbounds 数组都进不去，避免「先全部导入 → 再全部删除」的双倍内存峰值。
	//   3) 语义与 removeRepeat 的「保留序号在前的」完全一致：库里已有的节点会胜出。
	//   注意 outbounds 是稀疏表，# 不能保证覆盖全部元素，这里用 for-in 全量遍历。
	// ==================================================================
	var seenKeys = {};	// 去重索引：address:port → true（整个更新过程共享，跨源跨批次）
	var prefillCount = 0;
	for(k,ob in cfgOutbounds){
		if(type(ob)!=type.table) continue;
		seenKeys[ tostring(ob.address) ++ ":" ++ tostring(ob.port) ] = true;
		prefillCount++;
	}
	..debug.log.print("[去重] 预填充库中已有节点",prefillCount,"个（这些节点本次将被直接跳过）");
	
	for(url,data in outbondSubscribeUrlMap){
		// 每个订阅源开始处理时显示进度提示框，整个处理过程结束后关闭（原设计的交互）
		var progressForm = openSubscribeProgressDlg(url);
		// ==================================================================
		// 【去重策略】增量去重（哈希表，O(n)）
		//
		// 1. 为什么必须「边获取边去重」，而不是「全部合并后再去重」：
		//    一个主订阅源往往能提取出几十个二级链接，每个链接可能解析出几千个节点，
		//    全部合并后再去重会直接把内存吃满。所以每收到一批就立即去重合并。
		//
		// 2. 为什么用哈希表而不是原来的「标记 repeat + 双重循环」：
		//    双重循环是 O(n²)（实测 2000 节点 828ms、3000 节点 500ms，
		//    按此推算 13000 节点需要数十秒）；哈希表一次遍历仅 15ms（快 30~55 倍），
		//    而且天然支持增量 —— seenKeys 跨批次保留，新批次只检查新增节点。
		// ==================================================================
		var impOutbounds = ..table.array();
		// 注意：seenKeys 定义在订阅源循环之外（已预填充库中已有节点），此处不要再新建

		// 把一批节点并入结果集（逐节点去重，重复的直接丢弃，绝不进入数组占内存）
		var addNodes = function(nodes){
			if(type(nodes)!=type.table) return 0;
			var added = 0;
			for(i=1;#nodes;1){
				var ob = nodes[i];
				if(type(ob)!=type.table) continue;
				var key = tostring(ob.address) ++ ":" ++ tostring(ob.port);
				if(seenKeys[key]) continue;		// 已存在 → 直接丢弃
				seenKeys[key] = true;
				..table.push(impOutbounds,ob);
				added++;
			}
			return added;
		};

		// ---- ① 主订阅源：顺序获取（数量少，不值得并发）----
		//    fetchSubscription 负责「获取」（唯一的联网入口）
		//    importFromString  负责「解析」（永不联网）
		var content;
		if(type(data)==type.string && #data){
			content = data;						// 调用方已直接给出内容
		}
		else {
			// 进度框由本函数（updateSubscription）负责整个订阅过程，所以这里不再单独开一个
			content = ..xray.outbounds.fetchSubscription(url,false);
		}

		if(!content){
			debug.log.print("[" ++ url ++ "] 主订阅源获取失败");
		}

		// ---- 组装任务列表：主订阅源内容 + 全部二级链接 ----
		//    每个任务都在独立线程里完成「（必要时）获取 + 解析」。
		//    数量可能很多（一个页面几十个链接），串行会长时间阻塞界面，所以要并发；
		//    但并发结果不能全部驻留内存等最后一起处理，所以分批启动，
		//    并且「谁先完成谁先合并」—— 合并后立即清掉该批的跨线程数据，内存即时释放。
		//    解析很占 CPU（几千个节点要好几秒），放在界面线程会明显卡界面，
		//    因此主订阅源的内容也一并交给后台线程解析
		//    （主订阅源的「获取」仍在界面线程顺序执行，符合「主 url 顺序、二级 url 并行」）。
		var tasks = ..table.array();
		if(content){
			..table.push(tasks,{url=url; content=content; isMain=true});
		}

		var linkTasks = extractLinksFromUrl(url, , content);
		for(k,t in linkTasks){
			..table.push(tasks,{url=t.url; content=t.content; isMain=false});
		}

		if(#tasks){
			debug.log.print("[" ++ url ++ "] 共 " ++ #tasks ++ " 个任务（主订阅源 + " ++ #linkTasks ++ " 个二级链接），分批并发获取并解析 ...");

			var tBegin = ..time.tick();
			var BATCH_SIZE = 8;	// 每批并发数（同时也在控制内存峰值）
			var keyPrefix = "subTask_" ++ tostring(..string.crc32(url)) ++ "_" ++ tostring(tBegin) ++ "_";

			// 【为什么改用固定线程池，而不是「每个链接一个 thread.invoke」】
			//   aardio 中每个新建线程都会把 import 的库在自己的线程环境里重新编译一份，
			//   实测每创建一个「import + 解析」的线程会额外常驻约 1.3~1.9MB，且回收明显滞后。
			//   一个订阅源动辄几十上百个二级链接，旧写法（每链接一个线程）会让内存
			//   一路上涨且订阅结束后也不回落（实测 190MB → 495MB），界面越来越卡。
			//   改成固定并发线程池后 worker 全程复用，线程数与内存占用都恒定。
			import thread.works;
			var workerFn = function(task){
				import inet.http;
				import web.rest.github;
				import xray.outbounds;
				import debug;
				import debug.log;

				// 内容已给出（主订阅源）则直接用，否则在线程内抓取。
				// 线程内只写 debug.log，不做任何界面提示。
				// 注意：aardio 中空字符串 "" 是真值，必须同时检查长度
				var text = task.content;
				if(type(text)!=type.string || !#text){
					if( string.indexOf(task.url,"github.com")
						|| string.indexOf(task.url,"raw.githubusercontent.com") ){
						text = web.rest.github.getContent(task.url);
					}
					if(!text){
						var http = inet.http();
						http.setTimeouts(8000,15000,15000);
						text = http.get(task.url);
					}
				}

				if(!text){
					debug.log.print("[任务] 获取失败:",task.url);
					..thread.set(task.key,"");	// 失败也写一个非 null 值，表示「已完成」
					return;
				}

				// 解析
				var nodes = xray.outbounds.importFromString(text,task.url);
				..thread.set(task.key, nodes ? nodes : "");
			};

			var pool = ..thread.works(BATCH_SIZE, workerFn);

			for(start=1;#tasks;BATCH_SIZE){
				var stop = ..math.min(start + BATCH_SIZE - 1,#tasks);

				// 启动这一批的任务（推入线程池，worker 全程复用）
				for(k=start;stop;1){
					pool.pushAsync({
						url = tasks[k].url;
						content = tasks[k].content;
						key = keyPrefix ++ tostring(k);
					});
				}

				// 收割这一批：谁先完成谁先合并（thread.get 是非阻塞读取）
				var pending = [];
				for(k=start;stop;1) ..table.push(pending,k);

				while(#pending){
					var stillPending = [];
					for(i=1;#pending;1){
						var pk = pending[i];
						var key = keyPrefix ++ tostring(pk);
						var nodes = ..thread.get(key);

						if(nodes === null){			// 尚未完成
							..table.push(stillPending,pk);
							continue;
						}

						..thread.set(key,null);		// 立即释放跨线程共享区内存
						if(type(nodes)==type.table){
							var added = addNodes(nodes);	// ← 完成一批就立即去重合并
							debug.log.print("[任务] " ++ tasks[pk].url ++ "获得" ++ #nodes ++ "个，" ++ " 新增 " ++ added ++ " 个唯一节点，累计 " ++ #impOutbounds);
						//	else debug.log.print("[任务] " ++ tasks[pk].url ++ " 获取0个节点 ");
						}
						
					}

					if(#stillPending == #pending){
						// 本批尚无任何结果：稍等片刻（thread.delay 会泵界面消息，不会卡界面）
						..thread.delay(20);
					}
					pending = stillPending;
				}
			}

			pool.quit(3000);	// 释放订阅抓取线程池（worker 全部退出）

			debug.log.print("[" ++ url ++ "] 全部任务处理完成，耗时 " ++ (..time.tick()-tBegin) ++ " ms，唯一节点 " ++ #impOutbounds ++ " 个");
		}
		// 本订阅源处理完毕：关闭进度提示框，随后用 msgOk 汇报本次结果
		closeSubscribeProgressDlg(progressForm);
		// 注：原代码此处有「if (#impOutbounds > 5000) break;」的提前中止，
		//     现已按需求注释掉 —— 增量去重后重复节点不再堆积，内存压力已大幅降低。

        

	//	debug.log.print("删除重复服务器",removecount,"个","                            获取",#impOutbounds,"个")	;
		
		
		
		if(#impOutbounds){
/*
			for(i=#cfgOutbounds;1;-1){
				var outbound = cfgOutbounds[i] 
				if(outbound.subscribeUrl==url && outbound.ps != "已测通"){
					..table.remove(	cfgOutbounds,i );//先删除当前订阅网址下的原节点
				}
			}
*/
			debug.log.print("从",url,"获得",#impOutbounds,"个服务器");
			// 注意：本函数可能被放到后台线程执行，此时 ..mainForm 为 null，必须判空
			if(..mainForm) ..mainForm.msgOk("从"+url+"已刷新" + #impOutbounds + "个订阅服务器。",1500);
			count = count + #impOutbounds;
			..table.append(cfgOutbounds,impOutbounds);
			
		}
		else{
			debug.log.print("未从",url,"获取服务器");
		}
	//	if(#..config.proxy.outbounds >15000) ..frmXray.removeRepeat();
	}
	
	//import xray
	//..frmXray.removeRepeat();
	..config.proxy.save();
	// 按需求：界面只报告「每个主订阅源结束时获得多少节点」，
	// 其余进度信息一律只写 debug.log，避免弹窗过多干扰。
	debug.log.print("已找到" + count + "个订阅服务器。")
//	..publish("outbounds.updateConfigJson");
//	..publish("uiCommand.restartxrayCore",cfgOutbounds) 

	return count;
}

autoUpdateSubscription = function(){
	var outbondSubscribeUrlMap = {} 
	var cfgSubscribeUrls = ..config.subscribe.subscribeUrls;
	for(i=#cfgSubscribeUrls;1;-1){
		var sub = cfgSubscribeUrls[i]  
		if(!#sub.url){
			continue;
		}

		if(sub.checked ===  "启用") {
			outbondSubscribeUrlMap[sub.url] = true; 
		}
	}

	if(!..table.count(outbondSubscribeUrlMap)){
		return;
	}

	..thread.invoke( 
		function(winform,outbondSubscribeUrlMap,responseCache){
			import inet.http;
			import web.rest.github;

			var http = inet.http();
			for(url,v in outbondSubscribeUrlMap){ 

				if( string.indexOf(url,"github.com")
					|| string.indexOf(url,"raw.githubusercontent.com") 
					){
					outbondSubscribeUrlMap[url] = web.rest.github.getContent(url)
				}
				else{
					outbondSubscribeUrlMap[url] = http.get(url);
				}

				if(!outbondSubscribeUrlMap[url]){
					continue;
				}

				if(responseCache){
					if(responseCache[url] && responseCache[url]===..string.crc32(outbondSubscribeUrlMap[url])){
						outbondSubscribeUrlMap[url] = null;
					} 
				} 
			}

			winform.publish("thread.subscriptionUpdated",outbondSubscribeUrlMap)
		},..mainForm,outbondSubscribeUrlMap,_subscriptionResponseCache
	)
}



var currentActiveOutbound = ..globalActiveOutbound;
..subscribe("activeOutbound",function(address){
	currentActiveOutbound = address;
} )

..subscribe("thread.subscriptionUpdated",function(outbondSubscribeUrlMap){
    if(currentActiveOutbound){
    	return;
    }

	var cfgOutbounds = ..config.proxy.outbounds : ..table.array();

	var count = 0; 
	for(url,data in outbondSubscribeUrlMap){ 

		var impOutbounds = ..xray.outbounds.importFromString(data,url);
		if(#impOutbounds){
			for(i=#cfgOutbounds;1;-1){
				var outbound = cfgOutbounds[i] 
				if(outbound.subscribeUrl==url && outbound.ps != "已测通"){
					..table.remove(	cfgOutbounds,i );
				}
			}

			..table.append(cfgOutbounds,impOutbounds);
			count = count + #impOutbounds;
		}
	}

	if(!count){
		return;
	}

	..config.proxy.outbounds = cfgOutbounds;
	..config.proxy.save();

	..publish("outbounds.updateConfigJson");
	..publish("uiCommand.restartxrayCore")
	..publish("uiCommand.print","已自动刷新" + count + "个订阅服务器。")		 
} )

// ==========================================================================
// YAML 子集解析器（供 importFromClash 使用）
//
// 旧实现用「模式匹配替换 + 缩进猜测」把 YAML 硬转成 aardio 表文本：
//   · 数组项的减号「顶格」写法（proxies: 顶格 + "- name: xxx"，完全合法的 YAML）
//     因为算出的数组缩进等级为 0，走不到任何分支而被【静默丢弃】整行
//     （连 name 字段都没有了）；
//   · 嵌套结构（ws-opts / reality-opts）也会丢字段；
//   · 最终产物里节点还会互相粘连（udp: truetype: vless,...），一个节点都解析不出来。
//
// 这里改为真正的「缩进感知」解析器：
//   · 映射 / 序列（减号可在任意缩进，含顶格写法）
//   · 嵌套按缩进处理
//   · 行内流式映射 {k: v} 与流式序列 [a, b]
//   · 单引号 / 双引号字符串（含转义）、行尾注释、布尔 / null 标量
//   · 按「宁导错，不错过」原则：结构异常时保留原始文本，绝不静默丢字段
// ==========================================================================

//YAML 锚点/别名上下文（&name / *name / <<: *name）。
//放在命名空间级局部变量里，由 yamlParse 在每次解析前重置。
var yamlAnchors;

//去掉行尾注释（# 只有在引号外、且前面是空白或行首时才算注释）
yamlStripComment = function(line){
	//快速路径：不含 # 的行直接返回（indexOf 是原生实现，比逐字节扫描快得多）
	if( !..string.indexOf(line,"#") ) return line;

	var inS,inD = false,false;
	var i = 1;
	while( i <= #line ){
		var ch = line[i];
		if( inD ){
			if( ch === 0x5C ){ i += 2; continue; }
			if( ch === 0x22 ) inD = false;
		}
		elseif( inS ){
			if( ch === 0x27 ) inS = false;
		}
		elseif( ch === 0x22 ) inD = true;
		elseif( ch === 0x27 ) inS = true;
		elseif( ch === 0x23 ){
			if( i === 1 || line[i-1] === 0x20 || line[i-1] === 0x09 ){
				return ( i === 1 ) ? "" : ..string.left(line,i-1);
			}
		}
		i++;
	}
	return line;
};

//按顶层分隔符拆分（跳过引号与括号内部），用于流式 {..} / [..]
yamlSplitTop = function(s,sep){
	sep = sep : 0x2C;
	var parts = {};
	var inS,inD = false,false;
	var depth = 0;
	var start = 1;
	var i = 1;
	while( i <= #s ){
		var ch = s[i];
		if( inD ){
			if( ch === 0x5C ){ i += 2; continue; }
			if( ch === 0x22 ) inD = false;
		}
		elseif( inS ){
			if( ch === 0x27 ) inS = false;
		}
		elseif( ch === 0x22 ) inD = true;
		elseif( ch === 0x27 ) inS = true;
		elseif( ch === 0x7B || ch === 0x5B ) depth++;
		elseif( ch === 0x7D || ch === 0x5D ) depth--;
		elseif( ch === sep && depth === 0 ){
			..table.push(parts,..string.trim(..string.slice(s,start,i-1)));
			start = i+1;
		}
		i++;
	}
	..table.push(parts,( start <= #s ) ? ..string.trim(..string.slice(s,start,-1)) : "");
	return parts;
};

//拆「键: 值」；loose 为真时冒号后可以不跟空白（流式映射用）
yamlSplitKey = function(text,loose){
	//快速路径：不含引号的行用原生 string.find 定位（比逐字节扫描快得多）
	//★ 注意：不要用 "^([^:]*)\:..." 这种模式 —— aardio 模式里的 [^:] 并不可靠
	//  （实测会把 "proxies: [{name: A, port: 443}]" 在最后一个冒号处切开，
	//   导致键名变成 "proxies: [{name: A, port"）。
	if( !..string.indexOf(text,"'") && !..string.indexOf(text,'"') ){
		var k,v,s;

		//① 第一个「冒号 + 空白」处就是键值分隔
		s = ..string.find(text,"\:[ \t]");
		if( s && s > 1 ){
			k = ..string.trim(..string.left(text,s-1));
			v = ( s + 2 <= #text ) ? ..string.trim(..string.slice(text,s+2,-1)) : null;
			if( #k ) return k,v;
		}

		//② 行尾冒号 → 键的值为空
		if( #text > 1 && text[#text] === 0x3A ){
			k = ..string.trim(..string.left(text,#text-1));
			if( #k ) return k,null;
		}

		//③ 宽松模式（流式映射）：冒号后可以不跟空白
		if( loose ){
			s = ..string.find(text,"\:");
			if( s && s > 1 ){
				k = ..string.trim(..string.left(text,s-1));
				v = ( s + 1 <= #text ) ? ..string.trim(..string.slice(text,s+1,-1)) : null;
				if( #k ) return k,v;
			}
		}
		return null;
	}

	var inS,inD = false,false;
	var i = 1;
	while( i <= #text ){
		var ch = text[i];
		if( inD ){
			if( ch === 0x5C ){ i += 2; continue; }
			if( ch === 0x22 ) inD = false;
		}
		elseif( inS ){
			if( ch === 0x27 ) inS = false;
		}
		elseif( ch === 0x22 ) inD = true;
		elseif( ch === 0x27 ) inS = true;
		elseif( ch === 0x3A ){
			if( loose || i === #text || text[i+1] === 0x20 || text[i+1] === 0x09 ){
				var key = ..string.trim( ..string.slice(text,1,i-1) );
				key = ..string.trim(key,'"\'');
				if( !#key ) return null;
				return key,( i < #text ) ? ..string.trim( ..string.slice(text,i+1,-1) ) : null;
			}
		}
		i++;
	}
	return null;
};

//解析流式映射 {k: v, ...}
//流式集合的括号平衡度（>0 表示还没闭合，需要继续读后续行）；跳过引号内部
yamlFlowBalance = function(s){
	var inS,inD = false,false;
	var depth = 0;
	var i = 1;
	while( i <= #s ){
		var ch = s[i];
		if( inD ){
			if( ch === 0x5C ){ i += 2; continue; }
			if( ch === 0x22 ) inD = false;
		}
		elseif( inS ){
			if( ch === 0x27 ) inS = false;
		}
		elseif( ch === 0x22 ) inD = true;
		elseif( ch === 0x27 ) inS = true;
		elseif( ch === 0x7B || ch === 0x5B ) depth++;
		elseif( ch === 0x7D || ch === 0x5D ) depth--;
		i++;
	}
	return depth;
};

//注意：for(i,v in fn()) 中 fn() 会被当作「迭代器工厂」，返回表时会报
//      「Attempt to call Type:table」，所以必须用括号包围：(fn())
yamlParseFlowMap = function(s){
	var map = {};
	if( !#s ) return map;
	for(i,part in (yamlSplitTop(s))){
		if( !#part ) continue;
		var key,val = yamlSplitKey(part,true);
		if( key === null ) continue;
		map[key] = yamlParseScalar(val);
	}
	return map;
};

//解析流式序列 [a, b, ...]
yamlParseFlowSeq = function(s){
	var arr = [];
	if( !#s ) return arr;
	for(i,part in (yamlSplitTop(s))){
		if( !#part ) continue;
		..table.push(arr,yamlParseScalar(part));
	}
	return arr;
};

//解析标量（字符串 / 布尔 / null / 流式集合）
//注意：数字一律保留为字符串 —— 密码等字段若被转成数值，
//      后续生成配置时会变成 12345 而不是 "12345"，反而容易出错。
yamlParseScalar = function(s){
	if( s === null ) return null;
	s = ..string.trim(s);
	if( !#s ) return null;

	var c1 = s[1];
	var cN = s[#s];

	//双引号字符串（处理 \n \t \r \" \\ \/ 以及 \xXX \uXXXX \UXXXXXXXX 转义）
	if( c1 === 0x22 && cN === 0x22 && #s >= 2 ){
		if( #s === 2 ) return "";
		var body = ..string.slice(s,2,-2);
		var sb = {};
		var i = 1;
		while( i <= #body ){
			var ch = body[[i]];
			if( ch === '\\' ){
				var nx = body[[i+1]];
				if( nx === "n" ){ ..table.push(sb,'\n'); i += 2; }
				elseif( nx === "t" ){ ..table.push(sb,'\t'); i += 2; }
				elseif( nx === "r" ){ ..table.push(sb,'\r'); i += 2; }
				elseif( nx === "u" || nx === "U" || nx === "x" ){
					//\xXX(2位) / \uXXXX(4位) / \UXXXXXXXX(8位)
					//订阅源常用 \U0001F1EB 这种写法表示国旗等 emoji，必须还原成真字符
					var n = ( nx === "U" ) ? 8 : ( ( nx === "u" ) ? 4 : 2 );
					var hex = ( i + 1 + n <= #body ) ? ..string.slice(body,i+2,i+1+n) : null;
					var code = ( hex && ..string.match(hex,"^[0-9a-fA-F]+$") ) ? tonumber(hex,16) : null;
					if( code ){
						..table.push(sb,..string.fromCharCode(code));
						i += 2 + n;
					}
					else {
						..table.push(sb,nx);
						i += 2;
					}
				}
				elseif( nx ){ ..table.push(sb,nx); i += 2; }
				else i++;
			}
			else {
				..table.push(sb,ch);
				i++;
			}
		}
		return ..string.join(sb);
	}

	//单引号字符串（'' 表示一个 '）
	if( c1 === 0x27 && cN === 0x27 && #s >= 2 ){
		if( #s === 2 ) return "";
		return ..string.replace( ..string.slice(s,2,-2), "''","'" );
	}

	//流式集合：① 先按 JSON 解析 —— JSON 流式写法很常见，而且 aardio 的 JSON
	//            解析器还能容忍「键不加引号」的 YAML 流式写法，是最精确的一条路
	//          ② 再按 YAML 流式语法解析（兜底）
	if( c1 === 0x7B && cN === 0x7D ){
		var j = ..web.json.tryParse(s);
		if( type(j)=="table" ) return j;
		return yamlParseFlowMap( (#s > 2) ? ..string.slice(s,2,-2) : "" );
	}
	if( c1 === 0x5B && cN === 0x5D ){
		var j = ..web.json.tryParse(s);
		if( type(j)=="table" ) return j;
		return yamlParseFlowSeq( (#s > 2) ? ..string.slice(s,2,-2) : "" );
	}

	var low = ..string.lower(s);
	if( low === "true" ) return true;
	if( low === "false" ) return false;
	if( low === "null" || s === "~" ) return null;

	return s;
};

//按缩进解析一个块；返回 值, 下一个待处理行号
yamlParseBlock = function(lines,idx,indent){
	if( idx > #lines ) return null,idx;
	var first = lines[idx];
	if( !first || first.indent < indent ) return null,idx;

	//序列
	if( first.isSeq ){
		var arr = [];
		while( idx <= #lines ){
			var it = lines[idx];
			if( !it ) break;
			//★ 缩进比本块更深的「游离行」（未被上层消费掉的）只跳过、绝不中断：
			//  否则一行异常就会让后面整个文档全部丢失（旧版曾因此一次丢几百个节点）。
			if( it.indent > indent ){ idx++; continue; }
			if( it.indent < indent ) break;
			if( !it.isSeq ) break;   //同缩进的映射键 → 序列到此结束

			var ci = it.contentIndent;
			var ct = it.content;

			//★ YAML 锚点（数组项）：`- &name` 或 `- &name key: value`
			var aName;
			if( #ct && ct[1] === 0x26 ){
				var aRest;
				aName,aRest = ..string.match(ct,"^\&(\S+)\s*(.*)$");
				if( aName ) ct = aRest ? aRest : "";
			}

			//「-」后面没有内容 → 值在后续行
			if( !#ct ){
				var nx = lines[idx+1];
				if( nx && ( nx.indent > indent || ( nx.indent === indent && nx.isSeq ) ) ){
					var v;
					v,idx = yamlParseBlock(lines,idx+1,nx.indent);
					..table.push(arr,v);
					if( aName ) yamlAnchors[aName] = v;
				}
				else {
					..table.push(arr,null);
					idx++;
				}
				continue;
			}

			//★ 按「项的风格」分派到专用解析器（不要用一种通用逻辑硬套所有风格：
			//  实测把流式项丢给块式逻辑会解析出「键名带花括号」的垃圾数据）。
			//    ① 流式/JSON 项（以 { 或 [ 开头，可能跨多行）→ 流式解析器
			//    ② 块式项（其余）→ 缩进感知的块式解析器
			var c1 = ct[1];
			if( c1 === 0x7B || c1 === 0x5B ){
				//流式集合可能跨多行：按括号平衡把后续行拼进来
				var flowText = ct;
				while( yamlFlowBalance(flowText) > 0 && idx < #lines ){
					idx++;
					flowText = flowText ++ " " ++ ..string.trim(lines[idx].text);
				}
				idx++;
				..table.push(arr,yamlParseScalar(flowText));
				continue;
			}

			//块式：数组项本身是「键: 值」→ 该项是一个映射，首键写在减号这一行
			var key,val = yamlSplitKey(ct);
			if( key !== null ){
				var obj = {};

				//★ 锚点/别名/合并键（与映射分支同一套规则）
				var aVal;
				if( type(val)=="string" && val[1] === 0x26 ){
					var aRest;
					aVal,aRest = ..string.match(val,"^\&(\S+)\s*(.*)$");
					val = ( aRest && #aRest ) ? aRest : null;
					if( !aVal ) val = null;
				}

				if( key === "<<" ){
					//合并键：把锚定的映射并进来（显式键优先）
					var mAlias = ( type(val)=="string" ) ? ..string.match(val,"^\*(\S+)$") : null;
					var mMerged = mAlias ? yamlAnchors[mAlias] : null;
					if( type(mMerged)=="table" ){ for(k,v in mMerged){ if(obj[k]===null) obj[k] = v; } }
					idx++;
				}
				elseif( type(val)=="string" && val[1] === 0x2A ){
					var sAlias = ..string.match(val,"^\*(\S+)$");
					obj[key] = sAlias ? yamlAnchors[sAlias] : yamlParseScalar(val);
					idx++;
				}
				elseif( val === null ){
					var nx = lines[idx+1];
					if( nx && ( nx.indent > ci || ( nx.indent === ci && nx.isSeq ) ) ){
						var v;
						v,idx = yamlParseBlock(lines,idx+1,nx.indent);
						obj[key] = v;
						if( aVal ) yamlAnchors[aVal] = v;
					}
					else {
						obj[key] = null;
						idx++;
					}
				}
				else {
					obj[key] = yamlParseScalar(val);
					if( aVal ) yamlAnchors[aVal] = obj[key];
					idx++;
				}

				//继续读取同一映射的其余键（缩进与首键对齐）
				var nx2 = lines[idx];
				if( nx2 && nx2.indent === ci && !nx2.isSeq ){
					var more;
					more,idx = yamlParseBlock(lines,idx,ci);
					if( type(more)=="table" ){
						for(k,v in more){ obj[k] = v; }
					}
				}

				..table.push(arr,obj);
				if( aName ) yamlAnchors[aName] = obj;
				continue;
			}

			//纯标量项
			..table.push(arr,yamlParseScalar(ct));
			idx++;
		}
		return arr,idx;
	}

	//映射
	var map = {};
	while( idx <= #lines ){
		var it = lines[idx];
		if( !it ) break;
		//同上：更深的游离行只跳过，不中断
		if( it.indent > indent ){ idx++; continue; }
		if( it.indent < indent ) break;
		if( it.isSeq ) break;   //同缩进的数组项 → 映射到此结束

		var key,val = yamlSplitKey(it.text);
		if( key === null ){
			idx++;   //异常行：跳过，避免死循环
			continue;
		}

		//★ YAML 锚点：`&name` 只是给这个节点起一个可复用的名字，本身不是值。
		//  例：proxies: &id001 ← 后面跟着整个节点数组（PyYAML 常见输出）
		var anchorName;
		if( type(val)=="string" && val[1] === 0x26 ){
			var aRest;
			anchorName,aRest = ..string.match(val,"^\&(\S+)\s*(.*)$");
			val = ( aRest && #aRest ) ? aRest : null;
			if( !anchorName ) val = null;   //防御：格式异常就当没有值
		}

		//★ YAML 合并键 `<<: *name`：把锚定的映射合并进当前映射（显式键优先）
		if( key === "<<" ){
			var mAlias = ( type(val)=="string" ) ? ..string.match(val,"^\*(\S+)$") : null;
			var mMerged = mAlias ? yamlAnchors[mAlias] : null;
			if( type(mMerged)=="table" ){
				for(k,v in mMerged){ if(map[k]===null) map[k] = v; }
			}
			idx++;
			continue;
		}

		//★ YAML 别名 `key: *name`：引用之前锚定的节点
		if( type(val)=="string" && val[1] === 0x2A ){
			var sAlias = ..string.match(val,"^\*(\S+)$");
			if( sAlias ){
				map[key] = yamlAnchors[sAlias];
				idx++;
				continue;
			}
		}

		if( val === null ){
			var nx = lines[idx+1];
			if( nx && ( nx.indent > indent || ( nx.indent === indent && nx.isSeq ) ) ){
				var v;
				v,idx = yamlParseBlock(lines,idx+1,nx.indent);
				map[key] = v;
				if( anchorName ) yamlAnchors[anchorName] = v;
			}
			else {
				map[key] = null;
				idx++;
			}
		}
		else {
			//★ YAML 折行标量：标量值之后、缩进更深的行是它的「续行」。例如
			//    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,
			//      like Gecko) Chrome/70.0.3538.77 Safari/537.36
			//  必须合并进同一个值，否则这些行会变成「游离行」，
			//  在旧逻辑里会让整个序列提前中断（一次丢掉几百个节点）。
			var valFull = val;
			var nx = lines[idx+1];
			while( nx && nx.indent > indent ){
				var t = ..string.trim(nx.text);
				//防御：看起来像「键: 值」或数组项的行不当作续行，避免吞掉子树
				if( ..string.match(t,"^\-\s") ) break;
				if( yamlSplitKey(t) !== null ) break;
				valFull = valFull ++ " " ++ t;
				idx++;
				nx = lines[idx+1];
			}
			map[key] = yamlParseScalar(valFull);
			if( anchorName ) yamlAnchors[anchorName] = map[key];
			idx++;
		}
	}
	return map,idx;
};

//解析 YAML 文本中指定根键下的内容（用于 proxies: 段）
yamlParse = function(str,rootKey){
	//预处理：拆行 → 去注释 → 算缩进 → 丢弃空行
	//★ 必须用 string.split 而不是 string.lines 迭代器：实测同样 3800 行，
	//  string.split 约 0 毫秒，而 lines 迭代器要约 250 毫秒（相差上千倍），
	//  是整个解析耗时的主要来源。
	//  按 '\r\n' 拆分可同时兼容 CRLF / LF / CR 三种换行（空行会被下面的检查丢弃）。
	yamlAnchors = {};   //每次解析都重置锚点表

	var rawLines = ..string.split(str,'\r\n');
	var lines = [];
	for(i=1;#rawLines;1){
		var line = yamlStripComment(rawLines[i]);
		line = ..string.trimright(line);
		if( !#line ) continue;

		var ind = #( ..string.match(line,"^(\s*)") );
		var text = ..string.trim(line);
		if( !#text ) continue;

		var isSeq = ..string.startWith(text,"- ") || text === "-";
		var item = {
			indent = ind;
			text = text;
			isSeq = isSeq;
		};

		if( isSeq ){
			var rest = ( #text > 1 ) ? ..string.slice(text,2,-1) : "";
			var lead = ..string.match(rest,"^(\s*)");
			item.contentIndent = ind + 1 + ( lead ? #lead : 0 );
			item.content = ..string.trim(rest);
		}

		..table.push(lines,item);
	}
	if( !#lines ) return null;

	//找到根键（取缩进最小的那个）
	var rootIdx,rootIndent = null,null;
	for(i=1;#lines;1){
		var it = lines[i];
		if( it.isSeq ) continue;
		var key,val = yamlSplitKey(it.text);
		if( key !== rootKey ) continue;
		if( rootIdx === null || it.indent < rootIndent ){
			rootIdx = i;
			rootIndent = it.indent;
		}
	}
	if( rootIdx === null ) return null;

	var it = lines[rootIdx];
	var key,val = yamlSplitKey(it.text);

	//★ 根键的值也可能带锚点：`proxies: &id001` ← 后面跟着整个节点数组。
	//  （PyYAML 常见输出，不处理会把 "&id001" 当成值，整段解析不出来）
	if( type(val)=="string" && val[1] === 0x26 ){
		var aName,aRest = ..string.match(val,"^\&(\S+)\s*(.*)$");
		val = ( aRest && #aRest ) ? aRest : null;
	}

	if( val !== null ) return yamlParseScalar(val);   //proxies: [...] 行内写法

	//★ 预扫「文档其它顶层键里定义的锚点」（例如 base: &base 后跟一个共享配置块）。
	//  这类锚点会被 proxies 段里的 `<<: *base` / `*base` 引用；
	//  不预先登记就找不到定义，合并键会静默失效（实测节点会丢掉 type 等字段）。
	//  只解析「顶层且带锚点」的键，其余顶层键（如 rules）直接跳过，避免白白解析整个文档。
	for(i=1;#lines;1){
		var pit = lines[i];
		if( pit.isSeq || pit.indent !== 0 || i === rootIdx ) continue;
		var pk,pv = yamlSplitKey(pit.text);
		if( type(pv)!="string" || pv[1] !== 0x26 ) continue;

		var pAnchor = ..string.match(pv,"^\&(\S+)");
		if( !pAnchor ) continue;

		var pnx = lines[i+1];
		if( pnx && ( pnx.indent > pit.indent || ( pnx.indent === pit.indent && pnx.isSeq ) ) ){
			yamlAnchors[pAnchor] = yamlParseBlock(lines,i+1,pnx.indent);
		}
		elseif( #pv > #pAnchor + 1 ){
			//`key: &anchor 值` 这种「带锚点的标量」
			yamlAnchors[pAnchor] = yamlParseScalar( ..string.trim( ..string.slice(pv,#pAnchor+2,-1) ) );
		}
		else {
			yamlAnchors[pAnchor] = null;
		}
	}

	var nx = lines[rootIdx+1];
	if( !nx ) return null;
	if( !( nx.indent > it.indent || ( nx.indent === it.indent && nx.isSeq ) ) ) return null;

	return yamlParseBlock(lines,rootIdx+1,nx.indent);
};

//把 Clash 代理表展开为「下游能识别的扁平字段」：
//validOutbound 只认 ws-path / ws-headers 这类旧写法，
//REALITY 的内部字段名本来就是 public-key / short-id / spider-x。
//其余字段一律原样保留（宁导错，不错过）。
clashFlattenProxy = function(p){
	var o = {};
	for(k,v in p){ o[k] = v; }

	var ws = p["ws-opts"];
	if( type(ws)=="table" ){
		if( ws.path ) o["ws-path"] = ws.path;
		if( ws.headers ) o["ws-headers"] = ws.headers;
	}

	var ro = p["reality-opts"];
	if( type(ro)=="table" ){
		if( ro["public-key"] ) o["public-key"] = ro["public-key"];
		if( ro["short-id"] ) o["short-id"] = ro["short-id"];
		if( ro["spider-x"] ) o["spider-x"] = ro["spider-x"];
	}

	//wireguard：Clash 用 ip / ipv6 表示本机地址，内部统一叫 local-address
	if( type(p.type)=="string" && ..string.cmp(p.type,"wireguard")===0 ){
		if( p.ip && !o["local-address"] ) o["local-address"] = p.ip;
		elseif( p.ipv6 && !o["local-address"] ) o["local-address"] = p.ipv6;
	}

	return o;
};

//把「Clash 代理表数组」转成节点数组（含类型归一化 + validOutbound 归一化）。
//YAML 配置的 proxies: 段、以及 JSON 配置的 proxies 数组，都走这一个函数。
clashProxiesToOutbounds = function(list,subscribeUrl){
	if( type(list)!="table" || !#list ) return null;

	var outbounds = ..table.array();
	for(i=1;#list;1){
		var proxy = list[i];
		if( type(proxy)!="table" ) continue;

		//展开 ws-opts / reality-opts / wireguard 等嵌套字段
		var outbound = clashFlattenProxy(proxy);
		if( !outbound.server && !outbound.name && !outbound.type ) continue;

		//Clash 的 type 字段 → 内部 protocol 字段
		if(outbound.type){
			if(outbound.type=="ssr"){
				outbound.network = outbound.protocol;
				outbound.protocol = "ssr";
				outbound.networkParam = outbound.protocol_param;
				outbound.protocol_param = null;
				outbound.sni = outbound.ot_domain;
				outbound.path = outbound.ot_path;
				outbound.tls = outbound.ot_enable ? "tls" : null;
			}
			if(outbound.type=="ss"){
				outbound.type = "shadowsocks";
				outbound.network = "tcp";
			}
			outbound.protocol = outbound.type;
			outbound.type = null;
		}

		validOutbound(outbound);
		if( outbound.address ){
			outbound.subscribeUrl = subscribeUrl;
			..table.push(outbounds,outbound);
		}
	}

	return #outbounds ? outbounds : null;
};

//把 Clash 的 proxies: 段（YAML 文本）解析为节点数组。
//返回 null 表示「这段不是可用的 Clash 节点数据」，调用方应继续尝试其它解析方式。
//
// 为什么单独抽出来：importFromString 里 proxy-providers 与 proxies 两段可能同时存在，
// 需要把两段的结果合并（旧实现会提前 return 丢掉本地节点）。
clashNodesToOutbounds = function(str,subscribeUrl){
	return clashProxiesToOutbounds( yamlParse(str,"proxies"), subscribeUrl );
};

importFromClash = function(str,node){
	if(node){//如果包含节点
		//用「缩进感知」的 YAML 子集解析器解析 proxies: 段
		var list = yamlParse(str,"proxies");
		if( type(list)!="table" || !#list ) return null;

		var outLines = {};
		for(i=1;#list;1){
			var proxy = list[i];
			if( type(proxy)!="table" ) continue;

			var o = clashFlattenProxy(proxy);
			if( !o.server && !o.name && !o.type ) continue;

			//输出成「- {json}」行：importFromString 里已有对应的解析分支
			//（web.json 解析 + validOutbound 归一化），这里只做格式转换。
			..table.push(outLines,"- " ++ ..web.json.stringify(o));
		}

		if( !#outLines ) return null;
		return ..string.join(outLines,'\n');
	}


	else {//包含的是"proxy-providers"
		var urlmap = ..table.array();
		var start = false;var levelTable = ..table.array();
		for(line in ..string.lines(str) ){
			//删除注释字段和空白行
        	line = ..string.splitEx(line,'\#')[1];
// 【模式匹配】匹配空行，规则同 1989 行
        	if( line===null || ..string.match(line,"^\s*$") ){continue;}
        	//确定proxies范围
// 【模式匹配】匹配以字母开头的行，规则同 1991 行
        	if(..string.match(line,"^\a")){
				if(..string.startWith(line,"proxy-providers")){start = true;continue;}
				else {if(start){break;}continue;}
			}

			if(start){
// 【模式匹配】取缩进量。^(\s*)[^\s]=串首任意空白加第一个非空白字符
				var numNow = #(..string.match(line,"^(\s*)[^\s]"));//键缩进量
				var level;
    			for(index,num in levelTable){if(num=numNow){level=index;break;}}
    			if(!level && numNow){..table.push(levelTable,numNow);level=..table.count(levelTable);}
    			elseif(!level && !numNow){level=0}

    			if(level==2){
// 【模式匹配】提取「url: http...」中的网址。^\s*url\:\s*=开头空白、url、冒号、空白；(http.*)=以 http 开头直到行尾的内容
    				var url = ..string.match(line,"^\s*url\:\s*(http.*)");
					url = url ? ..string.trim(url,'"\'\s\t\r\n ');
					if(..inet.url.is(url)){..table.push(urlmap,url)}
    			}
			}
		}

		if(#urlmap){
			return urlmap; 
		}
	}	
}

/**intellisense(xray.outbounds) 
exportSharedLinks(.(outbounds) = 导出分享链接
importFromString(.(str,subscribeUrl,subps) = 导入节点数据（纯解析、永不联网）\n传入单行的订阅源网址时会发日志并直接返回
importFromClipboard() = 自剪贴板导入分享链接
isSubscribeUrl(.(str) = 判定整串数据是否为订阅源网址\n只有「单行 + http(s)://主机[:端口]/」才算网址；多行一律返回 false\n纯判定，不发起网络请求
toHttpProxyNode(.(line) = 把单行 http(s) 代理链接解析为节点对象\n非 http(s) 代理链接返回 null（带路径、无端口的裸主机等都会返回 null）
autoUpdateSubscription() = 自动并静默更新订阅源
updateSubscription() = 更新或自剪贴板导入订阅源\n可选在参数中用一个表自定义要更新的订阅地址,\n参数表中键为url，值为true
importFromClash(.(str,node) = 从clash文件导入节点或订阅
importFromSingbox(.(cfg) = 从sing-box配置导入节点\n参数可以是已解析的配置表，也可以是单个出站对象表
end intellisense**/
